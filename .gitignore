# Node dependencies and build outputs
**/node_modules/
**/dist/
**/build/
**/coverage/
**/.cache/
**/.turbo/
**/*.tsbuildinfo

# Local env files
**/.env
**/.env.*
!**/.env.example

# AWS CDK local context and synth outputs
infra/aws/cdk.context.json
infra/aws/cdk.context.local.json
infra/aws/cdk.out/

# Logs
**/*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Playwright artifacts
apps/web/playwright-report/
apps/web/test-results/

# Python cache files
__pycache__/
*.py[cod]
*$py.class
.mypy_cache/
.pytest_cache/
.pyre/
.pytype/
.ruff_cache/

# macOS
.DS_Store

# temporary files
tmp/
temp/
.codex-tmp-run/

# Claude Code local state (per-developer)
.claude/settings.local.json
.claude/worktrees/

# Private MaxMind databases
**/*.mmdb
**/GeoLite2-*.tar.gz

# Public marketing media is downloaded explicitly; keep its text metadata in Git.
/apps/ios/docs/media/**
!/apps/ios/docs/media/**/
!/apps/ios/docs/media/**/*.md
!/apps/ios/docs/media/**/*.json
!/apps/ios/docs/media/**/*.html
/apps/android/docs/media/**
!/apps/android/docs/media/**/
!/apps/android/docs/media/**/*.md
!/apps/android/docs/media/**/*.json
!/apps/android/docs/media/**/*.html
