    "start": "node dist/index.js"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.1166.0",
    "@aws-sdk/client-kms": "^3.1166.0",
    "@aws-sdk/client-lambda": "^3.1166.0",
    "@aws-sdk/client-secrets-manager": "^3.1166.0",
    "@hono/node-server": "^2.1.6",
    "@sentry/aws-serverless": "^11.12.0",
    "@sentry/server-runtime-injection": "11.12.0",
    "aws-jwt-verify": "^5.2.1",
    "hono": "^4.13.17",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "@sentry/bundler-plugins": {
      "glob": "14.0.3"
