        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre iPhone a changé de compte ou d’espace de travail. Réessayez quand la montre sera en ligne, ou supprimez ces évaluations pour changer maintenant."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "તમારા iPhone પર ખાતું અથવા કાર્યક્ષેત્ર બદલાયું છે. ઘડિયાળ ઑનલાઇન થાય ત્યારે ફરી પ્રયાસ કરો, અથવા હમણાં બદલવા માટે આ રેટિંગ કાઢી નાખો."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ב-iPhone הוחלפו החשבון או סביבת העבודה. יש לנסות שוב כשהשעון מחובר, או למחוק את הדירוגים האלה כדי לעבור עכשיו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपके iPhone पर खाता या वर्कस्पेस बदल गया है। घड़ी ऑनलाइन होने पर फिर से कोशिश करें, या अभी बदलने के लिए ये रेटिंग हटा दें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na iPhoneu su promijenjeni račun ili radni prostor. Pokušajte ponovno kad sat bude online ili izbrišite ove ocjene da biste odmah prešli."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az iPhone-od fiókot vagy munkaterületet váltott. Próbáld újra, amikor az óra online lesz, vagy töröld ezeket az értékeléseket, hogy most válts."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone Anda beralih akun atau ruang kerja. Coba lagi saat jam tangan online, atau hapus penilaian ini untuk beralih sekarang."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone skipti um aðgang eða vinnusvæði. Reyndu aftur þegar úrið er nettengt, eða eyddu þessum einkunnum til að skipta núna."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo iPhone ha cambiato account o spazio di lavoro. Riprova quando l’orologio è online, oppure elimina queste valutazioni per cambiare subito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhoneでアカウントまたはワークスペースが切り替わりました。Apple Watchがオンラインになったら再試行するか、これらの評価を削除して今すぐ切り替えてください。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ನಿಮ್ಮ iPhone ನಲ್ಲಿ ಖಾತೆ ಅಥವಾ ಕಾರ್ಯಸ್ಥಳ ಬದಲಾಗಿದೆ. ವಾಚ್ ಆನ್‌ಲೈನ್ ಆದಾಗ ಮತ್ತೆ ಪ್ರಯತ್ನಿಸಿ, ಅಥವಾ ಈಗಲೇ ಬದಲಾಯಿಸಲು ಈ ರೇಟಿಂಗ್‌ಗಳನ್ನು ಅಳಿಸಿ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone에서 계정 또는 작업 공간이 전환되었습니다. Apple Watch가 온라인 상태가 되면 다시 시도하거나, 지금 전환하려면 이 평가를 삭제하세요."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jūsų iPhone pakeitė paskyrą arba darbo sritį. Bandykite dar kartą, kai laikrodis bus prisijungęs, arba ištrinkite šiuos įvertinimus, kad perjungtumėte dabar."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jūsu iPhone mainīja kontu vai darbvietu. Mēģiniet vēlreiz, kad pulkstenis būs tiešsaistē, vai izdzēsiet šos vērtējumus, lai pārslēgtos tūlīt."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "നിങ്ങളുടെ iPhone-ൽ അക്കൗണ്ട് അല്ലെങ്കിൽ വർക്ക്‌സ്‌പേസ് മാറി. വാച്ച് ഓൺലൈനാകുമ്പോൾ വീണ്ടും ശ്രമിക്കുക, അല്ലെങ്കിൽ ഇപ്പോൾ മാറാൻ ഈ റേറ്റിംഗുകൾ ഇല്ലാതാക്കുക."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तुमच्या iPhone वर खाते किंवा कार्यक्षेत्र बदलले आहे. घड्याळ ऑनलाइन झाल्यावर पुन्हा प्रयत्न करा, किंवा आत्ताच बदलण्यासाठी ही रेटिंग हटवा."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone anda telah bertukar akaun atau ruang kerja. Cuba lagi apabila Apple Watch dalam talian, atau padam penilaian ini untuk bertukar sekarang."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhonen din har byttet konto eller arbeidsområde. Prøv på nytt når klokken er på nett, eller slett disse vurderingene for å bytte nå."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je iPhone is gewisseld van account of werkruimte. Probeer het opnieuw zodra de watch online is, of verwijder deze beoordelingen om nu te wisselen."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଆପଣଙ୍କ iPhoneରେ ଆକାଉଣ୍ଟ ବା କାର୍ଯ୍ୟକ୍ଷେତ୍ର ବଦଳିଛି। Apple Watch ଅନଲାଇନ୍ ହେଲେ ପୁଣି ଚେଷ୍ଟା କରନ୍ତୁ, କିମ୍ବା ଏବେ ବଦଳାଇବାକୁ ଏହି ମୂଲ୍ୟାୟନଗୁଡ଼ିକୁ ହଟାନ୍ତୁ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਤੁਹਾਡੇ iPhone 'ਤੇ ਖਾਤਾ ਜਾਂ ਵਰਕਸਪੇਸ ਬਦਲ ਗਿਆ ਹੈ। ਘੜੀ ਔਨਲਾਈਨ ਹੋਣ 'ਤੇ ਮੁੜ ਕੋਸ਼ਿਸ਼ ਕਰੋ, ਜਾਂ ਹੁਣੇ ਬਦਲਣ ਲਈ ਇਹ ਰੇਟਿੰਗਾਂ ਮਿਟਾਓ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na iPhonie zmieniono konto lub obszar roboczy. Ponów, gdy zegarek będzie online, albo usuń te oceny, aby przełączyć teraz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu iPhone trocou de conta ou espaço de trabalho. Tente novamente quando o relógio estiver online ou apague estas avaliações para trocar agora."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O iPhone mudou de conta ou de espaço de trabalho. Volte a tentar quando o Apple Watch estiver online ou elimine estas avaliações para mudar já."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone-ul a schimbat contul sau spațiul de lucru. Reîncearcă atunci când ceasul e online sau șterge aceste evaluări ca să schimbi acum."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На iPhone сменились аккаунт или рабочее пространство. Повторите, когда часы будут в сети, или удалите эти оценки, чтобы переключиться сейчас."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na iPhone sa zmenil účet alebo pracovný priestor. Skúste to znova, keď budú hodinky online, alebo tieto hodnotenia vymažte a prepnite hneď."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone je zamenjal račun ali delovni prostor. Poskusite znova, ko bo ura povezana, ali izbrišite te ocene, da preklopite zdaj."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din iPhone har bytt konto eller arbetsyta. Försök igen när klockan är online, eller radera bedömningarna för att byta nu."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone yako imebadilisha akaunti au nafasi ya kazi. Jaribu tena saa ikiwa mtandaoni, au futa tathmini hizi ili ubadilishe sasa."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "உங்கள் iPhone கணக்கை அல்லது பணியிடத்தை மாற்றியுள்ளது. கடிகாரம் ஆன்லைனில் வந்ததும் மீண்டும் முயலவும், அல்லது இப்போதே மாற இந்த மதிப்பீடுகளை நீக்கவும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "మీ iPhoneలో ఖాతా లేదా వర్క్‌స్పేస్ మారింది. వాచ్ ఆన్‌లైన్‌కి వచ్చాక మళ్లీ ప్రయత్నించండి, లేదా ఇప్పుడే మారడానికి ఈ రేటింగ్‌లను తొలగించండి."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone ของคุณเปลี่ยนบัญชีหรือพื้นที่ทำงานแล้ว ลองอีกครั้งเมื่อนาฬิกาออนไลน์ หรือลบการให้คะแนนเหล่านี้เพื่อเปลี่ยนตอนนี้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone’unuz hesap veya çalışma alanı değiştirdi. Saat çevrimiçi olduğunda yeniden deneyin ya da şimdi geçmek için bu değerlendirmeleri silin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На iPhone змінено обліковий запис або робочий простір. Повторіть, коли годинник буде в мережі, або видаліть ці оцінки, щоб перемкнутися зараз."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آپ کے iPhone پر اکاؤنٹ یا ورک اسپیس بدل گیا ہے۔ گھڑی آن لائن ہونے پر دوبارہ کوشش کریں، یا ابھی بدلنے کے لیے یہ ریٹنگز حذف کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone của bạn đã chuyển tài khoản hoặc không gian làm việc. Hãy thử lại khi đồng hồ trực tuyến, hoặc xóa các lượt đánh giá này để chuyển ngay."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的 iPhone 已切换账户或工作区。请在手表联网后重试，或删除这些评分以立即切换。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone 已切換帳號或工作區。請在 Apple Watch 連上網路後再試，或刪除這些評分以立即切換。"
          }
        },
        "zu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I-iPhone yakho ishintshe i-akhawunti noma indawo yokusebenza. Zama futhi uma iwashi selixhunyiwe ku-inthanethi, noma susa lezi zilinganiso ukuze ushintshe manje."
          }
        }
      }
    },
