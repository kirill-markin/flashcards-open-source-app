        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu iPhone cambió de cuenta o de espacio de trabajo. Reintenta cuando el reloj esté en línea, o elimina estas calificaciones para cambiar ahora."
          }
