        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu iPhone ha cambiado de cuenta o de espacio de trabajo. Reinténtalo cuando el reloj tenga conexión, o elimina estas valoraciones para cambiar ahora."
