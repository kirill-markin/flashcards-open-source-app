    "watch.session.switch_blocked.message" : {
      "comment" : "Apple Watch explanation under the unsynced ratings title: retry once online, or discard them to follow the iPhone's switch",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم تبديل الحساب أو مساحة العمل على iPhone. أعد المحاولة عندما تتصل الساعة بالإنترنت، أو احذف هذه التقييمات للتبديل الآن."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На iPhone са сменени акаунтът или работното пространство. Опитайте отново, когато часовникът е онлайн, или изтрийте тези оценки, за да превключите сега."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনার iPhone-এ অ্যাকাউন্ট বা কর্মক্ষেত্র বদলানো হয়েছে। ঘড়ি অনলাইন হলে আবার চেষ্টা করুন, অথবা এখনই বদলাতে এই রেটিংগুলো মুছে ফেলুন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’iPhone ha canviat de compte o d’espai de treball. Torna-ho a provar quan el rellotge estigui en línia, o elimina aquestes valoracions per canviar ara."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na iPhonu se změnil účet nebo pracovní prostor. Zkuste to znovu, až budou hodinky online, nebo tato hodnocení smažte a přepněte hned."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din iPhone har skiftet konto eller arbejdsområde. Prøv igen, når uret er online, eller slet disse vurderinger for at skifte nu."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein iPhone hat das Konto oder den Arbeitsbereich gewechselt. Versuche es erneut, sobald die Watch online ist, oder lösche diese Bewertungen, um jetzt zu wechseln."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το iPhone σας άλλαξε λογαριασμό ή χώρο εργασίας. Δοκιμάστε ξανά όταν το ρολόι είναι online ή διαγράψτε αυτές τις αξιολογήσεις για να αλλάξετε τώρα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your iPhone switched account or workspace. Try again once the watch is online, or discard these ratings to switch now."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your iPhone switched account or workspace. Try again once the watch is online, or discard these ratings to switch now."
