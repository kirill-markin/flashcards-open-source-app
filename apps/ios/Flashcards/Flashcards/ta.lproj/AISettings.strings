"settings.sync.customGuestWorkspacePaused.message" = "இந்தத் தனிப்பயன் சேவையகத்தால் இந்த விருந்தினர் பணியிடத்தை அணுக முடியாது. சேவையகம் இணக்கமற்றதாகவோ தவறாக அமைக்கப்பட்டதாகவோ இருக்கலாம். ஒத்திசைவு இடைநிறுத்தப்பட்டுள்ளது; உங்கள் உள்ளூர் அட்டைகளும் நிலுவை மாற்றங்களும் இந்தச் சாதனத்தில் பாதுகாப்பாக உள்ளன.";
