"settings.sync.recoveryGate.invalidStoredState.body" = "এই ডিভাইসে ক্লাউড পুনরুদ্ধার ডেটা অবৈধ। অ্যাপটিকে নিরাপদ রাখতে, স্বাভাবিক ব্যবহার অবরুদ্ধ করা হয়েছে। স্থানীয় ডেটা মুছে দিন এবং নতুন করে শুরু করুন, অথবা পুনরুদ্ধার এখনও সম্ভব হলে সাইন ইন করার চেষ্টা করুন।";
