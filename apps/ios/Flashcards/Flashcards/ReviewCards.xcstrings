    "This review filter does not include any cards yet.":{"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"This review filter does not include any cards yet."}},"ar":{"stringUnit":{"state":"translated","value":"لا يتضمن عامل تصفية المراجعة هذا أي بطاقات بعد."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"此复习筛选条件中还没有任何卡片。"}},"de":{"stringUnit":{"state":"translated","value":"Dieser Wiederholungsfilter enthält noch keine Karten."}},"fr":{"stringUnit":{"state":"translated","value":"Ce filtre de révision ne contient encore aucune carte."}},"hi":{"stringUnit":{"state":"translated","value":"इस समीक्षा फ़िल्टर में अभी कोई कार्ड शामिल नहीं है।"}},"ja":{"stringUnit":{"state":"translated","value":"この復習フィルタにはまだカードが含まれていません。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Este filtro de revisão ainda não inclui nenhum cartão."}},"ru":{"stringUnit":{"state":"translated","value":"Этот фильтр повторения пока не включает ни одной карточки."}},"es-MX":{"stringUnit":{"state":"translated","value":"Este filtro de repaso todavía no incluye ninguna tarjeta."}},"es-ES":{"stringUnit":{"state":"translated","value":"Este filtro de repaso todavía no incluye ninguna tarjeta."}}}},
    "Try a different search or clear filters.":{"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Try a different search or clear filters."}},"ar":{"stringUnit":{"state":"translated","value":"جرّب بحثًا مختلفًا أو امسح عوامل التصفية."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请尝试其他搜索或清除筛选条件。"}},"de":{"stringUnit":{"state":"translated","value":"Probiere eine andere Suche aus oder lösche die Filter."}},"fr":{"stringUnit":{"state":"translated","value":"Essayez une autre recherche ou effacez les filtres."}},"hi":{"stringUnit":{"state":"translated","value":"कोई दूसरा खोज शब्द आज़माएं या फ़िल्टर साफ़ करें।"}},"ja":{"stringUnit":{"state":"translated","value":"別の検索を試すか、フィルタをクリアしてください。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Tente outra busca ou limpe os filtros."}},"ru":{"stringUnit":{"state":"translated","value":"Попробуйте другой поиск или сбросьте фильтры."}},"es-MX":{"stringUnit":{"state":"translated","value":"Prueba otra búsqueda o borra los filtros."}},"es-ES":{"stringUnit":{"state":"translated","value":"Prueba otra búsqueda o borra los filtros."}}}},
    "Try clearing filters.":{"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Try clearing filters."}},"ar":{"stringUnit":{"state":"translated","value":"جرّب مسح عوامل التصفية."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"试试清除筛选条件。"}},"de":{"stringUnit":{"state":"translated","value":"Versuche, die Filter zu löschen."}},"fr":{"stringUnit":{"state":"translated","value":"Essayez d’effacer les filtres."}},"hi":{"stringUnit":{"state":"translated","value":"फ़िल्टर साफ़ करके देखें।"}},"ja":{"stringUnit":{"state":"translated","value":"フィルタをクリアしてみてください。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Tente limpar os filtros."}},"ru":{"stringUnit":{"state":"translated","value":"Попробуйте сбросить фильтры."}},"es-MX":{"stringUnit":{"state":"translated","value":"Prueba a borrar los filtros."}},"es-ES":{"stringUnit":{"state":"translated","value":"Prueba a borrar los filtros."}}}},
