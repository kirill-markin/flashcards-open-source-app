    "Cards":{"extractionState":"manual","localizations":{"sw":{"stringUnit":{"state":"translated","value":"Kadi"}},"ta":{"stringUnit":{"state":"translated","value":"அட்டைகள்"}},"te":{"stringUnit":{"state":"translated","value":"కార్డులు"}},"sk":{"stringUnit":{"state":"translated","value":"Karty"}},"sl":{"stringUnit":{"state":"translated","value":"Kartice"}},"sv":{"stringUnit":{"state":"translated","value":"Kort"}},"pa":{"stringUnit":{"state":"translated","value":"ਕਾਰਡ"}},"pl":{"stringUnit":{"state":"translated","value":"Fiszki"}},"ro":{"stringUnit":{"state":"translated","value":"Fișe"}},"mr":{"stringUnit":{"state":"translated","value":"कार्डे"}},"nb":{"stringUnit":{"state":"translated","value":"Kort"}},"nl":{"stringUnit":{"state":"translated","value":"Kaarten"}},"lt":{"stringUnit":{"state":"translated","value":"Kortelės"}},"lv":{"stringUnit":{"state":"translated","value":"Kartītes"}},"ml":{"stringUnit":{"state":"translated","value":"കാർഡുകൾ"}},"it":{"stringUnit":{"state":"translated","value":"Schede"}},"kn":{"stringUnit":{"state":"translated","value":"ಕಾರ್ಡ್‌ಗಳು"}},"ko":{"stringUnit":{"state":"translated","value":"카드"}},"hu":{"stringUnit":{"state":"translated","value":"Kártyák"}},"id":{"stringUnit":{"state":"translated","value":"Kartu"}},"is":{"stringUnit":{"state":"translated","value":"Spjöld"}},"gu":{"stringUnit":{"state":"translated","value":"કાર્ડ"}},"he":{"stringUnit":{"state":"translated","value":"כרטיסיות"}},"hr":{"stringUnit":{"state":"translated","value":"Kartice"}},"et":{"stringUnit":{"state":"translated","value":"Kaardid"}},"fa":{"stringUnit":{"state":"translated","value":"کارت‌ها"}},"fi":{"stringUnit":{"state":"translated","value":"Kortit"}},"cs":{"stringUnit":{"state":"translated","value":"Kartičky"}},"da":{"stringUnit":{"state":"translated","value":"Kort"}},"el":{"stringUnit":{"state":"translated","value":"Κάρτες"}},"bg":{"stringUnit":{"state":"translated","value":"Карти"}},"bn":{"stringUnit":{"state":"translated","value":"কার্ড"}},"ca":{"stringUnit":{"state":"translated","value":"Targetes"}},"en":{"stringUnit":{"state":"translated","value":"Cards"}},"ar":{"stringUnit":{"state":"translated","value":"البطاقات"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"卡片"}},"de":{"stringUnit":{"state":"translated","value":"Karten"}},"fr":{"stringUnit":{"state":"translated","value":"Cartes"}},"hi":{"stringUnit":{"state":"translated","value":"कार्ड"}},"ja":{"stringUnit":{"state":"translated","value":"カード"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Cartões"}},"ru":{"stringUnit":{"state":"translated","value":"Карточки"}},"es-MX":{"stringUnit":{"state":"translated","value":"Tarjetas"}},"es-ES":{"stringUnit":{"state":"translated","value":"Tarjetas"}}}},
    "Cards are the prompts and answers you review to learn and remember.":{"extractionState":"manual","localizations":{"sw":{"stringUnit":{"state":"translated","value":"Kadi ni maswali na majibu unayorudia ili kujifunza na kukumbuka."}},"ta":{"stringUnit":{"state":"translated","value":"கற்கவும் நினைவில் வைக்கவும் நீங்கள் மீள்பயிற்சி செய்யும் கேள்விகளும் பதில்களுமே அட்டைகள்."}},"te":{"stringUnit":{"state":"translated","value":"కార్డులు అంటే నేర్చుకోవడానికి, గుర్తుంచుకోవడానికి మీరు పునశ్చరణ చేసే ప్రశ్నలు, సమాధానాలు."}},"sk":{"stringUnit":{"state":"translated","value":"Karty sú otázky a odpovede, ktoré si opakujete, aby ste sa učili a pamätali si ich."}},"sl":{"stringUnit":{"state":"translated","value":"Kartice so vprašanja in odgovori, ki jih ponavljate, da se jih naučite in si jih zapomnite."}},"sv":{"stringUnit":{"state":"translated","value":"Kort är frågor och svar som du repeterar för att lära dig och minnas."}},"pa":{"stringUnit":{"state":"translated","value":"ਕਾਰਡਾਂ ਵਿੱਚ ਸਵਾਲ ਅਤੇ ਜਵਾਬ ਹੁੰਦੇ ਹਨ ਜਿਨ੍ਹਾਂ ਦੀ ਤੁਸੀਂ ਸਿੱਖਣ ਅਤੇ ਯਾਦ ਰੱਖਣ ਲਈ ਦੁਹਰਾਈ ਕਰਦੇ ਹੋ।"}},"pl":{"stringUnit":{"state":"translated","value":"Fiszki to pytania i odpowiedzi, które powtarzasz, aby się uczyć i zapamiętywać."}},"ro":{"stringUnit":{"state":"translated","value":"Fișele sunt întrebări și răspunsuri pe care le recapitulezi pentru a învăța și a reține."}},"mr":{"stringUnit":{"state":"translated","value":"कार्डांमध्ये प्रश्न आणि उत्तरे असतात. त्यांची उजळणी करून तुम्ही शिकता आणि लक्षात ठेवता."}},"nb":{"stringUnit":{"state":"translated","value":"Kort er spørsmålene og svarene du repeterer for å lære og huske."}},"nl":{"stringUnit":{"state":"translated","value":"Kaarten zijn de vragen en antwoorden die je herhaalt om te leren en te onthouden."}},"lt":{"stringUnit":{"state":"translated","value":"Kortelės – tai klausimai ir atsakymai, kuriuos kartojate, kad išmoktumėte ir įsimintumėte."}},"lv":{"stringUnit":{"state":"translated","value":"Kartītes ir jautājumi un atbildes, ko atkārtojat, lai mācītos un atcerētos."}},"ml":{"stringUnit":{"state":"translated","value":"പഠിക്കാനും ഓർമ്മിക്കാനുമായി ആവർത്തിക്കുന്ന ചോദ്യങ്ങളും ഉത്തരങ്ങളുമാണ് കാർഡുകൾ."}},"it":{"stringUnit":{"state":"translated","value":"Le schede sono le domande e le risposte che ripassi per imparare e ricordare."}},"kn":{"stringUnit":{"state":"translated","value":"ಕಾರ್ಡ್‌ಗಳು ನೀವು ಕಲಿಯಲು ಮತ್ತು ನೆನಪಿಡಲು ಪುನರಾವರ್ತಿಸುವ ಪ್ರಶ್ನೆಗಳು ಹಾಗೂ ಉತ್ತರಗಳು."}},"ko":{"stringUnit":{"state":"translated","value":"카드는 배우고 기억하기 위해 복습하는 질문과 답변입니다."}},"hu":{"stringUnit":{"state":"translated","value":"A kártyák kérdések és válaszok, amelyeket a tanulás és memorizálás érdekében ismételsz."}},"id":{"stringUnit":{"state":"translated","value":"Kartu berisi pertanyaan dan jawaban yang Anda ulangi untuk belajar dan mengingat."}},"is":{"stringUnit":{"state":"translated","value":"Spjöld eru spurningar og svör sem þú rifjar upp til að læra og muna."}},"gu":{"stringUnit":{"state":"translated","value":"કાર્ડમાં એવા પ્રશ્નો અને જવાબો હોય છે જેનું પુનરાવર્તન કરીને તમે શીખો અને યાદ રાખો છો."}},"he":{"stringUnit":{"state":"translated","value":"כרטיסיות הן שאלות ותשובות שחוזרים עליהן כדי ללמוד ולזכור."}},"hr":{"stringUnit":{"state":"translated","value":"Kartice sadrže pitanja i odgovore koje ponavljate kako biste učili i pamtili."}},"et":{"stringUnit":{"state":"translated","value":"Kaardid on küsimused ja vastused, mida kordad õppimiseks ja meeldejätmiseks."}},"fa":{"stringUnit":{"state":"translated","value":"کارت‌ها پرسش‌ها و پاسخ‌هایی هستند که برای یادگیری و به‌خاطرسپاری مرور می‌کنید."}},"fi":{"stringUnit":{"state":"translated","value":"Kortit ovat kysymyksiä ja vastauksia, joita kertaat oppiaksesi ja muistaaksesi."}},"cs":{"stringUnit":{"state":"translated","value":"Kartičky obsahují otázky a odpovědi, které si opakujete, abyste se je naučili a zapamatovali."}},"da":{"stringUnit":{"state":"translated","value":"Kort indeholder spørgsmål og svar, som du repeterer for at lære og huske."}},"el":{"stringUnit":{"state":"translated","value":"Οι κάρτες περιέχουν ερωτήσεις και απαντήσεις που επαναλαμβάνετε για να μάθετε και να θυμάστε."}},"bg":{"stringUnit":{"state":"translated","value":"Картите съдържат въпроси и отговори, които преговаряте, за да учите и запомняте."}},"bn":{"stringUnit":{"state":"translated","value":"কার্ডে প্রশ্ন ও উত্তর থাকে, যা শেখার ও মনে রাখার জন্য আপনি পুনরালোচনা করেন।"}},"ca":{"stringUnit":{"state":"translated","value":"Les targetes contenen preguntes i respostes que repasses per aprendre i recordar."}},"en":{"stringUnit":{"state":"translated","value":"Cards are the prompts and answers you review to learn and remember."}},"ar":{"stringUnit":{"state":"translated","value":"البطاقات هي الأسئلة والأجوبة التي تراجعها للتعلم والتذكر."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"卡片是你为了学习和记忆而复习的提示与答案。"}},"de":{"stringUnit":{"state":"translated","value":"Karten sind die Fragen und Antworten, die du wiederholst, um zu lernen und dich zu erinnern."}},"fr":{"stringUnit":{"state":"translated","value":"Les cartes sont les questions et les réponses que vous révisez pour apprendre et mémoriser."}},"hi":{"stringUnit":{"state":"translated","value":"कार्ड वे संकेत और उत्तर हैं जिन्हें आप सीखने और याद रखने के लिए दोहराते हैं।"}},"ja":{"stringUnit":{"state":"translated","value":"カードは、学習して記憶に定着させるために復習する問題と答えです。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Os cartões são as perguntas e respostas que você revisa para aprender e lembrar."}},"ru":{"stringUnit":{"state":"translated","value":"Карточки — это вопросы и ответы, которые вы повторяете, чтобы учиться и запоминать."}},"es-MX":{"stringUnit":{"state":"translated","value":"Las tarjetas son las preguntas y respuestas que repasas para aprender y recordar."}},"es-ES":{"stringUnit":{"state":"translated","value":"Las tarjetas son las preguntas y respuestas que repasas para aprender y recordar."}}}},
    "Cards couldn't load. Try again.":{"extractionState":"manual","localizations":{"sw":{"stringUnit":{"state":"translated","value":"Kadi hazikuweza kupakiwa. Jaribu tena."}},"ta":{"stringUnit":{"state":"translated","value":"அட்டைகளை ஏற்ற முடியவில்லை. மீண்டும் முயலவும்."}},"te":{"stringUnit":{"state":"translated","value":"కార్డులను లోడ్ చేయలేకపోయాము. మళ్లీ ప్రయత్నించండి."}},"sk":{"stringUnit":{"state":"translated","value":"Karty sa nepodarilo načítať. Skúste to znova."}},"sl":{"stringUnit":{"state":"translated","value":"Kartic ni bilo mogoče naložiti. Poskusite znova."}},"sv":{"stringUnit":{"state":"translated","value":"Korten kunde inte läsas in. Försök igen."}},"pa":{"stringUnit":{"state":"translated","value":"ਕਾਰਡ ਲੋਡ ਨਹੀਂ ਹੋ ਸਕੇ। ਮੁੜ ਕੋਸ਼ਿਸ਼ ਕਰੋ।"}},"pl":{"stringUnit":{"state":"translated","value":"Nie udało się wczytać fiszek. Spróbuj ponownie."}},"ro":{"stringUnit":{"state":"translated","value":"Fișele nu au putut fi încărcate. Încearcă din nou."}},"mr":{"stringUnit":{"state":"translated","value":"कार्डे लोड करता आली नाहीत. पुन्हा प्रयत्न करा."}},"nb":{"stringUnit":{"state":"translated","value":"Kunne ikke laste kort. Prøv igjen."}},"nl":{"stringUnit":{"state":"translated","value":"Kaarten konden niet worden geladen. Probeer het opnieuw."}},"lt":{"stringUnit":{"state":"translated","value":"Nepavyko įkelti kortelių. Bandykite dar kartą."}},"lv":{"stringUnit":{"state":"translated","value":"Neizdevās ielādēt kartītes. Mēģiniet vēlreiz."}},"ml":{"stringUnit":{"state":"translated","value":"കാർഡുകൾ ലോഡ് ചെയ്യാനായില്ല. വീണ്ടും ശ്രമിക്കുക."}},"it":{"stringUnit":{"state":"translated","value":"Impossibile caricare le schede. Riprova."}},"kn":{"stringUnit":{"state":"translated","value":"ಕಾರ್ಡ್‌ಗಳನ್ನು ಲೋಡ್ ಮಾಡಲಾಗಲಿಲ್ಲ. ಮತ್ತೆ ಪ್ರಯತ್ನಿಸಿ."}},"ko":{"stringUnit":{"state":"translated","value":"카드를 불러오지 못했습니다. 다시 시도하세요."}},"hu":{"stringUnit":{"state":"translated","value":"Nem sikerült betölteni a kártyákat. Próbáld újra."}},"id":{"stringUnit":{"state":"translated","value":"Kartu tidak dapat dimuat. Coba lagi."}},"is":{"stringUnit":{"state":"translated","value":"Ekki tókst að hlaða spjöld. Reyndu aftur."}},"gu":{"stringUnit":{"state":"translated","value":"કાર્ડ લોડ થઈ શક્યાં નહીં. ફરી પ્રયાસ કરો."}},"he":{"stringUnit":{"state":"translated","value":"לא ניתן לטעון את הכרטיסיות. יש לנסות שוב."}},"hr":{"stringUnit":{"state":"translated","value":"Nije moguće učitati kartice. Pokušajte ponovno."}},"et":{"stringUnit":{"state":"translated","value":"Kaarte ei saanud laadida. Proovi uuesti."}},"fa":{"stringUnit":{"state":"translated","value":"بارگیری کارت‌ها ممکن نشد. دوباره امتحان کنید."}},"fi":{"stringUnit":{"state":"translated","value":"Kortteja ei voitu ladata. Yritä uudelleen."}},"cs":{"stringUnit":{"state":"translated","value":"Kartičky se nepodařilo načíst. Zkuste to znovu."}},"da":{"stringUnit":{"state":"translated","value":"Kortene kunne ikke indlæses. Prøv igen."}},"el":{"stringUnit":{"state":"translated","value":"Δεν ήταν δυνατή η φόρτωση των καρτών. Δοκιμάστε ξανά."}},"bg":{"stringUnit":{"state":"translated","value":"Картите не можаха да се заредят. Опитайте отново."}},"bn":{"stringUnit":{"state":"translated","value":"কার্ড লোড করা যায়নি। আবার চেষ্টা করুন"}},"ca":{"stringUnit":{"state":"translated","value":"No s'han pogut carregar les targetes. Torna-ho a provar."}},"en":{"stringUnit":{"state":"translated","value":"Cards couldn't load. Try again."}},"ar":{"stringUnit":{"state":"translated","value":"تعذر تحميل البطاقات. حاول مرة أخرى."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"无法加载卡片。请重试。"}},"de":{"stringUnit":{"state":"translated","value":"Karten konnten nicht geladen werden. Versuche es erneut."}},"fr":{"stringUnit":{"state":"translated","value":"Impossible de charger les cartes. Réessayez."}},"hi":{"stringUnit":{"state":"translated","value":"कार्ड लोड नहीं हो सके। फिर से कोशिश करें।"}},"ja":{"stringUnit":{"state":"translated","value":"カードを読み込めませんでした。もう一度お試しください。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Não foi possível carregar os cartões. Tente novamente."}},"ru":{"stringUnit":{"state":"translated","value":"Не удалось загрузить карточки. Попробуйте снова."}},"es-MX":{"stringUnit":{"state":"translated","value":"No se pudieron cargar las tarjetas. Inténtalo de nuevo."}},"es-ES":{"stringUnit":{"state":"translated","value":"No se pudieron cargar las tarjetas. Inténtalo de nuevo."}}}},
