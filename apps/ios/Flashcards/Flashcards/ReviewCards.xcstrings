    "This review filter does not include any cards yet.":{"extractionState":"manual","localizations":{"sw":{"stringUnit":{"state":"translated","value":"Kichujio hiki cha marudio hakijumuishi kadi zozote bado."}},"ta":{"stringUnit":{"state":"translated","value":"இந்த மீள்பயிற்சி வடிகட்டியில் இன்னும் அட்டைகள் இல்லை."}},"te":{"stringUnit":{"state":"translated","value":"ఈ పునశ్చరణ ఫిల్టర్‌లో ఇంకా కార్డులు లేవు."}},"sk":{"stringUnit":{"state":"translated","value":"Tento filter opakovania zatiaľ nezahŕňa žiadne karty."}},"sl":{"stringUnit":{"state":"translated","value":"Ta filter ponavljanja še ne vključuje nobene kartice."}},"sv":{"stringUnit":{"state":"translated","value":"Det här repetitionsfiltret innehåller inga kort än."}},"pa":{"stringUnit":{"state":"translated","value":"ਇਸ ਦੁਹਰਾਈ ਫਿਲਟਰ ਵਿੱਚ ਹਾਲੇ ਕੋਈ ਕਾਰਡ ਨਹੀਂ ਹੈ।"}},"pl":{"stringUnit":{"state":"translated","value":"Ten filtr powtórek nie obejmuje jeszcze żadnych fiszek."}},"ro":{"stringUnit":{"state":"translated","value":"Acest filtru de recapitulare nu include încă nicio fișă."}},"mr":{"stringUnit":{"state":"translated","value":"या उजळणी फिल्टरमध्ये अद्याप कोणतीही कार्डे नाहीत."}},"nb":{"stringUnit":{"state":"translated","value":"Dette repetisjonsfilteret inkluderer ingen kort ennå."}},"nl":{"stringUnit":{"state":"translated","value":"Dit herhaalfilter bevat nog geen kaarten."}},"lt":{"stringUnit":{"state":"translated","value":"Šis kartojimo filtras dar neapima jokių kortelių."}},"lv":{"stringUnit":{"state":"translated","value":"Šajā atkārtošanas filtrā vēl nav nevienas kartītes."}},"ml":{"stringUnit":{"state":"translated","value":"ഈ ആവർത്തന ഫിൽട്ടറിൽ ഇതുവരെ കാർഡുകളൊന്നുമില്ല."}},"it":{"stringUnit":{"state":"translated","value":"Questo filtro di ripasso non include ancora schede."}},"kn":{"stringUnit":{"state":"translated","value":"ಈ ಪುನರಾವರ್ತನೆ ಫಿಲ್ಟರ್‌ನಲ್ಲಿ ಇನ್ನೂ ಕಾರ್ಡ್‌ಗಳಿಲ್ಲ."}},"ko":{"stringUnit":{"state":"translated","value":"이 복습 필터에 해당하는 카드가 아직 없습니다."}},"hu":{"stringUnit":{"state":"translated","value":"Ez