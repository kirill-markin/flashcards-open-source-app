"stringUnit":{"state":"translated","value":"Poistetaanko tämä kortti?"}},"cs":{"stringUnit":{"state":"translated","value":"Smazat tuto kartičku?"}},"da":{"stringUnit":{"state":"translated","value":"Slet dette kort?"}},"el":{"stringUnit":{"state":"translated","value":"Να διαγραφεί αυτή η κάρτα;"}},"bg":{"stringUnit":{"state":"translated","value":"Изтриване на тази карта?"}},"bn":{"stringUnit":{"state":"translated","value":"এই কার্ডটি মুছবেন?"}},"ca":{"stringUnit":{"state":"translated","value":"Vols suprimir aquesta targeta?"}},"en":{"stringUnit":{"state":"translated","value":"Delete this card?"}},"ar":{"stringUnit":{"state":"translated","value":"هل تريد حذف هذه البطاقة؟"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"删除这张卡片？"}},"de":{"stringUnit":{"state":"translated","value":"Diese Karte löschen?"}},"fr":{"stringUnit":{"state":"translated","value":"Supprimer cette carte ?"}},"hi":{"stringUnit":{"state":"translated","value":"क्या इस कार्ड को हटाना है?"}},"ja":{"stringUnit":{"state":"translated","value":"このカードを削除しますか？"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Excluir este cartão?"}},"ru":{"stringUnit":{"state":"translated","value":"Удалить эту карточку?"}},"es-MX":{"stringUnit":{"state":"translated","value":"¿Eliminar esta tarjeta?"}},"es-ES":{"stringUnit":{"state":"translated","value":"¿Eliminar esta tarjeta?"}}}},
    "Deleting removes this card from the local list and from the next sync.":{"extractionState":"manual","localizations":{"sw":{"stringUnit":{"state":"translated","value":"Kufuta huondoa kadi hii kwenye orodha ya kifaa na kwenye usawazishaji unaofuata."}},"ta":{"stringUnit":{"state":"translated","value":"நீக்குவது இந்த அட்டையைச் சாதனத்தின் பட்டியலிலிருந்தும் அடுத்த ஒத்திசைவிலிருந்தும் அகற்றும்."}},"te":{"stringUnit":{"state":"translated","value":"తొలగించడం వల్ల ఈ కార్డు స్థానిక జాబితా నుంచి, తదుపరి సింక్ నుంచి తీసివేయబడుతుంది."}},"sk":{"stringUnit":{"state":"translated","value":"Vymazaním sa táto karta odstráni z miestneho zoznamu a pri ďalšej synchronizácii."}},"sl":{"stringUnit":{"state":"translated","value":"Z izbrisom se ta kartica odstrani z lokalnega seznama in ob naslednji sinhronizaciji."}},"sv":{"stringUnit":{"state":"translated","value":"Kortet tas bort från den lokala listan och vid nästa synkronisering."}},"pa":{"stringUnit":{"state":"translated","value":"ਮਿਟਾਉਣ ਨਾਲ ਇਹ ਕਾਰਡ ਸਥਾਨਕ ਸੂਚੀ ਤੋਂ ਅਤੇ ਅਗਲੇ ਸਿੰਕ ਵੇਲੇ ਹਟ ਜਾਂਦਾ ਹੈ।"}},"pl":{"stringUnit":{"state":"translated","value":"Usunięcie usuwa fiszkę z lokalnej listy i przy następnej synchronizacji."}},"ro":{"stringUnit":{"state":"translated","value":"Ștergerea elimină fișa din lista locală și la următoarea sincronizare."}},"mr":{"stringUnit":{"state":"translated","value":"हटवल्यावर हे कार्ड स्थानिक यादीतून काढले जाते आणि पुढील समक्रमणातही हटवले जाते."}},"nb":{"stringUnit":{"state":"translated","value":"Sletting fjerner kortet fra den lokale listen og ved neste synkronisering."}},"nl":{"stringUnit":{"state":"translated","value":"Verwijderen haalt deze kaart uit de lokale lijst en verwijdert deze ook bij de volgende synchronisatie."}},"lt":{"stringUnit":{"state":"translated","value":"Ištrynus kortelė pašalinama iš vietinio sąrašo ir per kitą sinchronizavimą."}},"lv":{"stringUnit":{"state":"translated","value":"Dzēšot, kartīte tiek noņemta no vietējā saraksta un nākamās sinhronizācijas laikā."}},"ml":{"stringUnit":{"state":"translated","value":"ഇല്ലാതാക്കുമ്പോൾ ഈ കാർഡ് പ്രാദേശിക പട്ടികയിൽ നിന്നും അടുത്ത സമന്വയത്തിലും നീക്കം ചെയ്യും."}},"it":{"stringUnit":{"state":"translated","value":"La scheda verrà rimossa dall’elenco locale e dal cloud alla prossima sincronizzazione."}},"kn":{"stringUnit":{"state":"translated","value":"ಅಳಿಸಿದಾಗ ಈ ಕಾರ್ಡ್ ಸ್ಥಳೀಯ ಪಟ್ಟಿಯಿಂದ ತೆಗೆದುಹಾಕಲಾಗುತ್ತದೆ ಮತ್ತು ಮುಂದಿನ ಸಿಂಕ್‌ನಲ್ಲಿ ಅಳಿಸುವಿಕೆ ಅನ್ವಯಿಸುತ್ತದೆ."}},"ko":{"stringUnit":{"state":"translated","value":"삭제하면 카드가 로컬 목록에서 제거되고 다음 동기화에 반영됩니다."}},"hu":{"stringUnit":{"state":"translated","value":"A törlés eltávolítja a kártyát a helyi listából és a következő szinkronizálásból."}},"id":{"stringUnit":{"state":"translated","value":"Penghapusan menghapus kartu ini dari daftar lokal dan sinkronisasi berikutnya."}},"is":{"stringUnit":{"state":"translated","value":"Eyðing fjarlægir spjaldið af staðbundna listanum og úr næstu samstillingu."}},"gu":{"stringUnit":{"state":"translated","value":"કાઢી નાખવાથી આ કાર્ડ સ્થાનિક યાદીમાંથી અને આગલા સિંકમાંથી દૂર થશે."}},"he":{"stringUnit":{"state":"translated","value":"המחיקה מסירה את הכרטיסייה מהרשימה המקומית ומהסנכרון הבא."}},"hr":{"stringUnit":{"state":"translated","value":"Brisanje uklanja ovu karticu s lokalnog popisa i iz sljedeće sinkronizacije."}},"et":{"stringUnit":{"state":"translated","value":"Kustutamine eemaldab selle kaardi kohalikust loendist ja järgmisest sünkroonimisest."}},"fa":{"stringUnit":{"state":"translated","value":"با حذف، این کارت از فهرست محلی و همگام‌سازی بعدی برداشته می‌شود."}},"fi":{"stringUnit":{"state":"translated","value":"Poistaminen poistaa kortin paikallisesta luettelosta ja seuraavasta synkronoinnista."}},"cs":{"stringUnit":{"state":"translated","value":"Smazáním se kartička odstraní z místního seznamu a při příští synchronizaci."}},"da":{"stringUnit":{"state":"translated","value":"Sletning fjerner kortet fra den lokale liste og ved næste synkronisering."}},"el":{"stringUnit":{"state":"translated","value":"Η διαγραφή αφαιρεί την κάρτα από την τοπική λίστα και κατά τον επόμενο συγχρονισμό."}},"bg":{"stringUnit":{"state":"translated","value":"Изтриването премахва тази карта от локалния списък и от следващото синхронизиране."}},"bn":{"stringUnit":{"state":"translated","value":"মুছে ফেলার ফলে এই কার্ডটি স্থানীয় তালিকা থেকে এবং পরবর্তী সিঙ্ক থেকে মুছে যায়।"}},"ca":{"stringUnit":{"state":"translated","value":"Si suprimeixes, s'elimina aquesta targeta de la llista local i de la següent sincronització."}},"en":{"stringUnit":{"state":"translated","value":"Deleting removes this card from the local list and from the next sync."}},"ar":{"stringUnit":{"state":"translated","value":"سيؤدي الحذف إلى إزالة هذه البطاقة من القائمة المحلية ومن المزامنة التالية."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"删除后，这张卡片会从本地列表中移除，并在下次同步时删除。"}},"de":{"stringUnit":{"state":"translated","value":"Durch das Löschen wird diese Karte aus der lokalen Liste und aus der nächsten Synchronisierung entfernt."}},"fr":{"stringUnit":{"state":"translated","value":"La suppression retire cette carte de la liste locale et de la prochaine synchronisation."}},"hi":{"stringUnit":{"state":"translated","value":"हटाने पर यह कार्ड स्थानीय सूची और अगली सिंक, दोनों से हट जाएगा।"}},"ja":{"stringUnit":{"state":"translated","value":"削除すると、このカードはローカル一覧から削除され、次回の同期対象からも外れます。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Ao excluir, este cartão sai da lista local e da próxima sincronização."}},"ru":{"stringUnit":{"state":"translated","value":"При удалении карточка будет убрана из локального списка и из следующей синхронизации."}},"es-MX":{"stringUnit":{"state":"translated","value":"Al eliminarla, esta tarjeta se quita de la lista local y de la próxima sincronización."}},"es-ES":{"stringUnit":{"state":"translated","value":"Al eliminarla, esta tarjeta se quita de la lista local y de la próxima sincronización."}}}},
    "demo_card_back_1":{"comment":"Paragraph on the back of the onboarding demo flashcard. %@ is the never-localized product name, already wrapped in Markdown bold.","extractionState":"manual","localizations":{"sw":{"stringUnit":{"state":"translated","value":"%@ — programu unayotazama sasa hivi. Kila kitu hapa ni kadi ya kujifunzia: swali mbele, jibu nyuma."}},"ta":{"stringUnit":{"state":"translated","value":"%@ — நீங்கள் இப்போது பார்க்கும் செயலி. இங்கே அனைத்தும் கற்றல் அட்டைகளே: முன்புறம் கேள்வி, பின்புறம் பதில்."}},"te":{"stringUnit":{"state":"translated","value":"%@ — మీరు ప్రస్తుతం చూస్తున్న యాప్. ఇక్కడ ప్రతిదీ ఒక అభ్యాస కార్డే: ముందు వైపు ప్రశ్న, వెనుక వైపు సమాధానం."}},"sk":{"stringUnit":{"state":"translated","value":"%@ — aplikácia, na ktorú sa práve pozeráte. Všetko je tu kartou: otázka na prednej strane, odpoveď na zadnej."}},"sl":{"stringUnit":{"state":"translated","value":"%@ — aplikacija, ki jo pravkar gledate. Vse tukaj je učna kartica: vprašanje na sprednji strani in odgovor na zadnji."}},"sv":{"stringUnit":{"state":"translated","value":"%@ — appen du tittar på just nu. Allt här är ett minneskort: en fråga på framsidan och svaret på baksidan."}},"pa":{"stringUnit":{"state":"translated","value":"%@ — ਉਹ ਐਪ ਜੋ ਤੁਸੀਂ ਇਸ ਵੇਲੇ ਵੇਖ ਰਹੇ ਹੋ। ਇੱਥੇ ਹਰ ਚੀਜ਼ ਇੱਕ ਫਲੈਸ਼ਕਾਰਡ ਹੈ: ਅੱਗੇ ਸਵਾਲ, ਪਿੱਛੇ ਜਵਾਬ।"}},"pl":{"stringUnit":{"state":"translated","value":"%@ — aplikacja, na którą właśnie patrzysz. Wszystko tutaj jest fiszką: pytanie z przodu, odpowiedź z tyłu."}},"ro":{"stringUnit":{"state":"translated","value":"%@ — aplicația la care te uiți chiar acum. Totul aici este o fișă: o întrebare pe față și răspunsul pe verso."}},"mr":{"stringUnit":{"state":"translated","value":"%@ — तुम्ही सध्या पाहत असलेले अ‍ॅप. येथे सर्व काही फ्लॅशकार्ड आहे: समोर प्रश्न आणि मागे उत्तर."}},"nb":{"stringUnit":{"state":"translated","value":"%@ — appen du ser på akkurat nå. Alt her er et læringskort: et spørsmål på forsiden og svaret på baksiden."}},"nl":{"stringUnit":{"state":"translated","value":"%@ — de app die je nu bekijkt. Alles hier is een leerkaart: een vraag op de voorkant, het antwoord op de achterkant."}},"lt":{"stringUnit":{"state":"translated","value":"%@ – programėlė, į kurią dabar žiūrite. Čia viskas yra mokymosi kortelė: klausimas priekyje, atsakymas kitoje pusėje."}},"lv":{"stringUnit":{"state":"translated","value":"%@ — lietotne, kuru pašlaik skatāt. Šeit viss ir mācību kartīte: jautājums priekšpusē, atbilde aizmugurē."}},"ml":{"stringUnit":{"state":"translated","value":"%@ — നിങ്ങൾ ഇപ്പോൾ കാണുന്ന ആപ്പ്. ഇവിടെയുള്ളതെല്ലാം ഫ്ലാഷ്കാർഡാണ്: മുൻവശത്ത് ചോദ്യം, പിൻവശത്ത് ഉത്തരം."}},"it":{"stringUnit":{"state":"translated","value":"%@ — l’app che stai guardando proprio ora. Qui tutto è una scheda: una domanda sul fronte, la risposta sul retro."}},"kn":{"stringUnit":{"state":"translated","value":"%@ — ನೀವು ಈಗ ನೋಡುತ್ತಿರುವ ಆ್ಯಪ್. ಇಲ್ಲಿ ಎಲ್ಲವೂ ಫ್ಲ್ಯಾಶ್‌ಕಾರ್ಡ್: ಮುಂಭಾಗದಲ್ಲಿ ಪ್ರಶ್ನೆ, ಹಿಂಭಾಗದಲ್ಲಿ ಉತ್ತರ."}},"ko":{"stringUnit":{"state":"translated","value":"%@ — 지금 보고 있는 앱입니다. 여기서는 모든 것이 플래시카드입니다. 앞면에는 질문, 뒷면에는 답이 있습니다."}},"hu":{"stringUnit":{"state":"translated","value":"%@ — az alkalmazás, amit éppen nézel. Itt minden egy tanulókártya: elöl a kérdés, hátul a válasz."}},"id":{"stringUnit":{"state":"translated","value":"%@ — aplikasi yang sedang Anda lihat. Semua di sini adalah kartu belajar: pertanyaan di depan, jawaban di belakang."}},"is":{"stringUnit":{"state":"translated","value":"%@ — forritið sem þú ert að horfa á núna. Hér er allt minnisspjald: spurning á framhlið og svar á bakhlið."}},"gu":{"stringUnit":{"state":"translated","value":"%@ — તમે અત્યારે જોઈ રહ્યા છો તે ઍપ. અહીં બધું એક ફ્લૅશકાર્ડ છે: આગળ પ્રશ્ન અને પાછળ જવાબ."}},"he":{"stringUnit":{"state":"translated","value":"%@ — האפליקציה שמוצגת מולך כרגע. הכול כאן כרטיסיות: שאלה בחזית, והתשובה בגב."}},"hr":{"stringUnit":{"state":"translated","value":"%@ — aplikacija koju upravo gledate. Ovdje je sve kartica za učenje: pitanje na prednjoj strani, odgovor na poleđini."}},"et":{"stringUnit":{"state":"translated","value":"%@ — rakendus, mida praegu vaatad. Kõik siin on õpikaart: esiküljel küsimus, tagaküljel vastus."}},"fa":{"stringUnit":{"state":"translated","value":"%@ — همان برنامه‌ای که اکنون می‌بینید. همه‌چیز اینجا یک فلش‌کارت است: پرسش در رو و پاسخ در پشت."}},"fi":{"stringUnit":{"state":"translated","value":"%@ — sovellus, jota katsot juuri nyt. Kaikki täällä on muistikortteja: kysymys etupuolella ja vastaus kääntöpuolella."}},"cs":{"stringUnit":{"state":"translated","value":"%@ — aplikace, na kterou se právě díváte. Všechno je tu kartička: otázka na přední straně, odpověď na zadní."}},"da":{"stringUnit":{"state":"translated","value":"%@ — appen, du kigger på lige nu. Alt her er et læringskort: et spørgsmål på forsiden og svaret på bagsiden."}},"el":{"stringUnit":{"state":"translated","value":"%@ — η εφαρμογή που βλέπετε αυτή τη στιγμή. Όλα εδώ είναι κάρτες: μια ερώτηση στην μπροστινή πλευρά, η απάντηση στην πίσω."}},"bg":{"stringUnit":{"state":"translated","value":"%@ — приложението, което виждате в момента. Всичко тук е учебна карта: въпрос на лицето и отговор на гърба."}},"bn":{"stringUnit":{"state":"translated","value":"%@ — এই মুহূর্তে আপনি যে অ্যাপটি দেখছেন। এখানে সবকিছুই একটি শেখার কার্ড: সামনের দিকে প্রশ্ন, পেছনের দিকে উত্তর।"}},"ca":{"stringUnit":{"state":"translated","value":"%@ — l’app que estàs mirant ara mateix. Aquí tot és una targeta d’estudi: una pregunta a l’anvers i la resposta al revers."}},"en":{"stringUnit":{"state":"translated","value":"%@ — the app you are looking at right now. Everything here is a flashcard: a question on the front, the answer on the back."}},"ar":{"stringUnit":{"state":"translated","value":"%@ — التطبيق الذي تنظر إليه الآن. كل شيء هنا عبارة عن بطاقة: سؤال على الوجه الأمامي وإجابة على الوجه الخلفي."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"%@ —— 你现在正在看的这个应用。这里的一切都是卡片：正面是问题，背面是答案。"}},"de":{"stringUnit":{"state":"translated","value":"%@ — die App, die du gerade vor dir hast. Alles hier ist eine Karte: vorne eine Frage, hinten die Antwort."}},"fr":{"stringUnit":{"state":"translated","value":"%@ — l’application que vous avez sous les yeux en ce moment. Ici, tout est une carte : une question au recto, la réponse au verso."}},"hi":{"stringUnit":{"state":"translated","value":"%@ — वही ऐप जिसे आप अभी देख रहे हैं। यहाँ सब कुछ एक कार्ड है: सामने एक सवाल, पीछे उसका जवाब।"}},"ja":{"stringUnit":{"state":"translated","value":"%@ — 今まさに見ているこのアプリです。ここにあるものはすべてカードです。表に問題、裏に答えがあります。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"%@ — o app que você está vendo agora mesmo. Aqui tudo é um cartão: uma pergunta na frente e a resposta no verso."}},"ru":{"stringUnit":{"state":"translated","value":"%@ — приложение, которое вы видите прямо сейчас. Здесь всё — это карточки: вопрос на лицевой стороне, ответ на обратной."}},"es-MX":{"stringUnit":{"state":"translated","value":"%@ — la aplicación que estás viendo ahora mismo. Todo aquí es una tarjeta: una pregunta en el frente y la respuesta en el reverso."}},"es-ES":{"stringUnit":{"state":"translated","value":"%@ — la aplicación que estás viendo ahora mismo. Todo aquí es una tarjeta: una pregunta en el anverso y la respuesta en el reverso."}}}},
    "demo_card_back_2":{"comment":"Paragraph on the back of the onboarding demo flashcard","extractionState":"manual","localizations":{"sw":{"stringUnit":{"state":"translated","value":"Ipe gumzo la AI lililojengwa ndani mada, nalo litakuundia kadi kadhaa."}},"ta":{"stringUnit":{"state":"translated","value":"உள்ளமைந்த AI அரட்டைக்கு ஒரு தலைப்பைக் கொடுங்கள்; அது உங்களுக்காக அட்டைகளின் தொகுப்பை உருவாக்கும்."}},"te":{"stringUnit":{"state":"translated","value":"యాప్‌లోని AI చాట్‌కు ఒక అంశాన్ని ఇవ్వండి; అది మీ కోసం కార్డుల సమితిని సృష్టిస్తుంది."}},"sk":{"stringUnit":{"state":"translated","value":"Zadajte vstavanému AI chatu tému a vytvorí pre vás sadu kariet."}},"sl":{"stringUnit":{"state":"translated","value":"Vgrajenemu klepetu z UI podajte temo in za vas bo ustvaril nabor kartic."}},"sv":{"stringUnit":{"state":"translated","value":"Ge den inbyggda AI-chatten ett ämne så skapar den en uppsättning kort åt dig."}},"pa":{"stringUnit":{"state":"translated","value":"ਐਪ ਦੀ AI ਚੈਟ ਨੂੰ ਕੋਈ ਵਿਸ਼ਾ ਦਿਓ ਅਤੇ ਇਹ ਤੁਹਾਡੇ ਲਈ ਕਾਰਡਾਂ ਦਾ ਸੈੱਟ ਬਣਾਏਗੀ।"}},"pl":{"stringUnit":{"state":"translated","value":"Podaj temat wbudowanemu czatowi AI, a utworzy dla Ciebie zestaw fiszek."}},"ro":{"stringUnit":{"state":"translated","value":"Dă-i chatului AI integrat un subiect și va crea un set de fișe pentru tine."}},"mr":{"stringUnit":{"state":"translated","value":"अ‍ॅपमधील AI चॅटला एखादा विषय द्या, आणि तो तुमच्यासाठी कार्डांचा संच तयार करेल."}},"nb":{"stringUnit":{"state":"translated","value":"Gi den innebygde AI-chatten et emne, så lager den et sett med kort til deg."}},"nl":{"stringUnit":{"state":"translated","value":"Geef de ingebouwde AI-chat een onderwerp en die maakt een set kaarten voor je."}},"lt":{"stringUnit":{"state":"translated","value":"Pateikite temą integruotam DI pokalbiui ir jis sukurs jums kortelių rinkinį."}},"lv":{"stringUnit":{"state":"translated","value":"Dodiet iebūvētajai MI sarunai tēmu, un tā izveidos jums kartīšu kopu."}},"ml":{"stringUnit":{"state":"translated","value":"ആപ്പിലെ AI ചാറ്റിന് ഒരു വിഷയം നൽകൂ; അത് നിങ്ങൾക്കായി കാർഡുകൾ സൃഷ്ടിക്കും."}},"it":{"stringUnit":{"state":"translated","value":"Dai un argomento alla chat IA integrata e creerà un insieme di schede per te."}},"kn":{"stringUnit":{"state":"translated","value":"ಅಂತರ್ನಿರ್ಮಿತ AI ಚಾಟ್‌ಗೆ ಒಂದು ವಿಷಯ ನೀಡಿ; ಅದು ನಿಮಗಾಗಿ ಕಾರ್ಡ್‌ಗಳ ಗುಂಪನ್ನು ರಚಿಸುತ್ತದೆ."}},"ko":{"stringUnit":{"state":"translated","value":"내장 AI 채팅에 주제를 알려주면 카드 모음을 만들어 줍니다."}},"hu":{"stringUnit":{"state":"translated","value":"Adj meg egy témát a beépített AI-csevegésben, és elkészít neked egy kártyacsomagot."}},"id":{"stringUnit":{"state":"translated","value":"Berikan topik ke obrolan AI bawaan dan AI akan membuat satu set kartu untuk Anda."}},"is":{"stringUnit":{"state":"translated","value":"Gefðu innbyggða gervigreindarspjallinu efni og það býr til spjaldasafn fyrir þig."}},"gu":{"stringUnit":{"state":"translated","value":"અંદરના AI ચૅટને વિષય આપો અને તે તમારા માટે કાર્ડનો સમૂહ બનાવશે."}},"he":{"stringUnit":{"state":"translated","value":"אפשר לתת נושא לצ׳אט AI המובנה והוא ייצור עבורך קבוצת כרטיסיות."}},"hr":{"stringUnit":{"state":"translated","value":"Zadajte temu ugrađenom AI razgovoru i stvorit će skup kartica za vas."}},"et":{"stringUnit":{"state":"translated","value":"Anna sisseehitatud tehisintellekti vestlusele teema ja see loob sulle kaardikomplekti."}},"fa":{"stringUnit":{"state":"translated","value":"به گفت‌وگوی هوش مصنوعی داخلی یک موضوع بدهید تا مجموعه‌ای از کارت‌ها برایتان بسازد."}},"fi":{"stringUnit":{"state":"translated","value":"Anna sisäänrakennetulle tekoälykeskustelulle aihe, niin se luo sinulle korttisarjan."}},"cs":{"stringUnit":{"state":"translated","value":"Zadejte téma do vestavěného chatu s AI a vytvoří vám sadu kartiček."}},"da":{"stringUnit":{"state":"translated","value":"Giv den indbyggede AI-chat et emne, så opretter den et sæt kort til dig."}},"el":{"stringUnit":{"state":"translated","value":"Δώστε ένα θέμα στην ενσωματωμένη συνομιλία με την ΤΝ και θα δημιουργήσει ένα σύνολο καρτών για εσάς."}},"bg":{"stringUnit":{"state":"translated","value":"Задайте тема на вградения чат с ИИ и той ще създаде набор от карти за вас."}},"bn":{"stringUnit":{"state":"translated","value":"অ্যাপের এআই চ্যাটকে একটি বিষয় দিন, আর এটি আপনার জন্য এক সেট কার্ড তৈরি করবে।"}},"ca":{"stringUnit":{"state":"translated","value":"Dona un tema al xat amb IA integrat i et crearà un conjunt de targetes."}},"en":{"stringUnit":{"state":"translated","value":"Give the built-in AI chat a topic and it will create a set of cards for you."}},"ar":{"stringUnit":{"state":"translated","value":"أعطِ محادثة الذكاء الاصطناعي المدمجة موضوعًا، وستنشئ لك مجموعة من البطاقات."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"给内置的 AI 对话一个主题，它就会为你创建一组卡片。"}},"de":{"stringUnit":{"state":"translated","value":"Nenne dem eingebauten KI-Chat ein Thema, und er erstellt dir einen Satz Karten."}},"fr":{"stringUnit":{"state":"translated","value":"Donnez un sujet au chat IA intégré et il créera un ensemble de cartes pour vous."}},"hi":{"stringUnit":{"state":"translated","value":"अंतर्निहित AI चैट को कोई विषय दें और वह आपके लिए कार्ड का एक सेट बना देगा।"}},"ja":{"stringUnit":{"state":"translated","value":"内蔵のAIチャットにテーマを伝えるだけで、カードのセットを作成してくれます。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Dê um tema ao chat com IA integrado e ele vai criar um conjunto de cartões para você."}},"ru":{"stringUnit":{"state":"translated","value":"Назовите тему встроенному ИИ-чату, и он создаст для вас набор карточек."}},"es-MX":{"stringUnit":{"state":"translated","value":"Dale un tema al chat de IA integrado y él creará un conjunto de tarjetas para ti."}},"es-ES":{"stringUnit":{"state":"translated","value":"Dale un tema al chat de IA integrado y creará un conjunto de tarjetas para ti."}}}},
    "demo_card_back_3":{"comment":"Paragraph on the back of the onboarding demo flashcard. %@ is the Again rating label, already wrapped in Markdown inline code, so do not add quotation marks around it.","extractionState":"manual","localizations":{"sw":{"stringUnit":{"state":"translated","value":"Jaribu sasa hivi: kadiria kadi hii %@, nayo itarudi baada ya takriban dakika moja — ili jibu hili likae akilini."}},"ta":{"stringUnit":{"state":"translated","value":"இப்போதே முயலுங்கள்: இந்த அட்டைக்கு %@ என மதிப்பிடுங்கள்; சுமார் ஒரு நிமிடத்தில் இது மீண்டும் வரும் — இந்தப் பதில் நினைவில் பதியும்."}},"te":{"stringUnit":{"state":"translated","value":"ఇప్పుడే ప్రయత్నించండి: ఈ కార్డును %@గా రేట్ చేయండి. దాదాపు ఒక నిమిషంలో అది మళ్లీ వస్తుంది — ఈ సమాధానం గుర్తుండిపోతుంది."}},"sk":{"stringUnit":{"state":"translated","value":"Skúste to hneď: ohodnoťte túto kartu ako %@ a približne o minútu sa vráti — aby vám odpoveď zostala v pamäti."}},"sl":{"stringUnit":{"state":"translated","value":"Poskusite zdaj: to kartico ocenite z %@ in vrnila se bo čez približno minuto — da si odgovor zapomnite."}},"sv":{"stringUnit":{"state":"translated","value":"Prova nu: bedöm kortet som %@ så kommer det tillbaka om ungefär en minut — så att svaret fastnar."}},"pa":{"stringUnit":{"state":"translated","value":"ਹੁਣੇ ਅਜ਼ਮਾਓ: ਇਸ ਕਾਰਡ ਨੂੰ %@ ਰੇਟ ਕਰੋ ਅਤੇ ਇਹ ਲਗਭਗ ਇੱਕ ਮਿੰਟ ਵਿੱਚ ਮੁੜ ਆਵੇਗਾ — ਤਾਂ ਜੋ ਇਹ ਜਵਾਬ ਯਾਦ ਰਹੇ।"}},"pl":{"stringUnit":{"state":"translated","value":"Wypróbuj teraz: oceń tę fiszkę jako %@, a wróci za około minutę — żeby ta odpowiedź zapadła w pamięć."}},"ro":{"stringUnit":{"state":"translated","value":"Încearcă acum: evaluează această fișă cu %@ și va reveni peste aproximativ un minut — ca să reții răspunsul."}},"mr":{"stringUnit":{"state":"translated","value":"आत्ताच करून पाहा: या कार्डला %@ रेटिंग द्या. साधारण एका मिनिटात ते पुन्हा येईल — म्हणजे हे उत्तर लक्षात राहील."}},"nb":{"stringUnit":{"state":"translated","value":"Prøv det nå: vurder dette kortet som %@, så kommer det tilbake om omtrent et minutt — slik at svaret fester seg."}},"nl":{"stringUnit":{"state":"translated","value":"Probeer het nu: beoordeel deze kaart met %@ en hij komt over ongeveer een minuut terug — zodat dit antwoord blijft hangen."}},"lt":{"stringUnit":{"state":"translated","value":"Išbandykite dabar: įvertinkite šią kortelę %@, ir ji grįš maždaug po minutės, kad šis atsakymas įsimintų."}},"lv":{"stringUnit":{"state":"translated","value":"Izmēģiniet tagad: novērtējiet šo kartīti ar %@, un tā atgriezīsies apmēram pēc minūtes, lai šī atbilde paliktu atmiņā."}},"ml":{"stringUnit":{"state":"translated","value":"ഇപ്പോൾ പരീക്ഷിക്കൂ: ഈ കാർഡിന് %@ എന്ന് റേറ്റ് ചെയ്യൂ; ഏകദേശം ഒരു മിനിറ്റിൽ അത് വീണ്ടും വരും — ഈ ഉത്തരം ഓർമ്മയിൽ നിൽക്കാൻ."}},"it":{"stringUnit":{"state":"translated","value":"Prova subito: valuta questa scheda %@ e tornerà tra circa un minuto, così ricorderai questa risposta."}},"kn":{"stringUnit":{"state":"translated","value":"ಈಗಲೇ ಪ್ರಯತ್ನಿಸಿ: ಈ ಕಾರ್ಡ್‌ಗೆ %@ ಮೌಲ್ಯಮಾಪನ ನೀಡಿ. ಸುಮಾರು ಒಂದು ನಿಮಿಷದಲ್ಲಿ ಅದು ಮರಳಿ ಬರುತ್ತದೆ — ಈ ಉತ್ತರ ನೆನಪಿನಲ್ಲಿ ಉಳಿಯಲು."}},"ko":{"stringUnit":{"state":"translated","value":"지금 해보세요. 이 카드를 %@로 평가하면 약 1분 후에 다시 나타나 이 답을 기억하는 데 도움이 됩니다."}},"hu":{"stringUnit":{"state":"translated","value":"Próbáld ki most: értékeld ezt a kártyát %@ értékeléssel, és körülbelül egy perc múlva visszatér — így megjegyzed a választ."}},"id":{"stringUnit":{"state":"translated","value":"Coba sekarang: beri kartu ini nilai %@, dan kartu akan muncul lagi sekitar satu menit kemudian — agar jawabannya melekat."}},"is":{"stringUnit":{"state":"translated","value":"Prófaðu núna: veldu %@ fyrir þetta spjald og það kemur aftur eftir um mínútu — svo svarið festist í minni."}},"gu":{"stringUnit":{"state":"translated","value":"હમણાં જ અજમાવો: આ કાર્ડને %@ રેટિંગ આપો અને તે લગભગ એક મિનિટમાં ફરી આવશે — જેથી આ જવાબ યાદ રહી જાય."}},"he":{"stringUnit":{"state":"translated","value":"אפשר לנסות עכשיו: לתת לכרטיסייה הזו דירוג %@, והיא תחזור בעוד כדקה — כדי שהתשובה תישאר בזיכרון."}},"hr":{"stringUnit":{"state":"translated","value":"Isprobajte odmah: ocijenite ovu karticu s %@ i vratit će se za otprilike minutu — kako biste zapamtili odgovor."}},"et":{"stringUnit":{"state":"translated","value":"Proovi kohe: hinda seda kaarti hinnanguga %@ ja see ilmub umbes minuti pärast uuesti — nii jääb see vastus meelde."}},"fa":{"stringUnit":{"state":"translated","value":"همین حالا امتحان کنید: به این کارت امتیاز %@ بدهید تا حدود یک دقیقهٔ دیگر برگردد — تا این پاسخ در ذهن بماند."}},"fi":{"stringUnit":{"state":"translated","value":"Kokeile heti: anna tälle kortille arvio %@, niin se palaa noin minuutin kuluttua — jotta tämä vastaus jää mieleen."}},"cs":{"stringUnit":{"state":"translated","value":"Vyzkoušejte to hned: ohodnoťte tuto kartičku %@ a asi za minutu se vrátí — abyste si odpověď zapamatovali."}},"da":{"stringUnit":{"state":"translated","value":"Prøv nu: bedøm dette kort som %@, så kommer det igen om cirka et minut — så svaret bliver hængende."}},"el":{"stringUnit":{"state":"translated","value":"Δοκιμάστε τώρα: βαθμολογήστε αυτήν την κάρτα με %@ και θα εμφανιστεί ξανά σε περίπου ένα λεπτό — για να σας μείνει η απάντηση."}},"bg":{"stringUnit":{"state":"translated","value":"Опитайте сега: оценете тази карта с %@ и тя ще се появи отново след около минута — за да запомните отговора."}},"bn":{"stringUnit":{"state":"translated","value":"এখনই চেষ্টা করুন: এই কার্ডটিকে %@ দিয়ে মূল্যায়ন করুন। প্রায় এক মিনিট পর এটি আবার আসবে—যাতে উত্তরটি আপনার মনে থাকে।"}},"ca":{"stringUnit":{"state":"translated","value":"Prova-ho ara mateix: valora aquesta targeta amb %@ i tornarà d’aquí a un minut, aproximadament, perquè en recordis la resposta."}},"en":{"stringUnit":{"state":"translated","value":"Try it right now: rate this card %@, and it will come back in about a minute — so this answer sticks."}},"ar":{"stringUnit":{"state":"translated","value":"جرّب ذلك الآن: قيّم هذه البطاقة بـ %@، وستعود بعد دقيقة تقريبًا حتى ترسخ هذه الإجابة."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"现在就试一试：把这张卡片评为%@，它大约一分钟后就会再次出现，好让这个答案记牢。"}},"de":{"stringUnit":{"state":"translated","value":"Probiere es gleich aus: Bewerte diese Karte mit %@, dann kommt sie in etwa einer Minute wieder — damit diese Antwort sitzt."}},"fr":{"stringUnit":{"state":"translated","value":"Essayez tout de suite : évaluez cette carte avec %@, et elle reviendra dans une minute environ — pour que cette réponse s’ancre."}},"hi":{"stringUnit":{"state":"translated","value":"अभी आज़माएं: इस कार्ड को %@ दें, और यह करीब एक मिनट में फिर आ जाएगा — ताकि यह जवाब पक्का याद रह जाए।"}},"ja":{"stringUnit":{"state":"translated","value":"今すぐ試してみましょう。このカードを%@と評価すると、約1分後にもう一度出てきます。こうしてこの答えが定着します。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Experimente agora mesmo: avalie este cartão como %@ e ele vai voltar em cerca de um minuto — assim esta resposta fixa."}},"ru":{"stringUnit":{"state":"translated","value":"Попробуйте прямо сейчас: оцените эту карточку как %@, и она вернётся примерно через минуту — чтобы этот ответ закрепился."}},"es-MX":{"stringUnit":{"state":"translated","value":"Pruébalo ahora mismo: califica esta tarjeta como %@ y volverá en aproximadamente un minuto, para que esta respuesta se te quede."}},"es-ES":{"stringUnit":{"state":"translated","value":"Pruébalo ahora mismo: valora esta tarjeta como %@ y volverá en aproximadamente un minuto, para que esta respuesta se te quede."}}}},
