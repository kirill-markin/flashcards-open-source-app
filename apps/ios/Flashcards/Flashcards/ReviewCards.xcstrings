    "Cards are the prompts and answers you review to learn and remember.":{"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Cards are the prompts and answers you review to learn and remember."}},"ar":{"stringUnit":{"state":"translated","value":"البطاقات هي الأسئلة والأجوبة التي تراجعها للتعلم والتذكر."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"卡片是你为了学习和记忆而复习的提示与答案。"}},"de":{"stringUnit":{"state":"translated","value":"Karten sind die Fragen und Antworten, die du wiederholst, um zu lernen und dich zu erinnern."}},"fr":{"stringUnit":{"state":"translated","value":"Les cartes sont les questions et les réponses que vous révisez pour apprendre et mémoriser."}},"hi":{"stringUnit":{"state":"translated","value":"कार्ड वे संकेत और उत्तर हैं जिन्हें आप सीखने और याद रखने के लिए दोहराते हैं।"}},"ja":{"stringUnit":{"state":"translated","value":"カードは、学習して記憶に定着させるために復習する問題と答えです。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Os cartões são as perguntas e respostas que você revisa para aprender e lembrar."}},"ru":{"stringUnit":{"state":"translated","value":"Карточки — это вопросы и ответы, которые вы повторяете, чтобы учиться и запоминать."}},"es-MX":{"stringUnit":{"state":"translated","value":"Las tarjetas son las preguntas y respuestas que repasas para aprender y recordar."}},"es-ES":{"stringUnit":{"state":"translated","value":"Las tarjetas son las preguntas y respuestas que repasas para aprender y recordar."}}}},
    "Cards couldn't load. Try again.":{"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Cards couldn't load. Try again."}},"ar":{"stringUnit":{"state":"translated","value":"تعذر تحميل البطاقات. حاول مرة أخرى."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"无法加载卡片。请重试。"}},"de":{"stringUnit":{"state":"translated","value":"Karten konnten nicht geladen werden. Versuche es erneut."}},"fr":{"stringUnit":{"state":"translated","value":"Impossible de charger les cartes. Réessayez."}},"hi":{"stringUnit":{"state":"translated","value":"कार्ड लोड नहीं हो सके। फिर से कोशिश करें।"}},"ja":{"stringUnit":{"state":"translated","value":"カードを読み込めませんでした。もう一度お試しください。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Não foi possível carregar os cartões. Tente novamente."}},"ru":{"stringUnit":{"state":"translated","value":"Не удалось загрузить карточки. Попробуйте снова."}},"es-MX":{"stringUnit":{"state":"translated","value":"No se pudieron cargar las tarjetas. Inténtalo de nuevo."}},"es-ES":{"stringUnit":{"state":"translated","value":"No se pudieron cargar las tarjetas. Inténtalo de nuevo."}}}},
