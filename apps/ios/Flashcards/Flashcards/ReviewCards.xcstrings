    "This review filter does not include any cards yet.":{"extractionState":"manual","localizations":{"et":{"stringUnit":{"state":"translated","value":"See kordamisfilter ei sisalda veel ühtegi kaarti."}},"fa":{"stringUnit":{"state":"translated","value":"این فیلتر مرور هنوز هیچ کارتی ندارد."}},"fi":{"stringUnit":{"state":"translated","value":"Tämä kertaussuodatin ei sisällä vielä kortteja."}},"cs":{"stringUnit":{"state":"translated","value":"Tento filtr opakování zatím neobsahuje žádné kartičky."}},"da":{"stringUnit":{"state":"translated","value":"Dette repetitionsfilter omfatter ingen kort endnu."}},"el":{"stringUnit":{"state":"translated","value":"Αυτό το φίλτρο επανάληψης δεν περιλαμβάνει κάρτες ακόμα."}},"bg":{"stringUnit":{"state":"translated","value":"Този филтър за преговор все още не включва карти."}},"bn":{"stringUnit":{"state":"translated","value":"এই পুনরালোচনা ফিল্টার এখনও কোনো কার্ড অন্তর্ভুক্ত করে না।"}},"ca":{"stringUnit":{"state":"translated","value":"Aquest filtre de repàs encara no inclou cap targeta."}},"en":{"stringUnit":{"state":"translated","value":"This review filter does not include any cards yet."}},"ar":{"stringUnit":{"state":"translated","value":"لا يتضمن عامل تصفية المراجعة هذا أي بطاقات بعد."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"此复习筛选条件中还没有任何卡片。"}},"de":{"stringUnit":{"state":"translated","value":"Dieser Wiederholungsfilter enthält noch keine Karten."}},"fr":{"stringUnit":{"state":"translated","value":"Ce filtre de révision ne contient encore aucune carte."}},"hi":{"stringUnit":{"state":"translated","value":"इस समीक्षा फ़िल्टर में अभी कोई कार्ड शामिल नहीं है।"}},"ja":{"stringUnit":{"state":"translated","value":"この復習フィルタにはまだカードが含まれていません。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Este filtro de revisão ainda não inclui nenhum cartão."}},"ru":{"stringUnit":{"state":"translated","value":"Этот фильтр повторения пока не включает ни одной карточки."}},"es-MX":{"stringUnit":{"state":"translated","value":"Este filtro de repaso todavía no incluye ninguna tarjeta."}},"es-ES":{"stringUnit":{"state":"translated","value":"Este filtro de repaso todavía no incluye ninguna tarjeta."}}}},
    "Try a different search or clear filters.":{"extractionState":"manual","localizations":{"et":{"stringUnit":{"state":"translated","value":"Proovi muud otsingut või tühjenda filtrid."}},"fa":{"stringUnit":{"state":"translated","value":"جست‌وجوی دیگری امتحان کنید یا فیلترها را پاک کنید."}},"fi":{"stringUnit":{"state":"translated","value":"Kokeile toista hakua tai tyhjennä suodattimet."}},"cs":{"stringUnit":{"state":"translated","value":"Zkuste jiné hledání nebo zrušte filtry."}},"da":{"stringUnit":{"state":"translated","value":"Prøv en anden søgning, eller ryd filtrene."}},"el":{"stringUnit":{"state":"translated","value":"Δοκιμάστε άλλη αναζήτηση ή εκκαθαρίστε τα φίλτρα."}},"bg":{"stringUnit":{"state":"translated","value":"Опитайте с различно търсене или изчистете филтрите."}},"bn":{"stringUnit":{"state":"translated","value":"একটি ভিন্ন অনুসন্ধান বা পরিষ্কার ফিল্টার চেষ্টা করুন।"}},"ca":{"stringUnit":{"state":"translated","value":"Prova una cerca diferent o esborra els filtres."}},"en":{"stringUnit":{"state":"translated","value":"Try a different search or clear filters."}},"ar":{"stringUnit":{"state":"translated","value":"جرّب بحثًا مختلفًا أو امسح عوامل التصفية."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请尝试其他搜索或清除筛选条件。"}},"de":{"stringUnit":{"state":"translated","value":"Probiere eine andere Suche aus oder lösche die Filter."}},"fr":{"stringUnit":{"state":"translated","value":"Essayez une autre recherche ou effacez les filtres."}},"hi":{"stringUnit":{"state":"translated","value":"कोई दूसरा खोज शब्द आज़माएं या फ़िल्टर साफ़ करें।"}},"ja":{"stringUnit":{"state":"translated","value":"別の検索を試すか、フィルタをクリアしてください。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Tente outra busca ou limpe os filtros."}},"ru":{"stringUnit":{"state":"translated","value":"Попробуйте другой поиск или сбросьте фильтры."}},"es-MX":{"stringUnit":{"state":"translated","value":"Prueba otra búsqueda o borra los filtros."}},"es-ES":{"stringUnit":{"state":"translated","value":"Prueba otra búsqueda o borra los filtros."}}}},
    "Try clearing filters.":{"extractionState":"manual","localizations":{"et":{"stringUnit":{"state":"translated","value":"Proovi filtrid tühjendada."}},"fa":{"stringUnit":{"state":"translated","value":"پاک کردن فیلترها را امتحان کنید."}},"fi":{"stringUnit":{"state":"translated","value":"Kokeile suodattimien tyhjentämistä."}},"cs":{"stringUnit":{"state":"translated","value":"Zkuste zrušit filtry."}},"da":{"stringUnit":{"state":"translated","value":"Prøv at rydde filtrene."}},"el":{"stringUnit":{"state":"translated","value":"Δοκιμάστε να εκκαθαρίσετε τα φίλτρα."}},"bg":{"stringUnit":{"state":"translated","value":"Опитайте да изчистите филтрите."}},"bn":{"stringUnit":{"state":"translated","value":"ফিল্টার পরিষ্কার করার চেষ্টা করুন।"}},"ca":{"stringUnit":{"state":"translated","value":"Prova d'esborrar els filtres."}},"en":{"stringUnit":{"state":"translated","value":"Try clearing filters."}},"ar":{"stringUnit":{"state":"translated","value":"جرّب مسح عوامل التصفية."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"试试清除筛选条件。"}},"de":{"stringUnit":{"state":"translated","value":"Versuche, die Filter zu löschen."}},"fr":{"stringUnit":{"state":"translated","value":"Essayez d’effacer les filtres."}},"hi":{"stringUnit":{"state":"translated","value":"फ़िल्टर साफ़ करके देखें।"}},"ja":{"stringUnit":{"state":"translated","value":"フィルタをクリアしてみてください。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Tente limpar os filtros."}},"ru":{"stringUnit":{"state":"translated","value":"Попробуйте сбросить фильтры."}},"es-MX":{"stringUnit":{"state":"translated","value":"Prueba a borrar los filtros."}},"es-ES":{"stringUnit":{"state":"translated","value":"Prueba a borrar los filtros."}}}},
    "Video attachment":{"extractionState":"manual","localizations":{"et":{"stringUnit":{"state":"translated","value":"Videomanus"}},"fa":{"stringUnit":{"state":"translated","value":"پیوست ویدیویی"}},"fi":{"stringUnit":{"state":"translated","value":"Videoliite"}},"cs":{"stringUnit":{"state":"translated","value":"Videopříloha"}},"da":{"stringUnit":{"state":"translated","value":"Videovedhæftning"}},"el":{"stringUnit":{"state":"translated","value":"Συνημμένο βίντεο"}},"bg":{"stringUnit":{"state":"translated","value":"Прикачен видеоклип"}},"bn":{"stringUnit":{"state":"translated","value":"ভিডিও সংযুক্তি"}},"ca":{"stringUnit":{"state":"translated","value":"Vídeo adjunt"}},"en":{"stringUnit":{"state":"translated","value":"Video attachment"}},"ar":{"stringUnit":{"state":"translated","value":"مرفق فيديو"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"视频附件"}},"de":{"stringUnit":{"state":"translated","value":"Videoanhang"}},"fr":{"stringUnit":{"state":"translated","value":"Pièce jointe vidéo"}},"hi":{"stringUnit":{"state":"translated","value":"वीडियो अटैचमेंट"}},"ja":{"stringUnit":{"state":"translated","value":"動画添付"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Anexo de vídeo"}},"ru":{"stringUnit":{"state":"translated","value":"Видеовложение"}},"es-MX":{"stringUnit":{"state":"translated","value":"Adjunto de video"}},"es-ES":{"stringUnit":{"state":"translated","value":"Adjunto de video"}}}},
    "You haven't created any cards yet.":{"extractionState":"manual","localizations":{"et":{"stringUnit":{"state":"translated","value":"Sa pole veel ühtegi kaarti loonud."}},"fa":{"stringUnit":{"state":"translated","value":"هنوز هیچ کارتی نساخته‌اید."}},"fi":{"stringUnit":{"state":"translated","value":"Et ole vielä luonut kortteja."}},"cs":{"stringUnit":{"state":"translated","value":"Zatím jste nevytvořili žádné kartičky."}},"da":{"stringUnit":{"state":"translated","value":"Du har ikke oprettet nogen kort endnu."}},"el":{"stringUnit":{"state":"translated","value":"Δεν έχετε δημιουργήσει κάρτες ακόμα."}},"bg":{"stringUnit":{"state":"translated","value":"Все още не сте създали никакви карти."}},"bn":{"stringUnit":{"state":"translated","value":"আপনি এখনও কোনো কার্ড তৈরি করেননি।"}},"ca":{"stringUnit":{"state":"translated","value":"Encara no has creat cap targeta."}},"en":{"stringUnit":{"state":"translated","value":"You haven't created any cards yet."}},"ar":{"stringUnit":{"state":"translated","value":"لم تنشئ أي بطاقات بعد."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"你还没有创建任何卡片。"}},"de":{"stringUnit":{"state":"translated","value":"Du hast noch keine Karten erstellt."}},"fr":{"stringUnit":{"state":"translated","value":"Vous n’avez pas encore créé de cartes."}},"hi":{"stringUnit":{"state":"translated","value":"आपने अभी तक कोई कार्ड नहीं बनाया है।"}},"ja":{"stringUnit":{"state":"translated","value":"まだカードを作成していません。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Você ainda não criou nenhum cartão."}},"ru":{"stringUnit":{"state":"translated","value":"Вы еще не создали ни одной карточки."}},"es-MX":{"stringUnit":{"state":"translated","value":"Aún no has creado ninguna tarjeta."}},"es-ES":{"stringUnit":{"state":"translated","value":"Aún no has creado ninguna tarjeta."}}}},
    "You haven't created any cards yet. Add your first card to start studying.":{"extractionState":"manual","localizations":{"et":{"stringUnit":{"state":"translated","value":"Sa pole veel ühtegi kaarti loonud. Õppimise alustamiseks lisa oma esimene kaart."}},"fa":{"stringUnit":{"state":"translated","value":"هنوز هیچ کارتی نساخته‌اید. برای شروع مطالعه، اولین کارت خود را اضافه کنید."}},"fi":{"stringUnit":{"state":"translated","value":"Et ole vielä luonut kortteja. Aloita opiskelu lisäämällä ensimmäinen korttisi."}},"cs":{"stringUnit":{"state":"translated","value":"Zatím jste nevytvořili žádné kartičky. Přidejte první kartičku a začněte se učit."}},"da":{"stringUnit":{"state":"translated","value":"Du har ikke oprettet nogen kort endnu. Tilføj dit første kort for at begynde at lære."}},"el":{"stringUnit":{"state":"translated","value":"Δεν έχετε δημιουργήσει κάρτες ακόμα. Προσθέστε την πρώτη σας κάρτα για να αρχίσετε τη μελέτη."}},"bg":{"stringUnit":{"state":"translated","value":"Все още не сте създали никакви карти. Добавете първата си карта, за да започнете да учите."}},"bn":{"stringUnit":{"state":"translated","value":"আপনি এখনও কোনো কার্ড তৈরি করেননি। পড়াশোনা শুরু করতে আপনার প্রথম কার্ড যোগ করুন।"}},"ca":{"stringUnit":{"state":"translated","value":"Encara no has creat cap targeta. Afegeix la teva primera targeta per començar a estudiar."}},"en":{"stringUnit":{"state":"translated","value":"You haven't created any cards yet. Add your first card to start studying."}},"ar":{"stringUnit":{"state":"translated","value":"لم تنشئ أي بطاقات بعد. أضف بطاقتك الأولى لبدء الدراسة."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"你还没有创建任何卡片。添加第一张卡片即可开始学习。"}},"de":{"stringUnit":{"state":"translated","value":"Du hast noch keine Karten erstellt. Füge deine erste Karte hinzu, um mit dem Lernen zu beginnen."}},"fr":{"stringUnit":{"state":"translated","value":"Vous n’avez pas encore créé de cartes. Ajoutez votre première carte pour commencer à étudier."}},"hi":{"stringUnit":{"state":"translated","value":"आपने अभी तक कोई कार्ड नहीं बनाया है। पढ़ाई शुरू करने के लिए अपना पहला कार्ड जोड़ें।"}},"ja":{"stringUnit":{"state":"translated","value":"まだカードを作成していません。最初のカードを追加して学習を始めましょう。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Você ainda não criou nenhum cartão. Adicione seu primeiro cartão para começar a estudar."}},"ru":{"stringUnit":{"state":"translated","value":"Вы еще не создали ни одной карточки. Добавьте первую карточку, чтобы начать учиться."}},"es-MX":{"stringUnit":{"state":"translated","value":"Aún no has creado ninguna tarjeta. Agrega tu primera tarjeta para empezar a estudiar."}},"es-ES":{"stringUnit":{"state":"translated","value":"Aún no has creado ninguna tarjeta. Añade tu primera tarjeta para empezar a estudiar."}}}},
    "You're all caught up for now. Come back later or add more cards.":{"extractionState":"manual","localizations":{"et":{"stringUnit":{"state":"translated","value":"Praeguseks on kõik korratud. Tule hiljem tagasi või lisa kaarte."}},"fa":{"stringUnit":{"state":"translated","value":"فعلاً همه‌چیز مرور شده است. بعداً برگردید یا کارت‌های بیشتری اضافه کنید."}},"fi":{"stringUnit":{"state":"translated","value":"Kaikki on toistaiseksi kerrattu. Palaa myöhemmin tai lisää kortteja."}},"cs":{"stringUnit":{"state":"translated","value":"Prozatím máte vše hotovo. Vraťte se později nebo přidejte další kartičky."}},"da":{"stringUnit":{"state":"translated","value":"Du er ajour for nu. Kom tilbage senere, eller tilføj flere kort."}},"el":{"stringUnit":{"state":"translated","value":"Προς το παρόν τα ολοκληρώσατε όλα. Επιστρέψτε αργότερα ή προσθέστε περισσότερες κάρτες."}},"bg":{"stringUnit":{"state":"translated","value":"Всички карти за момента са преговорени. Върнете се по-късно или добавете още карти."}},"bn":{"stringUnit":{"state":"translated","value":"এখনকার সব কার্ডের পুনরালোচনা শেষ। পরে ফিরে আসুন বা আরও কার্ড যোগ করুন।"}},"ca":{"stringUnit":{"state":"translated","value":"De moment ja ho tens tot al dia. Torna més tard o afegeix més targetes."}},"en":{"stringUnit":{"state":"translated","value":"You're all caught up for now. Come back later or add more cards."}},"ar":{"stringUnit":{"state":"translated","value":"لقد أنهيت كل ما عليك حاليًا. عُد لاحقًا أو أضف المزيد من البطاقات."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"你目前已经全部复习完了。稍后再来，或添加更多卡片。"}},"de":{"stringUnit":{"state":"translated","value":"Du bist fürs Erste fertig. Komm später wieder oder füge weitere Karten hinzu."}},"fr":{"stringUnit":{"state":"translated","value":"Vous êtes à jour pour le moment. Revenez plus tard ou ajoutez d’autres cartes."}},"hi":{"stringUnit":{"state":"translated","value":"फिलहाल आपने सब पूरा कर लिया है। बाद में वापस आएं या और कार्ड जोड़ें।"}},"ja":{"stringUnit":{"state":"translated","value":"今のところ、復習はすべて完了しています。後で戻るか、カードを追加してください。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Você está em dia por enquanto. Volte mais tarde ou adicione mais cartões."}},"ru":{"stringUnit":{"state":"translated","value":"Сейчас вы все повторили. Вернитесь позже или добавьте еще карточки."}},"es-MX":{"stringUnit":{"state":"translated","value":"Por ahora ya estás al día. Vuelve más tarde o agrega más tarjetas."}},"es-ES":{"stringUnit":{"state":"translated","value":"Por ahora ya estás al día. Vuelve más tarde o añade más tarjetas."}}}},
