e":"Difícil"}},"en":{"stringUnit":{"state":"translated","value":"Hard"}},"ar":{"stringUnit":{"state":"translated","value":"صعب"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"困难"}},"de":{"stringUnit":{"state":"translated","value":"Schwer"}},"fr":{"stringUnit":{"state":"translated","value":"Difficile"}},"hi":{"stringUnit":{"state":"translated","value":"कठिन"}},"ja":{"stringUnit":{"state":"translated","value":"難しい"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Difícil"}},"ru":{"stringUnit":{"state":"translated","value":"Трудно"}},"es-MX":{"stringUnit":{"state":"translated","value":"Difícil"}},"es-ES":{"stringUnit":{"state":"translated","value":"Difícil"}}}},
    "Hard is for difficult recall":{"extractionState":"manual","localizations":{"sw":{"stringUnit":{"state":"translated","value":"Ngumu ni kwa jibu linalokumbukwa kwa shida"}},"ta":{"stringUnit":{"state":"translated","value":"நினைவுகூரக் கடினமாக இருந்தால் கடினம் என்பதைத் தேர்ந்தெடுக்கவும்"}},"te":{"stringUnit":{"state":"translated","value":"గుర్తుకు తెచ్చుకోవడం కష్టమైనప్పుడు కష్టం ఎంచుకోండి"}},"sk":{"stringUnit":{"state":"translated","value":"Ťažké je pre náročné vybavenie si odpovede"}},"sl":{"stringUnit":{"state":"translated","value":"Težko pomeni težaven priklic"}},"sv":{"stringUnit":{"state":"translated","value":"Svårt är för svårigheter att minnas"}},"pa":{"stringUnit":{"state":"translated","value":"ਔਖਾ ਮੁਸ਼ਕਲ ਨਾਲ ਯਾਦ ਆਉਣ ਲਈ ਹੈ"}},"pl":{"stringUnit":{"state":"translated","value":"Trudne oznacza trudność z przypomnieniem"}},"ro":{"stringUnit":{"state":"translated","value":"Greu înseamnă că ți-ai amintit cu dificultate"}},"mr":{"stringUnit":{"state":"translated","value":"कठीण म्हणजे आठवणे अवघड होते"}},"nb":{"stringUnit":{"state":"translated","value":"Vanskelig er for svar som var vanskelige å huske"}},"nl":{"stringUnit":{"state":"translated","value":"Moeilijk betekent dat je het antwoord moeilijk kon herinneren"}},"lt":{"stringUnit":{"state":"translated","value":"„Sunku“ – kai sunku prisiminti"}},"lv":{"stringUnit":{"state":"translated","value":"“Grūti” ir tad, ja bija grūti atcerēties"}},"ml":{"stringUnit":{"state":"translated","value":"ഓർമ്മിച്ചെടുക്കാൻ ബുദ്ധിമുട്ടാണെങ്കിൽ പ്രയാസം"}},"it":{"stringUnit":{"state":"translated","value":"Difficile indica una risposta ricordata a fatica"}},"kn":{"stringUnit":{"state":"translated","value":"ಕಷ್ಟ ಎಂದರೆ ನೆನಪಿಗೆ ತರಲು ಕಷ್ಟವಾದ ಉತ್ತರ"}},"ko":{"stringUnit":{"state":"translated","value":"어려움은 힘들게 떠올린 경우에 선택하세요"}},"hu":{"stringUnit":{"state":"translated","value":"A Nehéz a nehézkes felidézéshez való"}},"id":{"stringUnit":{"state":"translated","value":"Sulit untuk jawaban yang sulit diingat"}},"is":{"stringUnit":{"state":"translated","value":"Erfitt er fyrir erfiða upprifjun"}},"gu":{"stringUnit":{"state":"translated","value":"મુશ્કેલ એટલે યાદ કરવામાં મુશ્કેલી"}},"he":{"stringUnit":{"state":"translated","value":"קשה מיועד לקושי בהיזכרות"}},"hr":{"stringUnit":{"state":"translated","value":"Teško znači otežano prisjećanje"}},"et":{"stringUnit":{"state":"translated","value":"„Raske” tähendab vaevalist meenutamist"}},"fa":{"stringUnit":{"state":"translated","value":"«سخت» برای یادآوری دشوار است"}},"fi":{"stringUnit":{"state":"translated","value":"Vaikea tarkoittaa vaikeaa muistamista"}},"cs":{"stringUnit":{"state":"translated","value":"Těžké je pro obtížné vybavení odpovědi"}},"da":{"stringUnit":{"state":"translated","value":"Svært er til svar, der var svære at huske"}},"el":{"stringUnit":{"state":"translated","value":"Το Δύσκολο είναι για δύσκολη ανάκληση"}},"bg":{"stringUnit":{"state":"translated","value":"„Трудно“ е за отговори, които си спомняте с усилие"}},"bn":{"stringUnit":{"state":"translated","value":"উত্তর মনে করতে কষ্ট হলে কঠিন বেছে নিন"}},"ca":{"stringUnit":{"state":"translated","value":"Difícil és per a quan costa recordar"}},"en":{"stringUnit":{"state":"translated","value":"Hard is for difficult recall"}},"ar":{"stringUnit":{"state":"translated","value":"يُستخدم \"صعب\" عندما يكون التذكر صعبًا"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"“困难”用于回忆起来较吃力的情况"}},"de":{"stringUnit":{"state":"translated","value":"\"Schwer\" ist für Fälle, in denen dir das Erinnern schwerfiel"}},"fr":{"stringUnit":{"state":"translated","value":"« Difficile » sert en cas de rappel difficile"}},"hi":{"stringUnit":{"state":"translated","value":"\"कठिन\" उस स्थिति के लिए है जब याद करना मुश्किल हो"}},"ja":{"stringUnit":{"state":"translated","value":"「難しい」は思い出すのに苦労した場合に使います"}},"pt-BR":{"stringUnit":{"state":"translated","value":"\"Difícil\" é para quando custou lembrar"}},"ru":{"stringUnit":{"state":"translated","value":"«Трудно» — для случаев, когда вспоминать было трудно"}},"es-MX":{"stringUnit":{"state":"translated","value":"\"Difícil\" es para cuando te costó recordar"}},"es-ES":{"stringUnit":{"state":"translated","value":"\"Difícil\" es para cuando te costó recordar"}}}},
    "If you did not know the answer, choose \"Again\". \"Hard\" is only for answers you knew but it was difficult to recall.":{"extractionState":"manual","localizations":{"sw":{"stringUnit":{"state":"translated","value":"Ikiwa hukujua jibu, chagua \"Tena\". \"Ngumu\" ni kwa majibu uliyoyajua lakini ilikuwa vigumu kuyakumbuka."}},"ta":{"stringUnit":{"state":"translated","value":"பதில் தெரியவில்லை என்றால் \"மீண்டும்\" என்பதைத் தேர்ந்தெடுக்கவும். பதில் தெரிந்தும் நினைவுகூரக் கடினமாக இருந்தால் மட்டுமே \"கடினம்\" என்பதைத் தேர்ந்தெடுக்கவும்."}},"te":{"stringUnit":{"state":"translated","value":"మీకు సమాధానం తెలియకపోతే \"మళ్లీ\" ఎంచుకోండి. సమాధానం తెలిసి కూడా గుర్తుకు తెచ్చుకోవడం కష్టమైనప్పుడే \"కష్టం\" ఎంచుకోండి."}},"sk":{"stringUnit":{"state":"translated","value":"Ak ste odpoveď nevedeli, vyberte „Znova“. „Ťažké“ je iba pre odpovede, ktoré ste vedeli, ale bolo ťažké si ich vybaviť."}},"sl":{"stringUnit":{"state":"translated","value":"Če odgovora niste vedeli, izberite »Znova«. »Težko« je le za odgovore, ki ste jih vedeli, a ste jih težko priklicali."}},"sv":{"stringUnit":{"state":"translated","value":"Om du inte kunde svaret väljer du ”Igen”. ”Svårt” är bara för svar som du kunde men hade svårt att minnas."}},"pa":{"stringUnit":{"state":"translated","value":"ਜੇ ਤੁਹਾਨੂੰ ਜਵਾਬ ਨਹੀਂ ਪਤਾ ਸੀ ਤਾਂ \"ਦੁਬਾਰਾ\" ਚੁਣੋ। \"ਔਖਾ\" ਸਿਰਫ਼ ਉਹਨਾਂ ਜਵਾਬਾਂ ਲਈ ਹੈ ਜੋ ਪਤਾ ਸਨ ਪਰ ਯਾਦ ਕਰਨਾ ਮੁਸ਼ਕਲ ਸੀ।"}},"pl":{"stringUnit":{"state":"translated","value":"Jeśli nie znasz odpowiedzi, wybierz „Jeszcze raz”. „Trudne” dotyczy tylko odpowiedzi, które znasz, ale trudno było je sobie przypomnieć."}},"ro":{"stringUnit":{"state":"translated","value":"Dacă nu știai răspunsul, alege „Din nou”. „Greu” este doar pentru răspunsurile pe care le știai, dar ți le-ai amintit cu dificultate."}},"mr":{"stringUnit":{"state":"translated","value":"उत्तर माहीत नसेल तर “पुन्हा” निवडा. “कठीण” हे फक्त उत्तर माहीत होते, पण आठवणे अवघड गेले अशा वेळी वापरा."}},"nb":{"stringUnit":{"state":"translated","value":"Velg «Igjen» hvis du ikke visste svaret. «Vanskelig» er bare for svar du visste, men som var vanskelige å huske."}},"nl":{"stringUnit":{"state":"translated","value":"Kies ‘Opnieuw’ als je het antwoord niet wist. ‘Moeilijk’ is alleen voor antwoorden die je wist, maar moeilijk kon herinneren."}},"lt":{"stringUnit":{"state":"translated","value":"Jei atsakymo nežinojote, rinkitės „Dar kartą“. „Sunku“ skirta tik atsakymams, kuriuos žinojote, bet buvo sunku prisiminti."}},"lv":{"stringUnit":{"state":"translated","value":"Ja atbildi nezinājāt, izvēlieties “Vēlreiz”. “Grūti” ir tikai atbildēm, kuras zinājāt, bet bija grūti atcerēties."}},"ml":{"stringUnit":{"state":"translated","value":"ഉത്തരം അറിയില്ലായിരുന്നെങ്കിൽ “വീണ്ടും” തിരഞ്ഞെടുക്കുക. അറിയാമായിരുന്നെങ്കിലും ഓർമ്മിച്ചെടുക്കാൻ ബുദ്ധിമുട്ടിയ ഉത്തരങ്ങൾക്കാണ് “പ്രയാസം”."}},"it":{"stringUnit":{"state":"translated","value":"Se non conoscevi la risposta, scegli \"Di nuovo\". \"Difficile\" è solo per le risposte che conoscevi ma che hai faticato a ricordare."}},"kn":{"stringUnit":{"state":"translated","value":"ಉತ್ತರ ಗೊತ್ತಿಲ್ಲದಿದ್ದರೆ \"ಮತ್ತೆ\" ಆಯ್ಕೆಮಾಡಿ. ಉತ್ತರ ಗೊತ್ತಿದ್ದರೂ ನೆನಪಿಗೆ ತರಲು ಕಷ್ಟವಾದಾಗ ಮಾತ್ರ \"ಕಷ್ಟ\" ಆಯ್ಕೆಮಾಡಿ."}},"ko":{"stringUnit":{"state":"translated","value":"답을 몰랐다면 \"다시\"를 선택하세요. \"어려움\"은 답을 알고 있었지만 떠올리기 힘들었을 때만 선택하세요."}},"hu":{"stringUnit":{"state":"translated","value":"Ha nem tudtad a választ, válaszd az „Újra” lehetőséget. A „Nehéz” csak akkor való, ha tudtad a választ, de nehéz volt felidézni."}},"id":{"stringUnit":{"state":"translated","value":"Jika Anda tidak tahu jawabannya, pilih \"Ulangi\". \"Sulit\" hanya untuk jawaban yang Anda tahu tetapi sulit diingat."}},"is":{"stringUnit":{"state":"translated","value":"Ef þú vissir ekki svarið skaltu velja „Aftur“. „Erfitt“ er aðeins fyrir svör sem þú vissir en áttir erfitt með að rifja upp."}},"gu":{"stringUnit":{"state":"translated","value":"જો જવાબ ખબર ન હતો, તો \"ફરી\" પસંદ કરો. \"મુશ્કેલ\" ફક્ત એવા જવાબ માટે છે જે તમને ખબર હતો પણ યાદ કરવામાં મુશ્કેલી પડી."}},"he":{"stringUnit":{"state":"translated","value":"אם התשובה לא הייתה ידועה לך, יש לבחור \"שוב\". \"קשה\" מיועד רק לתשובות שהיו ידועות לך אבל היה קשה להיזכר בהן."}},"hr":{"stringUnit":{"state":"translated","value":"Ako niste znali odgovor, odaberite \"Ponovno\". \"Teško\" je samo za odgovore koje ste znali, ali ih se bilo teško prisjetiti."}},"et":{"stringUnit":{"state":"translated","value":"Kui sa vastust ei teadnud, vali „Uuesti”. „Raske” on ainult vastustele, mida teadsid, kuid mida oli raske meenutada."}},"fa":{"stringUnit":{"state":"translated","value":"اگر پاسخ را نمی‌دانستید، «دوباره» را انتخاب کنید. «سخت» فقط برای پاسخ‌هایی است که می‌دانستید اما یادآوری‌شان دشوار بود."}},"fi":{"stringUnit":{"state":"translated","value":"Jos et tiennyt vastausta, valitse ”Uudelleen”. ”Vaikea” on vain vastauksille, jotka tiesit mutta joita oli vaikea muistaa."}},"cs":{"stringUnit":{"state":"translated","value":"Pokud jste odpověď neznali, zvolte „Znovu“. „Těžké“ je pouze pro odpovědi, které jste znali, ale obtížně si je vybavovali."}},"da":{"stringUnit":{"state":"translated","value":"Hvis du ikke kendte svaret, skal du vælge \"Igen\". \"Svært\" er kun til svar, du kendte, men havde svært ved at huske."}},"el":{"stringUnit":{"state":"translated","value":"Αν δεν γνωρίζατε την απάντηση, επιλέξτε «Ξανά». Το «Δύσκολο» είναι μόνο για απαντήσεις που γνωρίζατε αλλά δυσκολευτήκατε να θυμηθείτε."}},"bg":{"stringUnit":{"state":"translated","value":"Ако не сте знаели отговора, изберете „Отново“. „Трудно“ е само за отговори, които сте знаели, но ви е било трудно да си спомните."}},"bn":{"stringUnit":{"state":"translated","value":"উত্তর না জানলে আবার বেছে নিন। উত্তর জানা ছিল, কিন্তু মনে করতে কষ্ট হয়েছে—শুধু সে ক্ষেত্রেই কঠিন বেছে নিন।"}},"ca":{"stringUnit":{"state":"translated","value":"Si no sabies la resposta, tria «Un altre cop». «Difícil» només és per a respostes que sabies però que t’ha costat recordar."}},"en":{"stringUnit":{"state":"translated","value":"If you did not know the answer, choose \"Again\". \"Hard\" is only for answers you knew but it was difficult to recall."}},"ar":{"stringUnit":{"state":"translated","value":"إذا لم تكن تعرف الإجابة، فاختر \"مرة أخرى\". يُستخدم \"صعب\" فقط للإجابات التي عرفتها لكن كان تذكرها صعبًا."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"如果你不知道答案，请选择“重来”。“困难”仅适用于你知道答案但回忆起来很吃力的情况。"}},"de":{"stringUnit":{"state":"translated","value":"Wenn du die Antwort nicht wusstest, wähle \"Nochmal\". \"Schwer\" ist nur für Antworten gedacht, die du wusstest, aber nur schwer abrufen konntest."}},"fr":{"stringUnit":{"state":"translated","value":"Si vous ne connaissiez pas la réponse, choisissez « À revoir ». « Difficile » est réservé aux réponses que vous connaissiez mais que vous avez eu du mal à retrouver."}},"hi":{"stringUnit":{"state":"translated","value":"अगर आपको उत्तर नहीं पता था, तो \"फिर से\" चुनें। \"कठिन\" केवल उन उत्तरों के लिए है जिन्हें आप जानते थे, लेकिन याद करना मुश्किल था।"}},"ja":{"stringUnit":{"state":"translated","value":"答えがわからなかった場合は「もう一度」を選んでください。「難しい」は、答えは知っていたものの思い出すのに苦労した場合にのみ使います。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Se você não sabia a resposta, escolha \"De novo\". \"Difícil\" é só para respostas que você sabia, mas custou lembrar."}},"ru":{"stringUnit":{"state":"translated","value":"Если вы не знали ответ, выберите «Снова». «Трудно» подходит только для ответов, которые вы знали, но их было трудно вспомнить."}},"es-MX":{"stringUnit":{"state":"translated","value":"Si no sabías la respuesta, elige \"Otra vez\". \"Difícil\" es solo para respuestas que sí sabías pero te costó recordarlas."}},"es-ES":{"stringUnit":{"state":"translated","value":"Si no sabías la respuesta, elige \"Otra vez\". \"Difícil\" es solo para respuestas que sí sabías pero te costó recordarla."}}}},
