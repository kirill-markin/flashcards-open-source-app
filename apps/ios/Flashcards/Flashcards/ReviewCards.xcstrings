    "Cards are the prompts and answers you review to learn and remember.":{"extractionState":"manual","localizations":{"et":{"stringUnit":{"state":"translated","value":"Kaardid on küsimused ja vastused, mida kordad õppimiseks ja meeldejätmiseks."}},"fa":{"stringUnit":{"state":"translated","value":"کارت‌ها پرسش‌ها و پاسخ‌هایی هستند که برای یادگیری و به‌خاطرسپاری مرور می‌کنید."}},"fi":{"stringUnit":{"state":"translated","value":"Kortit ovat kysymyksiä ja vastauksia, joita kertaat oppiaksesi ja muistaaksesi."}},"cs":{"stringUnit":{"state":"translated","value":"Kartičky obsahují otázky a odpovědi, které si opakujete, abyste se je naučili a zapamatovali."}},"da":{"stringUnit":{"state":"translated","value":"Kort indeholder spørgsmål og svar, som du repeterer for at lære og huske."}},"el":{"stringUnit":{"state":"translated","value":"Οι κάρτες περιέχουν ερωτήσεις και απαντήσεις που επαναλαμβάνετε για να μάθετε και να θυμάστε."}},"bg":{"stringUnit":{"state":"translated","value":"Картите съдържат въпроси и отговори, които преговаряте, за да учите и запомняте."}},"bn":{"stringUnit":{"state":"translated","value":"কার্ডে প্রশ্ন ও উত্তর থাকে, যা শেখার ও মনে রাখার জন্য আপনি পুনরালোচনা করেন।"}},"ca":{"stringUnit":{"state":"translated","value":"Les targetes contenen preguntes i respostes que repasses per aprendre i recordar."}},"en":{"stringUnit":{"state":"translated","value":"Cards are the prompts and answers you review to learn and remember."}},"ar":{"stringUnit":{"state":"translated","value":"البطاقات هي الأسئلة والأجوبة التي تراجعها للتعلم والتذكر."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"卡片是你为了学习和记忆而复习的提示与答案。"}},"de":{"stringUnit":{"state":"translated","value":"Karten sind die Fragen und Antworten, die du wiederholst, um zu lernen und dich zu erinnern."}},"fr":{"stringUnit":{"state":"translated","value":"Les cartes sont les questions et les réponses que vous révisez pour apprendre et mémoriser."}},"hi":{"stringUnit":{"state":"translated","value":"कार्ड वे संकेत और उत्तर हैं जिन्हें आप सीखने और याद रखने के लिए दोहराते हैं।"}},"ja":{"stringUnit":{"state":"translated","value":"カードは、学習して記憶に定着させるために復習する問題と答えです。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Os cartões são as perguntas e respostas que você revisa para aprender e lembrar."}},"ru":{"stringUnit":{"state":"translated","value":"Карточки — это вопросы и ответы, которые вы повторяете, чтобы учиться и запоминать."}},"es-MX":{"stringUnit":{"state":"translated","value":"Las tarjetas son las preguntas y respuestas que repasas para aprender y recordar."}},"es-ES":{"stringUnit":{"state":"translated","value":"Las tarjetas son las preguntas y respuestas que repasas para aprender y recordar."}}}},
    "Cards couldn't load. Try again.":{"extractionState":"manual","localizations":{"et":{"stringUnit":{"state":"translated","value":"Kaarte ei saanud laadida. Proovi uuesti."}},"fa":{"stringUnit":{"state":"translated","value":"بارگیری کارت‌ها ممکن نشد. دوباره امتحان کنید."}},"fi":{"stringUnit":{"state":"translated","value":"Kortteja ei voitu ladata. Yritä uudelleen."}},"cs":{"stringUnit":{"state":"translated","value":"Kartičky se nepodařilo načíst. Zkuste to znovu."}},"da":{"stringUnit":{"state":"translated","value":"Kortene kunne ikke indlæses. Prøv igen."}},"el":{"stringUnit":{"state":"translated","value":"Δεν ήταν δυνατή η φόρτωση των καρτών. Δοκιμάστε ξανά."}},"bg":{"stringUnit":{"state":"translated","value":"Картите не можаха да се заредят. Опитайте отново."}},"bn":{"stringUnit":{"state":"translated","value":"কার্ড লোড করা যায়নি। আবার চেষ্টা করুন"}},"ca":{"stringUnit":{"state":"translated","value":"No s'han pogut carregar les targetes. Torna-ho a provar."}},"en":{"stringUnit":{"state":"translated","value":"Cards couldn't load. Try again."}},"ar":{"stringUnit":{"state":"translated","value":"تعذر تحميل البطاقات. حاول مرة أخرى."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"无法加载卡片。请重试。"}},"de":{"stringUnit":{"state":"translated","value":"Karten konnten nicht geladen werden. Versuche es erneut."}},"fr":{"stringUnit":{"state":"translated","value":"Impossible de charger les cartes. Réessayez."}},"hi":{"stringUnit":{"state":"translated","value":"कार्ड लोड नहीं हो सके। फिर से कोशिश करें।"}},"ja":{"stringUnit":{"state":"translated","value":"カードを読み込めませんでした。もう一度お試しください。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Não foi possível carregar os cartões. Tente novamente."}},"ru":{"stringUnit":{"state":"translated","value":"Не удалось загрузить карточки. Попробуйте снова."}},"es-MX":{"stringUnit":{"state":"translated","value":"No se pudieron cargar las tarjetas. Inténtalo de nuevo."}},"es-ES":{"stringUnit":{"state":"translated","value":"No se pudieron cargar las tarjetas. Inténtalo de nuevo."}}}},
