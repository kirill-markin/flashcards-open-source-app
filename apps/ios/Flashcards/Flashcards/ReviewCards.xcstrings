    "Selected photo couldn't be read. Choose a different image.":{"extractionState":"manual","localizations":{"sw":{"stringUnit":{"state":"translated","value":"Picha iliyochaguliwa haikuweza kusomwa. Chagua picha nyingine."}},"ta":{"stringUnit":{"state":"translated","value":"தேர்ந்தெடுத்த புகைப்படத்தைப் படிக்க முடியவில்லை. வேறொரு படத்தைத் தேர்ந்தெடுக்கவும்."}},"te":{"stringUnit":{"state":"translated","value":"ఎంచుకున్న ఫొటోను చదవలేకపోయాము. మరో చిత్రాన్ని ఎంచుకోండి."}},"sk":{"stringUnit":{"state":"translated","value":"Vybranú fotku sa nepodarilo prečítať. Vyberte iný obrázok."}},"sl":{"stringUnit":{"state":"translated","value":"Izbrane fotografije ni bilo mogoče prebrati. Izberite drugo sliko."}},"sv":{"stringUnit":{"state":"translated","value":"Den valda bilden kunde inte läsas. Välj en annan bild."}},"pa":{"stringUnit":{"state":"translated","value":"ਚੁਣੀ ਫ਼ੋਟੋ ਪੜ੍ਹੀ ਨਹੀਂ ਜਾ ਸਕੀ। ਹੋਰ ਚਿੱਤਰ ਚੁਣੋ।"}},"pl":{"stringUnit":{"state":"translated","value":"Nie udało się odczytać wybranego zdjęcia. Wybierz inny obraz."}},"ro":{"stringUnit":{"state":"translated","value":"Poza selectată nu a putut fi citită. Alege altă imagine."}},"mr":{"stringUnit":{"state":"translated","value":"निवडलेला फोटो वाचता आला नाही. दुसरी प्रतिमा निवडा."}},"nb":{"stringUnit":{"state":"translated","value":"Kunne ikke lese det valgte bildet. Velg et annet bilde."}},"nl":{"stringUnit":{"state":"translated","value":"De geselecteerde foto kon niet worden gelezen. Kies een andere afbeelding."}},"lt":{"stringUnit":{"state":"translated","value":"Nepavyko perskaityti pasirinktos nuotraukos. Pasirinkite kitą paveikslėlį."}},"lv":{"stringUnit":{"state":"translated","value":"Neizdevās nolasīt izvēlēto fotoattēlu. Izvēlieties citu attēlu."}},"ml":{"stringUnit":{"state":"translated","value":"തിരഞ്ഞെടുത്ത ഫോട്ടോ വായിക്കാനായില്ല. മറ്റൊരു ചിത്രം തിരഞ്ഞെടുക്കുക."}},"it":{"stringUnit":{"state":"translated","value":"Impossibile leggere la foto selezionata. Scegli un’altra immagine."}},"kn":{"stringUnit":{"state":"translated","value":"ಆಯ್ದ ಫೋಟೋ ಓದಲಾಗಲಿಲ್ಲ. ಮತ್ತೊಂದು ಚಿತ್ರ ಆಯ್ಕೆಮಾಡಿ."}},"ko":{"stringUnit":{"state":"translated","value":"선택한 사진을 읽지 못했습니다. 다른 이미지를 선택하세요."}},"hu":{"stringUnit":{"state":"translated","value":"Nem sikerült beolvasni a kiválasztott fotót. Válassz másik képet."}},"id":{"stringUnit":{"state":"translated","value":"Foto yang dipilih tidak dapat dibaca. Pilih gambar lain."}},"is":{"stringUnit":{"state":"translated","value":"Ekki tókst að lesa valda mynd. Veldu aðra mynd."}},"gu":{"stringUnit":{"state":"translated","value":"પસંદ કરેલો ફોટો વાંચી શકાયો નહીં. બીજી છબી પસંદ કરો."}},"he":{"stringUnit":{"state":"translated","value":"לא ניתן לקרוא את התמונה שנבחרה. יש לבחור תמונה אחרת."}},"hr":{"stringUnit":{"state":"translated","value":"Nije moguće pročitati odabranu fotografiju. Odaberite drugu sliku."}},"et":{"stringUnit":{"state":"translated","value":"Valitud fotot ei saanud lugeda. Vali teine pilt."}},"fa":{"stringUnit":{"state":"translated","value":"خواندن عکس انتخاب‌شده ممکن نشد. تصویر دیگری انتخاب کنید."}},"fi":{"stringUnit":{"state":"translated","value":"Valittua kuvaa ei voitu lukea. Valitse toinen kuva."}},"cs":{"stringUnit":{"state":"translated","value":"Vybranou fotku se nepodařilo přečíst. Vyberte jiný obrázek."}},"da":{"stringUnit":{"state":"translated","value":"Det valgte foto kunne ikke læses. Vælg et andet billede."}},"el":{"stringUnit":{"state":"translated","value":"Δεν ήταν δυνατή η ανάγνωση της επιλεγμένης φωτογραφίας. Επιλέξτε άλλη εικόνα."}},"bg":{"stringUnit":{"state":"translated","value":"Избраната снимка не можа да бъде прочетена. Изберете различно изображение."}},"bn":{"stringUnit":{"state":"translated","value":"নির্বাচিত ফটো পড়া যাবে না। একটি ভিন্ন ইমেজ চয়ন করুন।"}},"ca":{"stringUnit":{"state":"translated","value":"No s'ha pogut llegir la foto seleccionada. Trieu una imatge diferent."}},"en":{"stringUnit":{"state":"translated","value":"Selected photo couldn't be read. Choose a different image."}},"ar":{"stringUnit":{"state":"translated","val