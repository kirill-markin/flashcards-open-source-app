    "Delete this card?":{"extractionState":"manual","localizations":{"et":{"stringUnit":{"state":"translated","value":"Kas kustutada see kaart?"}},"fa":{"stringUnit":{"state":"translated","value":"این کارت حذف شود؟"}},"fi":{"stringUnit":{"state":"translated","value":"Poistetaanko tämä kortti?"}},"cs":{"stringUnit":{"state":"translated","value":"Smazat tuto kartičku?"}},"da":{"stringUnit":{"state":"translated","value":"Slet dette kort?"}},"el":{"stringUnit":{"state":"translated","value":"Να διαγραφεί αυτή η κάρτα;"}},"bg":{"stringUnit":{"state":"translated","value":"Изтриване на тази карта?"}},"bn":{"stringUnit":{"state":"translated","value":"এই কার্ডটি মুছবেন?"}},"ca":{"stringUnit":{"state":"translated","value":"Vols suprimir aquesta targeta?"}},"en":{"stringUnit":{"state":"translated","value":"Delete this card?"}},"ar":{"stringUnit":{"state":"translated","value":"هل تريد حذف هذه البطاقة؟"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"删除这张卡片？"}},"de":{"stringUnit":{"state":"translated","value":"Diese Karte löschen?"}},"fr":{"stringUnit":{"state":"translated","value":"Supprimer cette carte ?"}},"hi":{"stringUnit":{"state":"translated","value":"क्या इस कार्ड को हटाना है?"}},"ja":{"stringUnit":{"state":"translated","value":"このカードを削除しますか？"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Excluir este cartão?"}},"ru":{"stringUnit":{"state":"translated","value":"Удалить эту карточку?"}},"es-MX":{"stringUnit":{"state":"translated","value":"¿Eliminar esta tarjeta?"}},"es-ES":{"stringUnit":{"state":"translated","value":"¿Eliminar esta tarjeta?"}}}},
    "Deleting removes this card from the local list and from the next sync.":{"extractionState":"manual","localizations":{"et":{"stringUnit":{"state":"translated","value":"Kustutamine eemaldab selle kaardi kohalikust loendist ja järgmisest sünkroonimisest."}},"fa":{"stringUnit":{"state":"translated","value":"با حذف، این کارت از فهرست محلی و همگام‌سازی بعدی برداشته می‌شود."}},"fi":{"stringUnit":{"state":"translated","value":"Poistaminen poistaa kortin paikallisesta luettelosta ja seuraavasta synkronoinnista."}},"cs":{"stringUnit":{"state":"translated","value":"Smazáním se kartička odstraní z místního seznamu a při příští synchronizaci."}},"da":{"stringUnit":{"state":"translated","value":"Sletning fjerner kortet fra den lokale liste og ved næste synkronisering."}},"el":{"stringUnit":{"state":"translated","value":"Η διαγραφή αφαιρεί την κάρτα από την τοπική λίστα και κατά τον επόμενο συγχρονισμό."}},"bg":{"stringUnit":{"state":"translated","value":"Изтриването премахва тази карта от локалния списък и от следващото синхронизиране."}},"bn":{"stringUnit":{"state":"translated","value":"মুছে ফেলার ফলে এই কার্ডটি স্থানীয় তালিকা থেকে এবং পরবর্তী সিঙ্ক থেকে মুছে যায়।"}},"ca":{"stringUnit":{"state":"translated","value":"Si suprimeixes, s'elimina aquesta targeta de la llista local i de la següent sincronització."}},"en":{"stringUnit":{"state":"translated","value":"Deleting removes this card from the local list and from the next sync."}},"ar":{"stringUnit":{"state":"translated","value":"سيؤدي الحذف إلى إزالة هذه البطاقة من القائمة المحلية ومن المزامنة التالية."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"删除后，这张卡片会从本地列表中移除，并在下次同步时删除。"}},"de":{"stringUnit":{"state":"translated","value":"Durch das Löschen wird diese Karte aus der lokalen Liste und aus der nächsten Synchronisierung entfernt."}},"fr":{"stringUnit":{"state":"translated","value":"La suppression retire cette carte de la liste locale et de la prochaine synchronisation."}},"hi":{"stringUnit":{"state":"translated","value":"हटाने पर यह कार्ड स्थानीय सूची और अगली सिंक, दोनों से हट जाएगा।"}},"ja":{"stringUnit":{"state":"translated","value":"削除すると、このカードはローカル一覧から削除され、次回の同期対象からも外れます。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Ao excluir, este cartão sai da lista local e da próxima sincronização."}},"ru":{"stringUnit":{"state":"translated","value":"При удалении карточка будет убрана из локального списка и из следующей синхронизации."}},"es-MX":{"stringUnit":{"state":"translated","value":"Al eliminarla, esta tarjeta se quita de la lista local y de la próxima sincronización."}},"es-ES":{"stringUnit":{"state":"translated","value":"Al eliminarla, esta tarjeta se quita de la lista local y de la próxima sincronización."}}}},
    "demo_card_back_1":{"comment":"Paragraph on the back of the onboarding demo flashcard. %@ is the never-localized product name, already wrapped in Markdown bold.","extractionState":"manual","localizations":{"et":{"stringUnit":{"state":"translated","value":"%@ — rakendus, mida praegu vaatad. Kõik siin on õpikaart: esiküljel küsimus, tagaküljel vastus."}},"fa":{"stringUnit":{"state":"translated","value":"%@ — همان برنامه‌ای که اکنون می‌بینید. همه‌چیز اینجا یک فلش‌کارت است: پرسش در رو و پاسخ در پشت."}},"fi":{"stringUnit":{"state":"translated","value":"%@ — sovellus, jota katsot juuri nyt. Kaikki täällä on muistikortteja: kysymys etupuolella ja vastaus kääntöpuolella."}},"cs":{"stringUnit":{"state":"translated","value":"%@ — aplikace, na kterou se právě díváte. Všechno je tu kartička: otázka na přední straně, odpověď na zadní."}},"da":{"stringUnit":{"state":"translated","value":"%@ — appen, du kigger på lige nu. Alt her er et læringskort: et spørgsmål på forsiden og svaret på bagsiden."}},"el":{"stringUnit":{"state":"translated","value":"%@ — η εφαρμογή που βλέπετε αυτή τη στιγμή. Όλα εδώ είναι κάρτες: μια ερώτηση στην μπροστινή πλευρά, η απάντηση στην πίσω."}},"bg":{"stringUnit":{"state":"translated","value":"%@ — приложението, което виждате в момента. Всичко тук е учебна карта: въпрос на лицето и отговор на гърба."}},"bn":{"stringUnit":{"state":"translated","value":"%@ — এই মুহূর্তে আপনি যে অ্যাপটি দেখছেন। এখানে সবকিছুই একটি শেখার কার্ড: সামনের দিকে প্রশ্ন, পেছনের দিকে উত্তর।"}},"ca":{"stringUnit":{"state":"translated","value":"%@ — l’app que estàs mirant ara mateix. Aquí tot és una targeta d’estudi: una pregunta a l’anvers i la resposta al revers."}},"en":{"stringUnit":{"state":"translated","value":"%@ — the app you are looking at right now. Everything here is a flashcard: a question on the front, the answer on the back."}},"ar":{"stringUnit":{"state":"translated","value":"%@ — التطبيق الذي تنظر إليه الآن. كل شيء هنا عبارة عن بطاقة: سؤال على الوجه الأمامي وإجابة على الوجه الخلفي."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"%@ —— 你现在正在看的这个应用。这里的一切都是卡片：正面是问题，背面是答案。"}},"de":{"stringUnit":{"state":"translated","value":"%@ — die App, die du gerade vor dir hast. Alles hier ist eine Karte: vorne eine Frage, hinten die Antwort."}},"fr":{"stringUnit":{"state":"translated","value":"%@ — l’application que vous avez sous les yeux en ce moment. Ici, tout est une carte : une question au recto, la réponse au verso."}},"hi":{"stringUnit":{"state":"translated","value":"%@ — वही ऐप जिसे आप अभी देख रहे हैं। यहाँ सब कुछ एक कार्ड है: सामने एक सवाल, पीछे उसका जवाब।"}},"ja":{"stringUnit":{"state":"translated","value":"%@ — 今まさに見ているこのアプリです。ここにあるものはすべてカードです。表に問題、裏に答えがあります。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"%@ — o app que você está vendo agora mesmo. Aqui tudo é um cartão: uma pergunta na frente e a resposta no verso."}},"ru":{"stringUnit":{"state":"translated","value":"%@ — приложение, которое вы видите прямо сейчас. Здесь всё — это карточки: вопрос на лицевой стороне, ответ на обратной."}},"es-MX":{"stringUnit":{"state":"translated","value":"%@ — la aplicación que estás viendo ahora mismo. Todo aquí es una tarjeta: una pregunta en el frente y la respuesta en el reverso."}},"es-ES":{"stringUnit":{"state":"translated","value":"%@ — la aplicación que estás viendo ahora mismo. Todo aquí es una tarjeta: una pregunta en el anverso y la respuesta en el reverso."}}}},
    "demo_card_back_2":{"comment":"Paragraph on the back of the onboarding demo flashcard","extractionState":"manual","localizations":{"et":{"stringUnit":{"state":"translated","value":"Anna sisseehitatud tehisintellekti vestlusele teema ja see loob sulle kaardikomplekti."}},"fa":{"stringUnit":{"state":"translated","value":"به گفت‌وگوی هوش مصنوعی داخلی یک موضوع بدهید تا مجموعه‌ای از کارت‌ها برایتان بسازد."}},"fi":{"stringUnit":{"state":"translated","value":"Anna sisäänrakennetulle tekoälykeskustelulle aihe, niin se luo sinulle korttisarjan."}},"cs":{"stringUnit":{"state":"translated","value":"Zadejte téma do vestavěného chatu s AI a vytvoří vám sadu kartiček."}},"da":{"stringUnit":{"state":"translated","value":"Giv den indbyggede AI-chat et emne, så opretter den et sæt kort til dig."}},"el":{"stringUnit":{"state":"translated","value":"Δώστε ένα θέμα στην ενσωματωμένη συνομιλία με την ΤΝ και θα δημιουργήσει ένα σύνολο καρτών για εσάς."}},"bg":{"stringUnit":{"state":"translated","value":"Задайте тема на вградения чат с ИИ и той ще създаде набор от карти за вас."}},"bn":{"stringUnit":{"state":"translated","value":"অ্যাপের এআই চ্যাটকে একটি বিষয় দিন, আর এটি আপনার জন্য এক সেট কার্ড তৈরি করবে।"}},"ca":{"stringUnit":{"state":"translated","value":"Dona un tema al xat amb IA integrat i et crearà un conjunt de targetes."}},"en":{"stringUnit":{"state":"translated","value":"Give the built-in AI chat a topic and it will create a set of cards for you."}},"ar":{"stringUnit":{"state":"translated","value":"أعطِ محادثة الذكاء الاصطناعي المدمجة موضوعًا، وستنشئ لك مجموعة من البطاقات."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"给内置的 AI 对话一个主题，它就会为你创建一组卡片。"}},"de":{"stringUnit":{"state":"translated","value":"Nenne dem eingebauten KI-Chat ein Thema, und er erstellt dir einen Satz Karten."}},"fr":{"stringUnit":{"state":"translated","value":"Donnez un sujet au chat IA intégré et il créera un ensemble de cartes pour vous."}},"hi":{"stringUnit":{"state":"translated","value":"अंतर्निहित AI चैट को कोई विषय दें और वह आपके लिए कार्ड का एक सेट बना देगा।"}},"ja":{"stringUnit":{"state":"translated","value":"内蔵のAIチャットにテーマを伝えるだけで、カードのセットを作成してくれます。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Dê um tema ao chat com IA integrado e ele vai criar um conjunto de cartões para você."}},"ru":{"stringUnit":{"state":"translated","value":"Назовите тему встроенному ИИ-чату, и он создаст для вас набор карточек."}},"es-MX":{"stringUnit":{"state":"translated","value":"Dale un tema al chat de IA integrado y él creará un conjunto de tarjetas para ti."}},"es-ES":{"stringUnit":{"state":"translated","value":"Dale un tema al chat de IA integrado y creará un conjunto de tarjetas para ti."}}}},
    "demo_card_back_3":{"comment":"Paragraph on the back of the onboarding demo flashcard. %@ is the Again rating label, already wrapped in Markdown inline code, so do not add quotation marks around it.","extractionState":"manual","localizations":{"et":{"stringUnit":{"state":"translated","value":"Proovi kohe: hinda seda kaarti hinnanguga %@ ja see ilmub umbes minuti pärast uuesti — nii jääb see vastus meelde."}},"fa":{"stringUnit":{"state":"translated","value":"همین حالا امتحان کنید: به این کارت امتیاز %@ بدهید تا حدود یک دقیقهٔ دیگر برگردد — تا این پاسخ در ذهن بماند."}},"fi":{"stringUnit":{"state":"translated","value":"Kokeile heti: anna tälle kortille arvio %@, niin se palaa noin minuutin kuluttua — jotta tämä vastaus jää mieleen."}},"cs":{"stringUnit":{"state":"translated","value":"Vyzkoušejte to hned: ohodnoťte tuto kartičku %@ a asi za minutu se vrátí — abyste si odpověď zapamatovali."}},"da":{"stringUnit":{"state":"translated","value":"Prøv nu: bedøm dette kort som %@, så kommer det igen om cirka et minut — så svaret bliver hængende."}},"el":{"stringUnit":{"state":"translated","value":"Δοκιμάστε τώρα: βαθμολογήστε αυτήν την κάρτα με %@ και θα εμφανιστεί ξανά σε περίπου ένα λεπτό — για να σας μείνει η απάντηση."}},"bg":{"stringUnit":{"state":"translated","value":"Опитайте сега: оценете тази карта с %@ и тя ще се появи отново след около минута — за да запомните отговора."}},"bn":{"stringUnit":{"state":"translated","value":"এখনই চেষ্টা করুন: এই কার্ডটিকে %@ দিয়ে মূল্যায়ন করুন। প্রায় এক মিনিট পর এটি আবার আসবে—যাতে উত্তরটি আপনার মনে থাকে।"}},"ca":{"stringUnit":{"state":"translated","value":"Prova-ho ara mateix: valora aquesta targeta amb %@ i tornarà d’aquí a un minut, aproximadament, perquè en recordis la resposta."}},"en":{"stringUnit":{"state":"translated","value":"Try it right now: rate this card %@, and it will come back in about a minute — so this answer sticks."}},"ar":{"stringUnit":{"state":"translated","value":"جرّب ذلك الآن: قيّم هذه البطاقة بـ %@، وستعود بعد دقيقة تقريبًا حتى ترسخ هذه الإجابة."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"现在就试一试：把这张卡片评为%@，它大约一分钟后就会再次出现，好让这个答案记牢。"}},"de":{"stringUnit":{"state":"translated","value":"Probiere es gleich aus: Bewerte diese Karte mit %@, dann kommt sie in etwa einer Minute wieder — damit diese Antwort sitzt."}},"fr":{"stringUnit":{"state":"translated","value":"Essayez tout de suite : évaluez cette carte avec %@, et elle reviendra dans une minute environ — pour que cette réponse s’ancre."}},"hi":{"stringUnit":{"state":"translated","value":"अभी आज़माएं: इस कार्ड को %@ दें, और यह करीब एक मिनट में फिर आ जाएगा — ताकि यह जवाब पक्का याद रह जाए।"}},"ja":{"stringUnit":{"state":"translated","value":"今すぐ試してみましょう。このカードを%@と評価すると、約1分後にもう一度出てきます。こうしてこの答えが定着します。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Experimente agora mesmo: avalie este cartão como %@ e ele vai voltar em cerca de um minuto — assim esta resposta fixa."}},"ru":{"stringUnit":{"state":"translated","value":"Попробуйте прямо сейчас: оцените эту карточку как %@, и она вернётся примерно через минуту — чтобы этот ответ закрепился."}},"es-MX":{"stringUnit":{"state":"translated","value":"Pruébalo ahora mismo: califica esta tarjeta como %@ y volverá en aproximadamente un minuto, para que esta respuesta se te quede."}},"es-ES":{"stringUnit":{"state":"translated","value":"Pruébalo ahora mismo: valora esta tarjeta como %@ y volverá en aproximadamente un minuto, para que esta respuesta se te quede."}}}},
    "demo_card_front":{"comment":"Front of the onboarding demo flashcard","extractionState":"manual","localizations":{"et":{"stringUnit":{"state":"translated","value":"Milline on parim rakendus õppimiseks?"}},"fa":{"stringUnit":{"state":"translated","value":"بهترین برنامه برای مطالعه چیست؟"}},"fi":{"stringUnit":{"state":"translated","value":"Mikä on paras sovellus opiskeluun?"}},"cs":{"stringUnit":{"state":"translated","value":"Jaká je nejlepší aplikace pro učení?"}},"da":{"stringUnit":{"state":"translated","value":"Hvilken app er bedst til at lære med?"}},"el":{"stringUnit":{"state":"translated","value":"Ποια είναι η καλύτερη εφαρμογή για μελέτη;"}},"bg":{"stringUnit":{"state":"translated","value":"Кое е най-доброто приложение за учене?"}},"bn":{"stringUnit":{"state":"translated","value":"পড়াশোনার জন্য সেরা অ্যাপ কোনটি?"}},"ca":{"stringUnit":{"state":"translated","value":"Quina és la millor aplicació per estudiar?"}},"en":{"stringUnit":{"state":"translated","value":"What is the best application for studying?"}},"ar":{"stringUnit":{"state":"translated","value":"ما هو أفضل تطبيق للدراسة؟"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"学习用的最好的应用是什么？"}},"de":{"stringUnit":{"state":"translated","value":"Was ist die beste App zum Lernen?"}},"fr":{"stringUnit":{"state":"translated","value":"Quelle est la meilleure application pour étudier ?"}},"hi":{"stringUnit":{"state":"translated","value":"पढ़ाई के लिए सबसे अच्छा ऐप कौन सा है?"}},"ja":{"stringUnit":{"state":"translated","value":"勉強に最適なアプリは何ですか？"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Qual é o melhor aplicativo para estudar?"}},"ru":{"stringUnit":{"state":"translated","value":"Какое приложение лучше всего подходит для учебы?"}},"es-MX":{"stringUnit":{"state":"translated","value":"¿Cuál es la mejor aplicación para estudiar?"}},"es-ES":{"stringUnit":{"state":"translated","value":"¿Cuál es la mejor aplicación para estudiar?"}}}},
    "Done":{"extractionState":"manual","localizations":{"et":{"stringUnit":{"state":"translated","value":"Valmis"}},"fa":{"stringUnit":{"state":"translated","value":"انجام شد"}},"fi":{"stringUnit":{"state":"translated","value":"Valmis"}},"cs":{"stringUnit":{"state":"translated","value":"Hotovo"}},"da":{"stringUnit":{"state":"translated","value":"Færdig"}},"el":{"stringUnit":{"state":"translated","value":"Τέλος"}},"bg":{"stringUnit":{"state":"translated","value":"Готово"}},"bn":{"stringUnit":{"state":"translated","value":"হয়েছে"}},"ca":{"stringUnit":{"state":"translated","value":"Fet"}},"en":{"stringUnit":{"state":"translated","value":"Done"}},"ar":{"stringUnit":{"state":"translated","value":"تم"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"完成"}},"de":{"stringUnit":{"state":"translated","value":"Fertig"}},"fr":{"stringUnit":{"state":"translated","value":"OK"}},"hi":{"stringUnit":{"state":"translated","value":"हो गया"}},"ja":{"stringUnit":{"state":"translated","value":"完了"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Concluído"}},"ru":{"stringUnit":{"state":"translated","value":"Готово"}},"es-MX":{"stringUnit":{"state":"translated","value":"Listo"}},"es-ES":{"stringUnit":{"state":"translated","value":"Listo"}}}},
    "Due":{"extractionState":"manual","localizations":{"et":{"stringUnit":{"state":"translated","value":"Kordamiseks valmis"}},"fa":{"stringUnit":{"state":"translated","value":"موعد مرور"}},"fi":{"stringUnit":{"state":"translated","value":"Erääntyneet"}},"cs":{"stringUnit":{"state":"translated","value":"K opakování"}},"da":{"stringUnit":{"state":"translated","value":"Klar til repetition"}},"el":{"stringUnit":{"state":"translated","value":"Προς επανάληψη"}},"bg":{"stringUnit":{"state":"translated","value":"За преговор"}},"bn":{"stringUnit":{"state":"translated","value":"পুনরালোচনার সময় হয়েছে"}},"ca":{"stringUnit":{"state":"translated","value":"Pendents"}},"en":{"stringUnit":{"state":"translated","value":"Due"}},"ar":{"stringUnit":{"state":"translated","value":"مستحقة"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"到期"}},"de":{"stringUnit":{"state":"translated","value":"Fällig"}},"fr":{"stringUnit":{"state":"translated","value":"Échéance"}},"hi":{"stringUnit":{"state":"translated","value":"देय"}},"ja":{"stringUnit":{"state":"translated","value":"期限"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Vence"}},"ru":{"stringUnit":{"state":"translated","value":"Срок"}},"es-MX":{"stringUnit":{"state":"translated","value":"Vence"}},"es-ES":{"stringUnit":{"state":"translated","value":"Vence"}}}},
