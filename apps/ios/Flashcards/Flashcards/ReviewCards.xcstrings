":{"state":"translated","value":"Més tard"}},"en":{"stringUnit":{"state":"translated","value":"Later"}},"ar":{"stringUnit":{"state":"translated","value":"لاحقًا"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"稍后"}},"de":{"stringUnit":{"state":"translated","value":"Später"}},"fr":{"stringUnit":{"state":"translated","value":"Plus tard"}},"hi":{"stringUnit":{"state":"translated","value":"बाद में"}},"ja":{"stringUnit":{"state":"translated","value":"後で"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Depois"}},"ru":{"stringUnit":{"state":"translated","value":"Позже"}},"es-MX":{"stringUnit":{"state":"translated","value":"Más tarde"}},"es-ES":{"stringUnit":{"state":"translated","value":"Más tarde"}}}},
