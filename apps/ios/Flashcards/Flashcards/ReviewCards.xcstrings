    "Delete this card?":{"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Delete this card?"}},"ar":{"stringUnit":{"state":"translated","value":"هل تريد حذف هذه البطاقة؟"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"删除这张卡片？"}},"de":{"stringUnit":{"state":"translated","value":"Diese Karte löschen?"}},"fr":{"stringUnit":{"state":"translated","value":"Supprimer cette carte ?"}},"hi":{"stringUnit":{"state":"translated","value":"क्या इस कार्ड को हटाना है?"}},"ja":{"stringUnit":{"state":"translated","value":"このカードを削除しますか？"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Excluir este cartão?"}},"ru":{"stringUnit":{"state":"translated","value":"Удалить эту карточку?"}},"es-MX":{"stringUnit":{"state":"translated","value":"¿Eliminar esta tarjeta?"}},"es-ES":{"stringUnit":{"state":"translated","value":"¿Eliminar esta tarjeta?"}}}},
    "Deleting removes this card from the local list and from the next sync.":{"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Deleting removes this card from the local list and from the next sync."}},"ar":{"stringUnit":{"state":"translated","value":"سيؤدي الحذف إلى إزالة هذه البطاقة من القائمة المحلية ومن المزامنة التالية."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"删除后，这张卡片会从本地列表中移除，并在下次同步时删除。"}},"de":{"stringUnit":{"state":"translated","value":"Durch das Löschen wird diese Karte aus der lokalen Liste und aus der nächsten Synchronisierung entfernt."}},"fr":{"stringUnit":{"state":"translated","value":"La suppression retire cette carte de la liste locale et de la prochaine synchronisation."}},"hi":{"stringUnit":{"state":"translated","value":"हटाने पर यह कार्ड स्थानीय सूची और अगली सिंक, दोनों से हट जाएगा।"}},"ja":{"stringUnit":{"state":"translated","value":"削除すると、このカードはローカル一覧から削除され、次回の同期対象からも外れます。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Ao excluir, este cartão sai da lista local e da próxima sincronização."}},"ru":{"stringUnit":{"state":"translated","value":"При удалении карточка будет убрана из локального списка и из следующей синхронизации."}},"es-MX":{"stringUnit":{"state":"translated","value":"Al eliminarla, esta tarjeta se quita de la lista local y de la próxima sincronización."}},"es-ES":{"stringUnit":{"state":"translated","value":"Al eliminarla, esta tarjeta se quita de la lista local y de la próxima sincronización."}}}},
    "demo_card_back_1":{"comment":"Paragraph on the back of the onboarding demo flashcard. %@ is the never-localized product name, already wrapped in Markdown bold.","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"%@ — the app you are looking at right now. Everything here is a flashcard: a question on the front, the answer on the back."}},"ar":{"stringUnit":{"state":"translated","value":"%@ — التطبيق الذي تنظر إليه الآن. كل شيء هنا عبارة عن بطاقة: سؤال على الوجه الأمامي وإجابة على الوجه الخلفي."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"%@ —— 你现在正在看的这个应用。这里的一切都是卡片：正面是问题，背面是答案。"}},"de":{"stringUnit":{"state":"translated","value":"%@ — die App, die du gerade vor dir hast. Alles hier ist eine Karte: vorne eine Frage, hinten die Antwort."}},"fr":{"stringUnit":{"state":"translated","value":"%@ — l’application que vous avez sous les yeux en ce moment. Ici, tout est une carte : une question au recto, la réponse au verso."}},"hi":{"stringUnit":{"state":"translated","value":"%@ — वही ऐप जिसे आप अभी देख रहे हैं। यहाँ सब कुछ एक कार्ड है: सामने एक सवाल, पीछे उसका जवाब।"}},"ja":{"stringUnit":{"state":"translated","value":"%@ — 今まさに見ているこのアプリです。ここにあるものはすべてカードです。表に問題、裏に答えがあります。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"%@ — o app que você está vendo agora mesmo. Aqui tudo é um cartão: uma pergunta na frente e a resposta no verso."}},"ru":{"stringUnit":{"state":"translated","value":"%@ — приложение, которое вы видите прямо сейчас. Здесь всё — это карточки: вопрос на лицевой стороне, ответ на обратной."}},"es-MX":{"stringUnit":{"state":"translated","value":"%@ — la aplicación que estás viendo ahora mismo. Todo aquí es una tarjeta: una pregunta en el frente y la respuesta en el reverso."}},"es-ES":{"stringUnit":{"state":"translated","value":"%@ — la aplicación que estás viendo ahora mismo. Todo aquí es una tarjeta: una pregunta en el anverso y la respuesta en el reverso."}}}},
    "demo_card_back_2":{"comment":"Paragraph on the back of the onboarding demo flashcard","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Give the built-in AI chat a topic and it will create a set of cards for you."}},"ar":{"stringUnit":{"state":"translated","value":"أعطِ محادثة الذكاء الاصطناعي المدمجة موضوعًا، وستنشئ لك مجموعة من البطاقات."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"给内置的 AI 对话一个主题，它就会为你创建一组卡片。"}},"de":{"stringUnit":{"state":"translated","value":"Nenne dem eingebauten KI-Chat ein Thema, und er erstellt dir einen Satz Karten."}},"fr":{"stringUnit":{"state":"translated","value":"Donnez un sujet au chat IA intégré et il créera un ensemble de cartes pour vous."}},"hi":{"stringUnit":{"state":"translated","value":"अंतर्निहित AI चैट को कोई विषय दें और वह आपके लिए कार्ड का एक सेट बना देगा।"}},"ja":{"stringUnit":{"state":"translated","value":"内蔵のAIチャットにテーマを伝えるだけで、カードのセットを作成してくれます。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Dê um tema ao chat com IA integrado e ele vai criar um conjunto de cartões para você."}},"ru":{"stringUnit":{"state":"translated","value":"Назовите тему встроенному ИИ-чату, и он создаст для вас набор карточек."}},"es-MX":{"stringUnit":{"state":"translated","value":"Dale un tema al chat de IA integrado y él creará un conjunto de tarjetas para ti."}},"es-ES":{"stringUnit":{"state":"translated","value":"Dale un tema al chat de IA integrado y creará un conjunto de tarjetas para ti."}}}},
    "demo_card_back_3":{"comment":"Paragraph on the back of the onboarding demo flashcard. %@ is the Again rating label, already wrapped in Markdown inline code, so do not add quotation marks around it.","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Try it right now: rate this card %@, and it will come back in about a minute — so this answer sticks."}},"ar":{"stringUnit":{"state":"translated","value":"جرّب ذلك الآن: قيّم هذه البطاقة بـ %@، وستعود بعد دقيقة تقريبًا حتى ترسخ هذه الإجابة."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"现在就试一试：把这张卡片评为%@，它大约一分钟后就会再次出现，好让这个答案记牢。"}},"de":{"stringUnit":{"state":"translated","value":"Probiere es gleich aus: Bewerte diese Karte mit %@, dann kommt sie in etwa einer Minute wieder — damit diese Antwort sitzt."}},"fr":{"stringUnit":{"state":"translated","value":"Essayez tout de suite : évaluez cette carte avec %@, et elle reviendra dans une minute environ — pour que cette réponse s’ancre."}},"hi":{"stringUnit":{"state":"translated","value":"अभी आज़माएं: इस कार्ड को %@ दें, और यह करीब एक मिनट में फिर आ जाएगा — ताकि यह जवाब पक्का याद रह जाए।"}},"ja":{"stringUnit":{"state":"translated","value":"今すぐ試してみましょう。このカードを%@と評価すると、約1分後にもう一度出てきます。こうしてこの答えが定着します。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Experimente agora mesmo: avalie este cartão como %@ e ele vai voltar em cerca de um minuto — assim esta resposta fixa."}},"ru":{"stringUnit":{"state":"translated","value":"Попробуйте прямо сейчас: оцените эту карточку как %@, и она вернётся примерно через минуту — чтобы этот ответ закрепился."}},"es-MX":{"stringUnit":{"state":"translated","value":"Pruébalo ahora mismo: califica esta tarjeta como %@ y volverá en aproximadamente un minuto, para que esta respuesta se te quede."}},"es-ES":{"stringUnit":{"state":"translated","value":"Pruébalo ahora mismo: valora esta tarjeta como %@ y volverá en aproximadamente un minuto, para que esta respuesta se te quede."}}}},
    "demo_card_front":{"comment":"Front of the onboarding demo flashcard","extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"What is the best application for studying?"}},"ar":{"stringUnit":{"state":"translated","value":"ما هو أفضل تطبيق للدراسة؟"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"学习用的最好的应用是什么？"}},"de":{"stringUnit":{"state":"translated","value":"Was ist die beste App zum Lernen?"}},"fr":{"stringUnit":{"state":"translated","value":"Quelle est la meilleure application pour étudier ?"}},"hi":{"stringUnit":{"state":"translated","value":"पढ़ाई के लिए सबसे अच्छा ऐप कौन सा है?"}},"ja":{"stringUnit":{"state":"translated","value":"勉強に最適なアプリは何ですか？"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Qual é o melhor aplicativo para estudar?"}},"ru":{"stringUnit":{"state":"translated","value":"Какое приложение лучше всего подходит для учебы?"}},"es-MX":{"stringUnit":{"state":"translated","value":"¿Cuál es la mejor aplicación para estudiar?"}},"es-ES":{"stringUnit":{"state":"translated","value":"¿Cuál es la mejor aplicación para estudiar?"}}}},
