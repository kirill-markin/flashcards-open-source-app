    "Effort: %@":{"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Effort: %@"}},"ar":{"stringUnit":{"state":"translated","value":"الجهد: %@"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"投入程度：%@"}},"de":{"stringUnit":{"state":"translated","value":"Aufwand: %@"}},"fr":{"stringUnit":{"state":"translated","value":"Effort : %@"}},"hi":{"stringUnit":{"state":"translated","value":"प्रयास: %@"}},"ja":{"stringUnit":{"state":"translated","value":"手間: %@"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Esforço: %@"}},"ru":{"stringUnit":{"state":"translated","value":"Усилие: %@"}},"es-MX":{"stringUnit":{"state":"translated","value":"Esfuerzo: %@"}},"es-ES":{"stringUnit":{"state":"translated","value":"Esfuerzo: %@"}}}},
    "Fast":{"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Fast"}},"ar":{"stringUnit":{"state":"translated","value":"سريع"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"快速"}},"de":{"stringUnit":{"state":"translated","value":"Schnell"}},"fr":{"stringUnit":{"state":"translated","value":"Rapide"}},"hi":{"stringUnit":{"state":"translated","value":"तेज़"}},"ja":{"stringUnit":{"state":"translated","value":"速い"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Rápido"}},"ru":{"stringUnit":{"state":"translated","value":"Быстро"}},"es-MX":{"stringUnit":{"state":"translated","value":"Rápido"}},"es-ES":{"stringUnit":{"state":"translated","value":"Rápido"}}}},
    "Filter cards":{"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Filter cards"}},"ar":{"stringUnit":{"state":"translated","value":"تصفية البطاقات"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"筛选卡片"}},"de":{"stringUnit":{"state":"translated","value":"Karten filtern"}},"fr":{"stringUnit":{"state":"translated","value":"Filtrer les cartes"}},"hi":{"stringUnit":{"state":"translated","value":"कार्ड फ़िल्टर करें"}},"ja":{"stringUnit":{"state":"translated","value":"カードを絞り込む"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Filtrar cartões"}},"ru":{"stringUnit":{"state":"translated","value":"Фильтровать карточки"}},"es-MX":{"stringUnit":{"state":"translated","value":"Filtrar tarjetas"}},"es-ES":{"stringUnit":{"state":"translated","value":"Filtrar tarjetas"}}}},
    "Filter cards (%@ active)":{"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Filter cards (%@ active)"}},"ar":{"stringUnit":{"state":"translated","value":"تصفية البطاقات (%@ نشطة)"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"筛选卡片（%@ 个启用）"}},"de":{"stringUnit":{"state":"translated","value":"Karten filtern (%@ aktiv)"}},"fr":{"stringUnit":{"state":"translated","value":"Filtrer les cartes (%@ actifs)"}},"hi":{"stringUnit":{"state":"translated","value":"कार्ड फ़िल्टर करें (%@ सक्रिय)"}},"ja":{"stringUnit":{"state":"translated","value":"カードを絞り込む（%@ 件有効）"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Filtrar cartões (%@ ativos)"}},"ru":{"stringUnit":{"state":"translated","value":"Фильтровать карточки (%@ активно)"}},"es-MX":{"stringUnit":{"state":"translated","value":"Filtrar tarjetas (%@ filtros activos)"}},"es-ES":{"stringUnit":{"state":"translated","value":"Filtrar tarjetas (%@ filtros activos)"}}}},
    "Filters":{"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Filters"}},"ar":{"stringUnit":{"state":"translated","value":"عوامل التصفية"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"筛选条件"}},"de":{"stringUnit":{"state":"translated","value":"Filter"}},"fr":{"stringUnit":{"state":"translated","value":"Filtres"}},"hi":{"stringUnit":{"state":"translated","value":"फ़िल्टर"}},"ja":{"stringUnit":{"state":"translated","value":"フィルタ"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Filtros"}},"ru":{"stringUnit":{"state":"translated","value":"Фильтры"}},"es-MX":{"stringUnit":{"state":"translated","value":"Filtros"}},"es-ES":{"stringUnit":{"state":"translated","value":"Filtros"}}}},
    "Nibomo can send study reminders with a card from your review queue. These notifications contain study cards only and never marketing messages.":{"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Nibomo can send study reminders with a card from your review queue. These notifications contain study cards only and never marketing messages."}},"ar":{"stringUnit":{"state":"translated","value":"يمكن لتطبيق Nibomo إرسال تذكيرات بالدراسة مع بطاقة من قائمة المراجعة لديك. تحتوي هذه الإشعارات على بطاقات دراسية فقط ولا تتضمن رسائل تسويقية مطلقًا."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Nibomo 可以从你的复习队列中选取卡片向你发送学习提醒。这些通知仅包含学习卡片，绝不会包含营销消息。"}},"de":{"stringUnit":{"state":"translated","value":"Nibomo kann dir Lern-Erinnerungen mit einer Karte aus deiner Wiederholungswarteschlange senden. Diese Benachrichtigungen enthalten nur Lernkarten und niemals Marketingnachrichten."}},"fr":{"stringUnit":{"state":"translated","value":"Nibomo peut envoyer des rappels d’apprentissage avec une carte de votre file de révision. Ces notifications ne contiennent que des cartes d’apprentissage, jamais de messages marketing."}},"hi":{"stringUnit":{"state":"translated","value":"Nibomo आपकी समीक्षा कतार से एक कार्ड के साथ अध्ययन रिमाइंडर भेज सकता है। इन सूचनाओं में केवल अध्ययन कार्ड होते हैं, कभी भी मार्केटिंग संदेश नहीं।"}},"ja":{"stringUnit":{"state":"translated","value":"Nibomo は、復習キューのカードを使った学習リマインダーを送信できます。これらの通知には学習カードのみが含まれ、マーケティングメッセージは含まれません。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O Nibomo pode enviar lembretes de estudo com um cartão da sua fila de revisão. Essas notificações contêm apenas cartões de estudo e nunca mensagens promocionais."}},"ru":{"stringUnit":{"state":"translated","value":"Nibomo может отправлять напоминания об учебе с карточкой из вашей очереди повторения. Эти уведомления содержат только учебные карточки и никогда не содержат маркетинговых сообщений."}},"es-MX":{"stringUnit":{"state":"translated","value":"Nibomo puede enviarte recordatorios de estudio con una tarjeta de tu cola de repaso. Estas notificaciones solo contienen tarjetas de estudio y nunca mensajes promocionales."}},"es-ES":{"stringUnit":{"state":"translated","value":"Nibomo puede enviarte recordatorios de estudio con una tarjeta de tu cola de repaso. Estas notificaciones solo contienen tarjetas de estudio y nunca mensajes promocionales."}}}},
    "Formula couldn't be rendered. Check the LaTeX syntax.":{"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Formula couldn't be rendered. Check the LaTeX syntax."}},"ar":{"stringUnit":{"state":"translated","value":"تعذر عرض الصيغة. تحقق من صياغة LaTeX."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"无法渲染公式。请检查 LaTeX 语法。"}},"de":{"stringUnit":{"state":"translated","value":"Die Formel konnte nicht dargestellt werden. Prüfe die LaTeX-Syntax."}},"fr":{"stringUnit":{"state":"translated","value":"Impossible d’afficher la formule. Vérifiez la syntaxe LaTeX."}},"hi":{"stringUnit":{"state":"translated","value":"सूत्र रेंडर नहीं किया जा सका। LaTeX सिंटैक्स जांचें।"}},"ja":{"stringUnit":{"state":"translated","value":"数式を表示できませんでした。LaTeX の構文を確認してください。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Não foi possível renderizar a fórmula. Verifique a sintaxe LaTeX."}},"ru":{"stringUnit":{"state":"translated","value":"Не удалось отобразить формулу. Проверьте синтаксис LaTeX."}},"es-MX":{"stringUnit":{"state":"translated","value":"No se pudo mostrar la fórmula. Revisa la sintaxis de LaTeX."}},"es-ES":{"stringUnit":{"state":"translated","value":"No se pudo mostrar la fórmula. Revisa la sintaxis de LaTeX."}}}},
    "Front":{"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Front"}},"ar":{"stringUnit":{"state":"translated","value":"الوجه الأمامي"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"正面"}},"de":{"stringUnit":{"state":"translated","value":"Vorderseite"}},"fr":{"stringUnit":{"state":"translated","value":"Recto"}},"hi":{"stringUnit":{"state":"translated","value":"सामने"}},"ja":{"stringUnit":{"state":"translated","value":"表面"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Frente"}},"ru":{"stringUnit":{"state":"translated","value":"Лицевая сторона"}},"es-MX":{"stringUnit":{"state":"translated","value":"Frente"}},"es-ES":{"stringUnit":{"state":"translated","value":"Anverso"}}}},
    "Good":{"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Good"}},"ar":{"stringUnit":{"state":"translated","value":"جيد"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"良好"}},"de":{"stringUnit":{"state":"translated","value":"Gut"}},"fr":{"stringUnit":{"state":"translated","value":"Correct"}},"hi":{"stringUnit":{"state":"translated","value":"अच्छा"}},"ja":{"stringUnit":{"state":"translated","value":"良い"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Bom"}},"ru":{"stringUnit":{"state":"translated","value":"Хорошо"}},"es-MX":{"stringUnit":{"state":"translated","value":"Bien"}},"es-ES":{"stringUnit":{"state":"translated","value":"Bien"}}}},
    "Hard":{"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Hard"}},"ar":{"stringUnit":{"state":"translated","value":"صعب"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"困难"}},"de":{"stringUnit":{"state":"translated","value":"Schwer"}},"fr":{"stringUnit":{"state":"translated","value":"Difficile"}},"hi":{"stringUnit":{"state":"translated","value":"कठिन"}},"ja":{"stringUnit":{"state":"translated","value":"難しい"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Difícil"}},"ru":{"stringUnit":{"state":"translated","value":"Трудно"}},"es-MX":{"stringUnit":{"state":"translated","value":"Difícil"}},"es-ES":{"stringUnit":{"state":"translated","value":"Difícil"}}}},
    "Hard is for difficult recall":{"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"Hard is for difficult recall"}},"ar":{"stringUnit":{"state":"translated","value":"يُستخدم \"صعب\" عندما يكون التذكر صعبًا"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"“困难”用于回忆起来较吃力的情况"}},"de":{"stringUnit":{"state":"translated","value":"\"Schwer\" ist für Fälle, in denen dir das Erinnern schwerfiel"}},"fr":{"stringUnit":{"state":"translated","value":"« Difficile » sert en cas de rappel difficile"}},"hi":{"stringUnit":{"state":"translated","value":"\"कठिन\" उस स्थिति के लिए है जब याद करना मुश्किल हो"}},"ja":{"stringUnit":{"state":"translated","value":"「難しい」は思い出すのに苦労した場合に使います"}},"pt-BR":{"stringUnit":{"state":"translated","value":"\"Difícil\" é para quando custou lembrar"}},"ru":{"stringUnit":{"state":"translated","value":"«Трудно» — для случаев, когда вспоминать было трудно"}},"es-MX":{"stringUnit":{"state":"translated","value":"\"Difícil\" es para cuando te costó recordar"}},"es-ES":{"stringUnit":{"state":"translated","value":"\"Difícil\" es para cuando te costó recordar"}}}},
    "If you did not know the answer, choose \"Again\". \"Hard\" is only for answers you knew but it was difficult to recall.":{"extractionState":"manual","localizations":{"en":{"stringUnit":{"state":"translated","value":"If you did not know the answer, choose \"Again\". \"Hard\" is only for answers you knew but it was difficult to recall."}},"ar":{"stringUnit":{"state":"translated","value":"إذا لم تكن تعرف الإجابة، فاختر \"مرة أخرى\". يُستخدم \"صعب\" فقط للإجابات التي عرفتها لكن كان تذكرها صعبًا."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"如果你不知道答案，请选择“重来”。“困难”仅适用于你知道答案但回忆起来很吃力的情况。"}},"de":{"stringUnit":{"state":"translated","value":"Wenn du die Antwort nicht wusstest, wähle \"Nochmal\". \"Schwer\" ist nur für Antworten gedacht, die du wusstest, aber nur schwer abrufen konntest."}},"fr":{"stringUnit":{"state":"translated","value":"Si vous ne connaissiez pas la réponse, choisissez « À revoir ». « Difficile » est réservé aux réponses que vous connaissiez mais que vous avez eu du mal à retrouver."}},"hi":{"stringUnit":{"state":"translated","value":"अगर आपको उत्तर नहीं पता था, तो \"फिर से\" चुनें। \"कठिन\" केवल उन उत्तरों के लिए है जिन्हें आप जानते थे, लेकिन याद करना मुश्किल था।"}},"ja":{"stringUnit":{"state":"translated","value":"答えがわからなかった場合は「もう一度」を選んでください。「難しい」は、答えは知っていたものの思い出すのに苦労した場合にのみ使います。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Se você não sabia a resposta, escolha \"De novo\". \"Difícil\" é só para respostas que você sabia, mas custou lembrar."}},"ru":{"stringUnit":{"state":"translated","value":"Если вы не знали ответ, выберите «Снова». «Трудно» подходит только для ответов, которые вы знали, но их было трудно вспомнить."}},"es-MX":{"stringUnit":{"state":"translated","value":"Si no sabías la respuesta, elige \"Otra vez\". \"Difícil\" es solo para respuestas que sí sabías pero te costó recordarlas."}},"es-ES":{"stringUnit":{"state":"translated","value":"Si no sabías la respuesta, elige \"Otra vez\". \"Difícil\" es solo para respuestas que sí sabías pero te costó recordarla."}}}},
