    "ai_chat_alert.microphone.message" : {
      "comment" : "AI chat alert message when microphone access is blocked",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم إيقاف الوصول إلى الميكروفون لتطبيق Nibomo. افتح الإعدادات للسماح به."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prístup k mikrofónu je pre Nibomo vypnutý. Povoľte ho v Nastaveniach."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dostop do mikrofona je za Nibomo izklopljen. Dovolite ga v Nastavitvah."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mikrofonåtkomst är avstängd för Nibomo. Tillåt den i Inställningar."
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nibomo ਲਈ ਮਾਈਕ੍ਰੋਫ਼ੋਨ ਦੀ ਪਹੁੰਚ ਬੰਦ ਹੈ। ਮਨਜ਼ੂਰੀ ਦੇਣ ਲਈ ਸੈਟਿੰਗਾਂ ਖੋਲ੍ਹੋ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dostęp do mikrofonu jest wyłączony dla Nibomo. Otwórz Ustawienia, aby go włączyć."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accesul la microfon este dezactivat pentru Nibomo. Deschide Configurări pentru a-l permite."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nibomo साठी मायक्रोफोनचा प्रवेश बंद आहे. परवानगी देण्यासाठी सेटिंग्ज उघडा."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mikrofontilgang er slått av for Nibomo. Åpne Innstillinger for å tillate den."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Microfoontoegang is uitgeschakeld voor Nibomo. Open Instellingen om toegang toe te staan."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nibomo prieiga prie mikrofono išjungta. Atidarykite nustatymus ir ją įjunkite."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nibomo piekļuve mikrofonam ir izslēgta. Lai to atļautu, atveriet iestatījumus."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nibomo-യ്ക്ക് മൈക്രോഫോൺ അനുമതി ഓഫാണ്. അനുവദിക്കാൻ ക്രമീകരണങ്ങൾ തുറക്കുക."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’accesso al microfono è disattivato per Nibomo. Apri Impostazioni per consentirlo."
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nibomoಗೆ ಮೈಕ್ರೊಫೋನ್ ಪ್ರವೇಶ ನಿಷ್ಕ್ರಿಯವಾಗಿದೆ. ಅನುಮತಿಸಲು ಸೆಟ್ಟಿಂಗ್‌ಗಳನ್ನು ತೆರೆಯಿರಿ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nibomo의 마이크 접근이 꺼져 있습니다. 설정에서 허용하세요."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Nibomo mikrofonhozzáférése ki van kapcsolva. Engedélyezd a Beállításokban."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Akses mikrofon untuk Nibomo dinonaktifkan. Buka Pengaturan untuk mengizinkannya."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slökkt er á hljóðnemaaðgangi fyrir Nibomo. Opnaðu Stillingar til að leyfa hann."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nibomo માટે માઇક્રોફોનની ઍક્સેસ બંધ છે. મંજૂરી આપવા સેટિંગ્સ ખોલો."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הגישה למיקרופון כבויה עבור Nibomo. יש לפתוח את ההגדרות כדי לאפשר אותה."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pristup mikrofonu isključen je za Nibomo. Otvorite Postavke da biste ga dopustili."
