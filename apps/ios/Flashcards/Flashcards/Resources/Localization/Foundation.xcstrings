    "root_tab.guest_sign_in_after_review_prompt.message" : {
      "comment" : "Guest sign-in prompt body after reviewing enough cards",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سجّل الدخول بالبريد الإلكتروني حتى لا تفقد هذه البطاقات وتقدّم المراجعة."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prihláste sa e-mailom, aby sa tieto karty a pokrok v opakovaní nestratili."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prijavite se z e-pošto, da se te kartice in napredek pri ponavljanju ne izgubijo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Logga in med e-post så att korten och dina repetitionsframsteg inte går förlorade."
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਈਮੇਲ ਨਾਲ ਸਾਈਨ ਇਨ ਕਰੋ ਤਾਂ ਜੋ ਇਹ ਕਾਰਡ ਅਤੇ ਦੁਹਰਾਈ ਦੀ ਤਰੱਕੀ ਗੁੰਮ ਨਾ ਹੋਣ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaloguj się przez e-mail, aby nie stracić fiszek i postępów w powtórkach."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autentifică-te prin e-mail pentru a nu pierde aceste fișe și progresul recapitulărilor."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ही कार्डे आणि उजळणीची प्रगती हरवू नये म्हणून ईमेलने साइन-इन करा."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Logg inn med e-post, slik at disse kortene og repetisjonsfremdriften ikke går tapt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meld je aan met e-mail zodat deze kaarten en je herhaalvoortgang niet verloren gaan."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prisijunkite el. paštu, kad neprarastumėte šių kortelių ir kartojimo pažangos."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pierakstieties ar e-pastu, lai nezaudētu šīs kartītes un atkārtošanas progresu."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ഈ കാർഡുകളും ആവർത്തന പുരോഗതിയും നഷ്ടപ്പെടാതിരിക്കാൻ ഇമെയിൽ ഉപയോഗിച്ച് സൈൻ ഇൻ ചെയ്യുക."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accedi con l’email per non perdere queste schede e i progressi dei ripassi."
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಈ ಕಾರ್ಡ್‌ಗಳು ಮತ್ತು ಪುನರಾವರ್ತನೆಯ ಪ್ರಗತಿ ಕಳೆದುಹೋಗದಂತೆ ಇಮೇಲ್ ಮೂಲಕ ಸೈನ್ ಇನ್ ಮಾಡಿ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "카드와 복습 진행 상황을 잃지 않도록 이메일로 로그인하세요."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jelentkezz be e-maillel, hogy a kártyáid és a tanulási haladásod ne vesszen el."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masuk dengan email agar kartu dan kemajuan pengulangan ini tidak hilang."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skráðu þig inn með netfangi svo þessi spjöld og framvinda glatist ekki."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "આ કાર્ડ અને પુનરાવર્તનની પ્રગતિ ખોવાઈ ન જાય તે માટે ઇમેઇલથી સાઇન-ઇન કરો."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "יש להיכנס עם דוא״ל כדי שהכרטיסיות וההתקדמות בחזרות לא יאבדו."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prijavite se e-poštom kako se ove kartice i napredak ponavljanja ne bi izgubili."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Logi sisse e-postiga, et need kaardid ja kordamise edenemine ei läheks kaotsi."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "با ایمیل وارد شوید تا این کارت‌ها و پیشرفت مرور از دست نروند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kirjaudu sähköpostilla, jotta nämä kortit ja kertausedistyminen eivät katoa."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Влезте с имейл, за да запазите тези карти и напредъка от преговорите."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এই কার্ড ও পুনরালোচনার অগ্রগতি যাতে হারিয়ে না যায়, ইমেল দিয়ে সাইন ইন করুন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inicia la sessió amb el correu electrònic per no perdre aquestes targetes i el progrés dels repassos."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přihlaste se e-mailem, aby se tyto kartičky a pokrok v opakování neztratily."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Log ind med e-mail, så disse kort og dine fremskridt ikke går tabt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Συνδεθείτε με email για να μη χαθούν αυτές οι κάρτες και η πρόοδος των επαναλήψεών σας."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Melde dich mit E-Mail an, damit diese Karten und dein Wiederholungsfortschritt nicht verloren gehen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sign in with email so these cards and review progress are not lost."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inicia sesión con tu correo para que estas tarjetas y tu progreso de repaso no se pierdan."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inicia sesión con tu correo para que estas tarjetas y tu progreso de repaso no se pierdan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connectez-vous avec votre e-mail pour ne pas perdre ces cartes ni votre progression de révision."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ईमेल से साइन इन करें ताकि ये कार्ड और समीक्षा प्रगति खो न जाएँ।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メールでサインインして、これらのカードと復習の進捗を失わないようにしましょう。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entre com e-mail para não perder estes cartões nem o seu progresso de revisão."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Войдите по электронной почте, чтобы не потерять эти карточки и прогресс повторения."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用电子邮件登录，以免这些卡片和复习进度丢失。"
