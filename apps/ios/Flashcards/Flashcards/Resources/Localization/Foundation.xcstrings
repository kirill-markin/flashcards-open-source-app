    "access_permission_guidance.photos.limited" : {
      "comment" : "Guidance when photo permission is limited",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الصور الوحيدة المتاحة هي التي سبق أن شاركتها مع Nibomo. افتح الإعدادات لمنح وصول أوسع إلى الصور."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "તમે Nibomo સાથે શેર કરેલા ફોટા જ ઉપલબ્ધ છે. વધુ ફોટાની ઍક્સેસ આપવા સેટિંગ્સ ખોલો."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "רק התמונות שכבר שותפו עם Nibomo זמינות. יש לפתוח את ההגדרות כדי לאפשר גישה לתמונות נוספות."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dostupne su samo fotografije koje ste već podijelili s aplikacijom Nibomo. Otvorite Postavke da biste dopustili širi pristup fotografijama."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saadaval on ainult fotod, mida oled juba Nibomoga jaganud. Laiema juurdepääsu andmiseks ava seaded."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فقط عکس‌هایی که قبلاً با Nibomo به اشتراک گذاشته‌اید در دسترس‌اند. برای دسترسی بیشتر به عکس‌ها، تنظیمات را باز کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vain Nibomon kanssa jo jakamasi kuvat ovat käytettävissä. Anna laajempi kuvien käyttöoikeus asetuksissa."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Налични са само снимките, които вече споделихте с Nibomo. Отворете Настройки, за да предоставите по-широк достъп до снимки."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "শুধুমাত্র আপনি ইতিমধ্যেই Nibomo এর সাথে ভাগ করা ফটোগুলি উপলব্ধ। বৃহত্তর ফটো অ্যাক্সেস মঞ্জুর করতে সেটিংস খুলুন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Només estan disponibles les fotos que ja has compartit amb Nibomo. Obriu Configuració per concedir un accés més ampli a les fotos."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dostupné jsou pouze fotky, které jste již sdíleli s Nibomo. Širší přístup k fotkám povolíte v Nastavení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun de fotos, du allerede har delt med Nibomo, er tilgængelige. Åbn Indstillinger for at give adgang til flere fotos."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Είναι διαθέσιμες μόνο οι φωτογραφίες που έχετε ήδη μοιραστεί με το Nibomo. Ανοίξτε τις Ρυθμίσεις για ευρύτερη πρόσβαση στις φωτογραφίες."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es sind nur die Fotos verfügbar, die du bereits mit Nibomo geteilt hast. Öffne die Einstellungen, um umfassenderen Fotozugriff zu gewähren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only the photos you already shared with Nibomo are available. Open Settings to grant broader photo access."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo están disponibles las fotos que ya compartiste con Nibomo. Abre Ajustes para conceder un acceso más amplio a Fotos."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo están disponibles las fotos que ya compartiste con Nibomo. Abre Ajustes para conceder un acceso más amplio a Fotos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seules les photos que vous avez déjà partagées avec Nibomo sont disponibles. Ouvrez Réglages pour accorder un accès plus large aux photos."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "केवल वही फ़ोटो उपलब्ध हैं जिन्हें आपने पहले से Nibomo के साथ साझा किया है। फ़ोटो का व्यापक एक्सेस देने के लिए सेटिंग्स खोलें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nibomo とすでに共有した写真のみ利用できます。より広い写真アクセスを許可するには、「設定」を開いてください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Somente as fotos que você já compartilhou com o Nibomo estão disponíveis. Abra os Ajustes para conceder um acesso mais amplo às fotos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Доступны только те фотографии, которыми вы уже поделились с Nibomo. Откройте «Настройки», чтобы предоставить более широкий доступ к фото."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目前只可使用你已与 Nibomo 共享的照片。打开“设置”以授予更广泛的照片访问权限。"
          }
        }
      }
    },
