    "cloud_auth.error.transport.send_code_interrupted" : {
      "comment" : "Cloud auth inline error when the network connection drops while sending the OTP code",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انقطع الاتصال أثناء إرسال الرمز. تحقّق من بريدك الإلكتروني، ثم حاول مرة أخرى إذا لزم الأمر."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "કોડ મોકલતી વખતે જોડાણ તૂટી ગયું. તમારો ઇમેઇલ તપાસો અને જરૂર હોય તો ફરી પ્રયાસ કરો."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "החיבור נקטע במהלך שליחת הקוד. יש לבדוק את הדוא״ל ולנסות שוב במידת הצורך."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veza je prekinuta tijekom slanja koda. Provjerite e-poštu pa po potrebi pokušajte ponovno."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ühendus katkes koodi saatmisel. Kontrolli oma e-posti ja vajadusel proovi uuesti."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هنگام ارسال کد، اتصال قطع شد. ایمیل خود را بررسی کنید و در صورت نیاز دوباره امتحان کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yhteys katkesi koodia lähetettäessä. Tarkista sähköpostisi ja yritä tarvittaessa uudelleen."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Връзката беше прекъсната при изпращане на кода. Проверете имейла си и опитайте отново, ако е необходимо."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "কোড পাঠানোর সময় সংযোগ বিঘ্নিত হয়েছিল। আপনার ইমেল চেক করুন, তারপর প্রয়োজন হলে আবার চেষ্টা করুন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La connexió s'ha interromput mentre s'envia el codi. Comproveu el vostre correu electrònic i torneu-ho a provar si cal."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Během odesílání kódu se přerušilo připojení. Zkontrolujte e-mail a případně to zkuste znovu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forbindelsen blev afbrudt under afsendelse af koden. Tjek din e-mail, og prøv igen om nødvendigt."
