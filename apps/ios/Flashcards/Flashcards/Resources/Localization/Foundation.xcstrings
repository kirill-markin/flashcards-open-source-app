    "transient_banner.ai_chat_active_run" : {
      "comment" : "Banner message when an AI response is already in progress",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هناك رد جارٍ بالفعل. انتظر حتى ينتهي أو أوقِفه قبل إرسال رسالة أخرى."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odpoveď sa už pripravuje. Pred odoslaním ďalšej správy počkajte na jej dokončenie alebo ju zastavte."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odgovor je že v pripravi. Pred pošiljanjem naslednjega sporočila počakajte, da se konča, ali ga ustavite."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ett svar pågår redan. Vänta tills det är klart eller stoppa det innan du skickar ett nytt meddelande."
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਇੱਕ ਜਵਾਬ ਪਹਿਲਾਂ ਹੀ ਤਿਆਰ ਹੋ ਰਿਹਾ ਹੈ। ਅਗਲਾ ਸੁਨੇਹਾ ਭੇਜਣ ਤੋਂ ਪਹਿਲਾਂ ਇਸਦੇ ਮੁਕੰਮਲ ਹੋਣ ਦੀ ਉਡੀਕ ਕਰੋ ਜਾਂ ਇਸਨੂੰ ਰੋਕੋ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odpowiedź jest już generowana. Przed wysłaniem kolejnej wiadomości poczekaj na jej zakończenie lub ją zatrzymaj."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un răspuns este deja în curs. Așteaptă să se termine sau oprește-l înainte de a trimite alt mesaj."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एक प्रतिसाद आधीच सुरू आहे. दुसरा संदेश पाठवण्यापूर्वी तो पूर्ण होण्याची वाट पाहा किंवा थांबवा."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et svar er allerede underveis. Vent til det er ferdig, eller stopp det før du sender en ny melding."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er wordt al een antwoord gemaakt. Wacht tot het klaar is of stop het voordat je een nieuw bericht verstuurt."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atsakymas jau kuriamas. Prieš siųsdami kitą žinutę, palaukite, kol jis bus baigtas, arba sustabdykite jį."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atbilde jau tiek veidota. Pirms citas ziņas sūtīšanas pagaidiet, līdz tā ir pabeigta, vai apturiet to."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ഒരു മറുപടി തയ്യാറാക്കിക്കൊണ്ടിരിക്കുന്നു. മറ്റൊരു സന്ദേശം അയയ്ക്കുന്നതിന് മുമ്പ് അത് പൂർത്തിയാകാൻ കാത്തിരിക്കുക അല്ലെങ്കിൽ നിർത്തുക."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "È già in corso una risposta. Attendi che termini o interrompila prima di inviare un altro messaggio."
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಈಗಾಗಲೇ ಉತ್ತರ ಸಿದ್ಧವಾಗುತ್ತಿದೆ. ಮತ್ತೊಂದು ಸಂದೇಶ ಕಳುಹಿಸುವ ಮೊದಲು ಅದು ಮುಗಿಯಲು ಕಾಯಿರಿ ಅಥವಾ ನಿಲ್ಲಿಸಿ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이미 응답이 진행 중입니다. 완료될 때까지 기다리거나 중지한 후 새 메시지를 보내세요."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Egy válasz már folyamatban van. Várd meg a végét, vagy állítsd le, mielőtt új üzenetet küldesz."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Respons sedang berlangsung. Tunggu hingga selesai atau hentikan sebelum mengirim pesan lain."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Svar er þegar í vinnslu. Bíddu þar til því lýkur eða stöðvaðu það áður en þú sendir önnur skilaboð."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "જવાબ પહેલેથી તૈયાર થઈ રહ્યો છે. બીજો સંદેશ મોકલતાં પહેલાં તે પૂરો થાય ત્યાં સુધી રાહ જુઓ અથવા તેને રોકો."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כבר מתבצעת יצירת תשובה. יש להמתין לסיומה או לעצור אותה לפני שליחת הודעה נוספת."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odgovor je već u tijeku. Pričekajte da završi ili ga zaustavite prije slanja nove poruke."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vastus on juba koostamisel. Enne uue sõnumi saatmist oota selle valmimist või peata see."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "یک پاسخ در حال تولید است. پیش از ارسال پیام دیگر، منتظر پایان آن بمانید یا آن را متوقف کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vastausta muodostetaan jo. Odota sen valmistumista tai pysäytä se ennen uuden viestin lähettämistä."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вече е в ход отговор. Изчакайте да приключи или го спрете, преди да изпратите друго съобщение."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "একটি প্রতিক্রিয়া ইতিমধ্যেই চলছে। এটি শেষ হওয়ার জন্য অপেক্ষা করুন বা অন্য বার্তা পাঠানোর আগে এটি বন্ধ করুন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La resposta ja està en curs. Espereu que acabi o atureu-lo abans d'enviar un altre missatge."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odpověď se již vytváří. Než odešlete další zprávu, počkejte na dokončení nebo vytváření zastavte."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et svar er allerede i gang. Vent, til det er færdigt, eller stop det, før du sender en ny besked."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Υπάρχει ήδη απάντηση σε εξέλιξη. Περιμένετε να ολοκληρωθεί ή σταματήστε την πριν στείλετε άλλο μήνυμα."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Antwort wird bereits erstellt. Warte, bis sie fertig ist, oder stoppe sie, bevor du eine weitere Nachricht sendest."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A response is already in progress. Wait for it to finish or stop it before sending another message."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ya hay una respuesta en curso. Espera a que termine o detenla antes de enviar otro mensaje."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ya hay una respuesta en curso. Espera a que termine o detenla antes de enviar otro mensaje."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une réponse est déjà en cours. Attendez qu’elle se termine ou arrêtez-la avant d’envoyer un autre message."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एक जवाब पहले से जारी है। उसके पूरा होने तक प्रतीक्षा करें या दूसरा संदेश भेजने से पहले उसे रोकें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すでに応答を生成中です。完了するまで待つか、停止してから別のメッセージを送信してください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Já há uma resposta em andamento. Espere terminar ou pare antes de enviar outra mensagem."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ответ уже создается. Дождитесь завершения или остановите его перед отправкой другого сообщения."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已有回复正在生成中。请等待其完成，或先停止它再发送另一条消息。"
          }
        }
      }
    },
    "transient_banner.ai_chat_offline" : {
      "comment" : "Banner message when AI chat is unavailable offline",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يوجد اتصال بالإنترنت. تتطلب دردشة الذكاء الاصطناعي اتصالًا بالإنترنت."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bez internetového pripojenia. AI chat vyžaduje prístup k internetu."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ni internetne povezave. Klepet z UI zahteva dostop do interneta."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen internetanslutning. AI-chatten kräver internetåtkomst."
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਇੰਟਰਨੈੱਟ ਕਨੈਕਸ਼ਨ ਨਹੀਂ ਹੈ। AI ਚੈਟ ਲਈ ਇੰਟਰਨੈੱਟ ਪਹੁੰਚ ਲੋੜੀਂਦੀ ਹੈ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brak połączenia z internetem. Czat AI wymaga dostępu do internetu."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nu există conexiune la internet. Chatul AI necesită acces la internet."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इंटरनेट जोडणी नाही. AI चॅटसाठी इंटरनेट आवश्यक आहे."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen internettforbindelse. AI-chat krever internettilgang."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geen internetverbinding. De AI-chat heeft internettoegang nodig."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nėra interneto ryšio. DI pokalbiui reikia interneto."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nav interneta savienojuma. MI sarunai nepieciešams internets."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ഇന്റർനെറ്റ് ബന്ധമില്ല. AI ചാറ്റിന് ഇന്റർനെറ്റ് വേണം."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessuna connessione internet. La chat IA richiede l’accesso a internet."
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಇಂಟರ್ನೆಟ್ ಸಂಪರ್ಕವಿಲ್ಲ. AI ಚಾಟ್‌ಗೆ ಇಂಟರ್ನೆಟ್ ಪ್ರವೇಶ ಬೇಕು."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "인터넷에 연결되어 있지 않습니다. AI 채팅에는 인터넷 연결이 필요합니다."
