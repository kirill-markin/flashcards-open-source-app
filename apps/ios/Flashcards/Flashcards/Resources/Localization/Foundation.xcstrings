    "progress.friend_invite.share_message" : {
      "comment" : "Message for sharing a created friend invite link",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "افتح دعوة Nibomo هذه، ثم سجّل الدخول أو أنشئ حسابًا، وسنرى بعضنا في التطبيق."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otvorte túto pozvánku do Nibomo, prihláste sa alebo zaregistrujte a uvidíme sa navzájom v aplikácii."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odprite to povabilo v Nibomo, se prijavite ali registrirajte in videla se bova v aplikaciji."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öppna den här Nibomo-inbjudan och logga in eller registrera dig så ser vi varandra i appen."
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਇਹ Nibomo ਸੱਦਾ ਖੋਲ੍ਹੋ, ਸਾਈਨ ਇਨ ਜਾਂ ਸਾਈਨ ਅੱਪ ਕਰੋ ਅਤੇ ਅਸੀਂ ਐਪ ਵਿੱਚ ਇੱਕ-ਦੂਜੇ ਨੂੰ ਵੇਖਾਂਗੇ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otwórz to zaproszenie do Nibomo, zaloguj się lub zarejestruj, a zobaczymy się w aplikacji."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deschide această invitație Nibomo, autentifică-te sau înregistrează-te și ne vom vedea în aplicație."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हे Nibomo आमंत्रण उघडा, साइन-इन किंवा नोंदणी करा, आणि आपण अ‍ॅपमध्ये एकमेकांना पाहू शकू."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Åpne denne Nibomo-invitasjonen, logg inn eller registrer deg, så ser vi hverandre i appen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open deze Nibomo-uitnodiging, meld je aan of registreer je, dan zien we elkaar in de app."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atidaryk šį Nibomo kvietimą, prisijunk arba užsiregistruok ir matysime vienas kitą programėlėje."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atver šo Nibomo uzaicinājumu, pieraksties vai reģistrējies, un redzēsim viens otru lietotnē."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ഈ Nibomo ക്ഷണം തുറന്ന് സൈൻ ഇൻ ചെയ്യൂ, അല്ലെങ്കിൽ അക്കൗണ്ട് സൃഷ്ടിക്കൂ; നമുക്ക് ആപ്പിൽ പരസ്പരം കാണാം."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apri questo invito Nibomo, accedi o registrati e ci vedremo nell’app."
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಈ Nibomo ಆಹ್ವಾನ ತೆರೆಯಿರಿ, ಸೈನ್ ಇನ್ ಅಥವಾ ನೋಂದಣಿ ಮಾಡಿ; ಆ್ಯಪ್‌ನಲ್ಲಿ ಪರಸ್ಪರ ಕಾಣಬಹುದು."
