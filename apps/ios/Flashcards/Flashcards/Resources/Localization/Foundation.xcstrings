    "progress.leaderboard_profile.unavailable.participation_disabled.message" : {
      "comment" : "Leaderboard profile unavailable message when leaderboard participation is disabled",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تظهر الملفات الشخصية فقط عند تشغيل المشاركة في لوحة متصدري التقييم."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "રેટિંગ ક્રમાંક યાદીમાં ભાગ લેવાનું ચાલુ હોય ત્યારે જ પ્રોફાઇલ દેખાય છે."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "פרופילים מוצגים רק כאשר ההשתתפות בטבלת הדירוג פעילה."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profili su vidljivi samo dok je uključeno sudjelovanje na ljestvici ocjena."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profiilid on nähtavad ainult siis, kui osaled kordamise edetabelis."
