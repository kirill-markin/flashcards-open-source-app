    "progress.friend_invite.created_message" : {
      "comment" : "Message shown after creating a friend invite link",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكنه فتحه وتسجيل الدخول أو إنشاء حساب، وستريان بعضكما في التطبيق. تنتهي صلاحية روابط الدعوة خلال يومين."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "તેઓ લિંક ખોલીને સાઇન-ઇન અથવા નોંધણી કરી શકે છે, પછી તમે ઍપમાં એકબીજાને જોઈ શકશો. આમંત્રણની લિંક 2 દિવસમાં સમાપ્ત થાય છે."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אפשר לפתוח את הקישור, להיכנס או להירשם, ואז תראו זה את זה באפליקציה. קישורי הזמנה פגים אחרי יומיים."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mogu je otvoriti, prijaviti se ili registrirati, a zatim ćete se vidjeti u aplikaciji. Poveznice s pozivnicom istječu za 2 dana."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta saab selle avada, sisse logida või registreeruda ning seejärel näete teineteist rakenduses. Kutselingid aeguvad 2 päeva pärast."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "دوستتان می‌تواند پیوند را باز کند، وارد شود یا ثبت‌نام کند و سپس یکدیگر را در برنامه خواهید دید. پیوندهای دعوت پس از ۲ روز منقضی می‌شوند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ystäväsi voi avata linkin ja kirjautua tai rekisteröityä. Sen jälkeen näette toisenne sovelluksessa. Kutsulinkit vanhenevat 2 päivässä."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Те могат да го отворят, да влязат или да се регистрират и след това ще се видите в приложението. Връзките за покани изтичат след 2 дни."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "তারা এটি খুলতে, সাইন ইন করতে বা সাইন আপ করতে পারে এবং তারপরে আপনি অ্যাপটিতে একে অপরকে দেখতে পাবেন। আমন্ত্রণ লিঙ্ক 2 দিনের মধ্যে মেয়াদ শেষ হয়।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poden obrir-lo, iniciar sessió o registrar-se, i després us veureu a l'aplicació. Els enllaços d'invitació caduquen d'aquí a 2 dies."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přítel jej může otevřít, přihlásit se nebo si vytvořit účet a pak se v aplikaci navzájem uvidíte. Platnost pozvánek vyprší za 2 dny."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din ven kan åbne det og logge ind eller oprette en konto. Derefter kan I se hinanden i appen. Invitationslinks udløber efter 2 dage."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο φίλος σας μπορεί να τον ανοίξει και να συνδεθεί ή να εγγραφεί. Έπειτα θα βλέπετε ο ένας τον άλλον στην εφαρμογή. Οι σύνδεσμοι πρόσκλησης λήγουν σε 2 ημέρες."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er kann ihn öffnen, sich anmelden oder registrieren, und ihr seht euch in der App. Einladungslinks laufen in 2 Tagen ab."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "They can open it, sign in or sign up, and then you will see each other in the app. Invite links expire in 2 days."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podrá abrirlo, iniciar sesión o registrarse, y os veréis en la app. Los enlaces de invitación caducan en 2 días."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podrá abrirlo, iniciar sesión o registrarse, y se verán en la app. Los enlaces de invitación vencen en 2 días."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre ami peut l’ouvrir, se connecter ou s’inscrire, et vous vous verrez ensuite dans l’app. Les liens d’invitation expirent au bout de 2 jours."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "वे इसे खोलकर साइन इन या साइन अप कर सकते हैं, और आप दोनों ऐप में एक-दूसरे को देखेंगे। आमंत्रण लिंक 2 दिनों में समाप्त हो जाते हैं।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "友だちはリンクを開いてサインインまたは登録でき、アプリ内でお互いを確認できます。招待リンクは2日で期限切れになります。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ele pode abrir o link, entrar ou criar uma conta, e depois vocês vão se ver no app. Os links de convite expiram em 2 dias."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Друг сможет открыть её, войти или зарегистрироваться, и вы увидите друг друга в приложении. Ссылки-приглашения истекают через 2 дня."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "对方可以打开链接，登录或注册，然后你们就能在应用中看到彼此。邀请链接将在 2 天后过期。"
          }
        }
      }
    },
