    "progress.screen.streak_leaderboard.info.message" : {
      "comment" : "Progress streak leaderboard info explanation of ranking metric",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تحدد أيام سلسلتك الحالية ترتيبك. يوم السلسلة هو أي يوم محلي يحتوي على مراجعة بطاقة واحدة على الأقل بتقييم %1$@ أو %2$@ أو %3$@ أو %4$@."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poradie určuje počet dní aktuálnej série. Dňom série je každý miestny deň s aspoň jedným opakovaním karty s hodnotením %1$@, %2$@, %3$@ alebo %4$@."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uvrstitev določa število dni trenutnega niza. Dan niza je vsak lokalni dan z vsaj eno ponovitvijo kartice, ocenjeno z %1$@, %2$@, %3$@ ali %4$@."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antalet dagar i din aktuella svit avgör din placering. En svitdag är en lokal dag med minst en kortrepetition bedömd som %1$@, %2$@, %3$@ eller %4$@."
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਮੌਜੂਦਾ ਲੜੀ ਦੇ ਦਿਨ ਤੁਹਾਡਾ ਦਰਜਾ ਨਿਰਧਾਰਤ ਕਰਦੇ ਹਨ। ਲੜੀ ਦਾ ਦਿਨ ਉਹ ਸਥਾਨਕ ਦਿਨ ਹੈ ਜਿਸ ਵਿੱਚ ਘੱਟੋ-ਘੱਟ ਇੱਕ ਕਾਰਡ ਦੀ ਦੁਹਰਾਈ ਨੂੰ %1$@, %2$@, %3$@ ਜਾਂ %4$@ ਰੇਟ ਕੀਤਾ ਗਿਆ ਹੋਵੇ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liczba dni bieżącej serii określa Twoją pozycję. Dzień serii to dzień w lokalnej strefie czasowej z co najmniej jedną powtórką ocenioną jako %1$@, %2$@, %3$@ lub %4$@."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zilele seriei actuale determină poziția ta. O zi din serie este orice zi locală cu cel puțin o recapitulare evaluată %1$@, %2$@, %3$@ sau %4$@."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सध्याच्या सलग दिवसांवर तुमचा क्रमांक ठरतो. ज्या स्थानिक दिवशी किमान एका कार्डच्या उजळणीला %1$@, %2$@, %3$@ किंवा %4$@ रेटिंग दिले जाते, तो दिवस मालिकेत मोजला जातो."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antall dager i den nåværende dagrekken avgjør plasseringen din. En dag telles når du har minst én kortrepetisjon vurdert som %1$@, %2$@, %3$@ eller %4$@ den lokale dagen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het aantal dagen in je huidige dagreeks bepaalt je positie. Een dag telt mee als je die lokale dag minstens één kaart hebt herhaald met de beoordeling %1$@, %2$@, %3$@ of %4$@."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jūsų vietą lemia dabartinės serijos dienos. Serijos diena – bet kuri vietinė diena, kai bent vieną kortelę įvertinate %1$@, %2$@, %3$@ arba %4$@."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jūsu vietu nosaka pašreizējās sērijas dienas. Sērijas diena ir jebkura vietējā diena, kad vismaz vienu kartīti novērtējat ar %1$@, %2$@, %3$@ vai %4$@."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "നിലവിലെ തുടർച്ചയിലെ ദിവസങ്ങളാണ് നിങ്ങളുടെ സ്ഥാനം നിർണ്ണയിക്കുന്നത്. കുറഞ്ഞത് ഒരു കാർഡെങ്കിലും %1$@, %2$@, %3$@ അല്ലെങ്കിൽ %4$@ എന്ന് റേറ്റ് ചെയ്ത പ്രാദേശിക ദിവസമാണ് തുടർച്ചാ ദിവസം."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I giorni della serie attuale determinano la tua posizione. Un giorno di serie è un giorno locale con almeno una scheda ripassata e valutata %1$@, %2$@, %3$@ o %4$@."
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಪ್ರಸ್ತುತ ನಿರಂತರ ದಿನಗಳು ನಿಮ್ಮ ಸ್ಥಾನವನ್ನು ನಿರ್ಧರಿಸುತ್ತವೆ. ಸ್ಥಳೀಯ ಸಮಯದ ಒಂದು ದಿನದಲ್ಲಿ ಕನಿಷ್ಠ ಒಂದು ಕಾರ್ಡ್‌ಗೆ %1$@, %2$@, %3$@ ಅಥವಾ %4$@ ಮೌಲ್ಯಮಾಪನ ನೀಡಿದರೆ ಅದು ನಿರಂತರತೆಯ ದಿನವಾಗುತ್ತದೆ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "현재 연속 학습 일수로 순위가 정해집니다. 현지 날짜 기준으로 카드를 하나 이상 복습하고 %1$@, %2$@, %3$@ 또는 %4$@으로 평가하면 연속 학습일로 인정됩니다."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A jelenlegi sorozatod hossza határozza meg a helyezésedet. A sorozatba minden olyan helyi nap beleszámít, amikor legalább egy kártyát %1$@, %2$@, %3$@ vagy %4$@ értékeléssel ismételsz."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peringkat ditentukan oleh jumlah hari rangkaian saat ini. Hari rangkaian adalah hari setempat dengan minimal satu pengulangan kartu bernilai %1$@, %2$@, %3$@, atau %4$@."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dagar í núverandi runu ákvarða sæti þitt. Runudagur er hver staðardagur með að minnsta kosti einni upprifjun sem er metin %1$@, %2$@, %3$@ eða %4$@."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "વર્તમાન સતત અભ્યાસના દિવસો તમારો ક્રમ નક્કી કરે છે. સ્થાનિક દિવસમાં ઓછામાં ઓછા એક કાર્ડને %1$@, %2$@, %3$@ અથવા %4$@ રેટિંગ આપ્યું હોય તો તે સતત અભ્યાસનો દિવસ ગણાય છે."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ימי הרצף הנוכחי קובעים את הדירוג שלך. יום ברצף הוא כל יום לפי השעון המקומי שבו בוצעה לפחות חזרה אחת בדירוג %1$@, %2$@, %3$@ או %4$@."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dani trenutačnog niza određuju vaš plasman. Dan niza jest svaki lokalni dan s barem jednim ponavljanjem kartice ocijenjenim kao %1$@, %2$@, %3$@ ili %4$@."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sinu koha määrab praegune järjestikuste päevade arv. Päev läheb arvesse, kui hindad sel kohalikul kalendripäeval vähemalt ühe kaardi hinnanguga %1$@, %2$@, %3$@ või %4$@."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعداد روزهای پیاپی فعلی رتبهٔ شما را تعیین می‌کند. هر روز محلی که در آن دست‌کم یک کارت را با %1$@، %2$@، %3$@ یا %4$@ مرور کنید، یک روز پیاپی محسوب می‌شود."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nykyisen päiväputken pituus määrää sijoituksesi. Putkeen lasketaan jokainen paikallinen päivä, jona vähintään yksi kortti saa arvion %1$@, %2$@, %3$@ tai %4$@."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дните в текущата поредица определят мястото ви. За ден от поредицата се брои всеки ден по местно време с поне един преговор на карта с оценка %1$@, %2$@, %3$@ или %4$@."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "বর্তমান ধারাবাহিকতার দিনের সংখ্যা আপনার অবস্থান নির্ধারণ করে। স্থানীয় সময় অনুযায়ী কোনো দিনে অন্তত একটি কার্ড %1$@, %2$@, %3$@ বা %4$@ দিয়ে মূল্যায়ন করলে সেই দিনটি ধারাবাহিকতায় গণনা করা হয়।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Els dies de la ratxa actual determinen la teva posició. Compta com a dia de ratxa qualsevol dia local amb almenys un repàs d’una targeta valorat amb %1$@, %2$@, %3$@ o %4$@."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaše pořadí určuje počet dní aktuální série. Den série je místní den s alespoň jedním opakováním kartičky hodnoceným %1$@, %2$@, %3$@ nebo %4$@."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antallet af dage i din aktuelle læringsserie bestemmer din placering. En seriedag er en lokal dag med mindst én kortrepetition bedømt som %1$@, %2$@, %3$@ eller %4$@."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι ημέρες του τρέχοντος σερί καθορίζουν τη θέση σας. Ημέρα σερί είναι κάθε τοπική ημέρα με τουλάχιστον μία επανάληψη κάρτας με βαθμό %1$@, %2$@, %3$@ ή %4$@."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine aktuellen Serientage bestimmen deinen Rang. Ein Serientag ist jeder lokale Tag mit mindestens einer Kartenwiederholung, die mit %1$@, %2$@, %3$@ oder %4$@ bewertet wurde."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Current streak days determine your rank. A streak day is any local day with at least one card review rated %1$@, %2$@, %3$@, or %4$@."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus días de racha actuales determinan tu posición. Un día de racha es cualquier día local con al menos una revisión de tarjeta calificada como %1$@, %2$@, %3$@ o %4$@."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus días de racha actuales determinan tu posición. Un día de racha es cualquier día local con al menos una revisión de tarjeta calificada como %1$@, %2$@, %3$@ o %4$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre rang est déterminé par le nombre de jours de votre série actuelle. Un jour de série est un jour local avec au moins une révision de carte notée %1$@, %2$@, %3$@ ou %4$@."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपकी मौजूदा स्ट्रीक के दिन आपकी रैंक तय करते हैं। स्ट्रीक दिन कोई भी स्थानीय दिन है जिसमें कम से कम एक कार्ड समीक्षा को %1$@, %2$@, %3$@ या %4$@ रेट किया गया हो।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在の連続記録日数でランクが決まります。連続記録の1日は、カードレビューが1回以上%1$@、%2$@、%3$@、または%4$@で評価されたローカル日です。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os dias da sua sequência atual determinam a sua posição. Um dia de sequência é qualquer dia local com pelo menos uma revisão de cartão avaliada como %1$@, %2$@, %3$@ ou %4$@."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваше место определяется текущим числом дней серии. Днем серии считается любой локальный день, когда хотя бы одно повторение карточки оценено как %1$@, %2$@, %3$@ или %4$@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当前连续记录天数决定你的排名。连续记录日是指本地日期内至少有一次卡片复习被评为%1$@、%2$@、%3$@或%4$@。"
          }
        }
      }
