    "cloud_auth.error.invalid_base_url" : {
      "comment" : "Cloud auth error when the auth base URL is invalid",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تسجيل الدخول السحابي غير متاح. تحقّق من إعدادات التطبيق."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ક્લાઉડ સાઇન-ઇન ઉપલબ્ધ નથી. ઍપનું કન્ફિગરેશન તપાસો."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הכניסה לענן אינה זמינה. יש לבדוק את תצורת האפליקציה."
