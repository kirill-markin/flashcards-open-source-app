        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনার সংযোগ পরীক্ষা করুন এবং আবার চেষ্টা করুন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comprova la teva connexió i torna-ho a provar."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zkontrolujte připojení a zkuste to znovu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontrollér forbindelsen, og prøv igen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ελέγξτε τη σύνδεσή σας και δοκιμάστε ξανά."
          }
        },
        "de" : {
          "stringUnit" : {
