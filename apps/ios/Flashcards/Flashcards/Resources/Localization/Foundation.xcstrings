        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokušajte ponovno. Ako se problem ponavlja, podijelite tehničke pojedinosti s podrškom."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proovi uuesti. Kui viga kordub, jaga tehnilisi üksikasju kasutajatoega."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "دوباره امتحان کنید. اگر مشکل ادامه داشت، جزئیات فنی را با پشتیبانی به اشتراک بگذارید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yritä uudelleen. Jos ongelma jatkuu, jaa tekniset tiedot tuen kanssa."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Опитайте отново. Ако продължава да се случва, споделете техническите подробности с поддръжката."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আবার চেষ্টা করুন যদি এটি ঘটতে থাকে তবে সহায়তার সাথে প্রযুক্তিগত বিবরণ ভাগ করুন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Torna-ho a provar. Si continua passant, compartiu els detalls tècnics amb el suport."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zkuste to znovu. Pokud problém přetrvá, sdílejte technické podrobnosti s podporou."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prøv igen. Hvis problemet fortsætter, så del de tekniske oplysninger med support."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δοκιμάστε ξανά. Αν το πρόβλημα επιμένει, στείλτε τις τεχνικές λεπτομέρειες στην υποστήριξη."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Versuche es erneut. Wenn das Problem weiter auftritt, teile die technischen Details mit dem Support."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Try again. If it keeps happening, share the technical details with support."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inténtalo de nuevo. Si sigue ocurriendo, comparte los detalles técnicos con soporte."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inténtalo de nuevo. Si sigue ocurriendo, comparte los detalles técnicos con soporte."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Réessayez. Si le problème persiste, transmettez les détails techniques à l’assistance."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "फिर से कोशिश करें। अगर समस्या बनी रहती है, तो तकनीकी विवरण सहायता टीम के साथ साझा करें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "もう一度お試しください。問題が続く場合は、技術的な詳細をサポートに共有してください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
