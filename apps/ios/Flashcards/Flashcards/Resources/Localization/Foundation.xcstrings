    "transient_banner.ai_chat_active_run" : {
      "comment" : "Banner message when an AI response is already in progress",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هناك رد جارٍ بالفعل. انتظر حتى ينتهي أو أوقِفه قبل إرسال رسالة أخرى."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "જવાબ પહેલેથી તૈયાર થઈ રહ્યો છે. બીજો સંદેશ મોકલતાં પહેલાં તે પૂરો થાય ત્યાં સુધી રાહ જુઓ અથવા તેને રોકો."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כבר מתבצעת יצירת תשובה. יש להמתין לסיומה או לעצור אותה לפני שליחת הודעה נוספת."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odgovor je već u tijeku. Pričekajte da završi ili ga zaustavite prije slanja nove poruke."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vastus on juba koostamisel. Enne uue sõnumi saatmist oota selle valmimist või peata see."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "یک پاسخ در حال تولید است. پیش از ارسال پیام دیگر، منتظر پایان آن بمانید یا آن را متوقف کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vastausta muodostetaan jo. Odota sen valmistumista tai pysäytä se ennen uuden viestin lähettämistä."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вече е в ход отговор. Изчакайте да приключи или го спрете, преди да изпратите друго съобщение."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "একটি প্রতিক্রিয়া ইতিমধ্যেই চলছে। এটি শেষ হওয়ার জন্য অপেক্ষা করুন বা অন্য বার্তা পাঠানোর আগে এটি বন্ধ করুন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La resposta ja està en curs. Espereu que acabi o atureu-lo abans d'enviar un altre missatge."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odpověď se již vytváří. Než odešlete další zprávu, počkejte na dokončení nebo vytváření zastavte."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et svar er allerede i gang. Vent, til det er færdigt, eller stop det, før du sender en ny besked."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Υπάρχει ήδη απάντηση σε εξέλιξη. Περιμένετε να ολοκληρωθεί ή σταματήστε την πριν στείλετε άλλο μήνυμα."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Antwort wird bereits erstellt. Warte, bis sie fertig ist, oder stoppe sie, bevor du eine weitere Nachricht sendest."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A response is already in progress. Wait for it to finish or stop it before sending another message."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ya hay una respuesta en curso. Espera a que termine o detenla antes de enviar otro mensaje."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ya hay una respuesta en curso. Espera a que termine o detenla antes de enviar otro mensaje."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une réponse est déjà en cours. Attendez qu’elle se termine ou arrêtez-la avant d’envoyer un autre message."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एक जवाब पहले से जारी है। उसके पूरा होने तक प्रतीक्षा करें या दूसरा संदेश भेजने से पहले उसे रोकें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すでに応答を生成中です。完了するまで待つか、停止してから別のメッセージを送信してください。"
          }
        },
        "pt-BR" : {
