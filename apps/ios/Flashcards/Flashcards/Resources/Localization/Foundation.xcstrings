          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Torna-ho a provar més tard."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zkuste to znovu později."
