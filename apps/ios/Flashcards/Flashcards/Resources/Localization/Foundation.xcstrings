        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nibomo mikrofoni juurdepääs on välja lülitatud. Selle lubamiseks ava seaded."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "دسترسی Nibomo به میکروفون غیرفعال است. برای فعال کردن آن، تنظیمات را باز کنید."
          }
