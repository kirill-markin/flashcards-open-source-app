    "transient_banner.workspace_changes_require_account" : {
      "comment" : "Banner message when workspace changes require an account",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تغييرات مساحة العمل متاحة فقط بعد إنشاء حساب."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zmeny pracovného priestoru sú dostupné až po vytvorení účtu."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spremembe delovnega prostora so na voljo šele po ustvarjanju računa."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ändringar av arbetsytan är tillgängliga först när du har skapat ett konto."
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਵਰਕਸਪੇਸ ਵਿੱਚ ਬਦਲਾਅ ਖਾਤਾ ਬਣਾਉਣ ਤੋਂ ਬਾਅਦ ਹੀ ਉਪਲਬਧ ਹੁੰਦੇ ਹਨ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zmiany obszaru roboczego są dostępne dopiero po utworzeniu konta."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modificările spațiului de lucru sunt disponibile doar după crearea unui cont."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "खाते तयार केल्यानंतरच कार्यक्षेत्रात बदल करता येतात."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Endringer i arbeidsområder er bare tilgjengelige etter at du har opprettet en konto."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je kunt werkruimtes pas wijzigen nadat je een account hebt gemaakt."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Darbo srities pakeitimai galimi tik sukūrus paskyrą."
          }
        },
        "lv" : {
          "stringUnit" : {
