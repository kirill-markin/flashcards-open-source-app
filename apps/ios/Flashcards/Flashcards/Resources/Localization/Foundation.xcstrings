    "strict_reminder.body.2h" : {
      "comment" : "Streak reminder body sent 2 hours before the end of the local day",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حافظ على سلسلتك اليوم. راجع قبل منتصف الليل. تبقت ساعتان."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "આજે સતત અભ્યાસ જાળવો. મધરાત પહેલાં પુનરાવર્તન કરો. 2 કલાક બાકી છે."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כדאי לשמור על הרצף היום ולחזור על כרטיסיות לפני חצות. נותרו שעתיים."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Održite niz danas. Ponavljajte prije ponoći. Preostala su 2 sata."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoia oma päevade jada. Korda enne südaööd. Aega on 2 tundi."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "روزهای پیاپی خود را حفظ کنید. پیش از نیمه‌شب مرور کنید. ۲ ساعت باقی مانده است."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Säilytä päiväputkesi tänään. Kertaa ennen keskiyötä. Aikaa on 2 tuntia."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Продължете поредицата си днес. Преговорете преди полунощ. Остават 2 часа."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আজও ধারাবাহিকতা বজায় রাখুন। মধ্যরাতের আগে পুনরালোচনা করুন। আর ২ ঘণ্টা বাকি।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén la ratxa avui. Repassa abans de mitjanit. Queden 2 hores."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Udržte dnes svou sérii. Opakujte před půlnocí. Zbývají 2 hodiny."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold din læringsserie i gang i dag. Repetér før midnat. 2 timer tilbage."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Διατηρήστε το σερί σας σήμερα. Κάντε επανάληψη πριν από τα μεσάνυχτα. Απομένουν 2 ώρες."
          }
        },
        "de" : {
