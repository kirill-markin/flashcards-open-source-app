    "progress.freeze_bank.info.message" : {
      "comment" : "Body for the streak freeze bank explanation alert. Parameters are available credits, capacity, next credit progress, and next credit required units.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المتاح: %@/%@. إعادة الشحن: %@/%@. تحمي التجميدات الأيام الفائتة وتُعاد شحنها مع استمرار سلسلتك."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ઉપલબ્ધ: %@/%@. પુનઃભરણ: %@/%@. રક્ષણ ચૂકી ગયેલા દિવસોને આવરી લે છે અને સતત અભ્યાસથી ફરી ભરાય છે."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "זמינות: %@/%@. טעינה מחדש: %@/%@. הקפאות מגינות על ימים שהוחמצו ונטענות ככל שהרצף נמשך."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dostupno: %@/%@. Obnova: %@/%@. Zamrzavanja štite propuštene dane i obnavljaju se dok nastavljate niz."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saadaval: %@/%@. Taastumine: %@/%@. Külmutused kaitsevad vahelejäänud päevi ja taastuvad sinu päevade jada jätkudes."
