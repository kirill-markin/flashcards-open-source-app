        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "در دسترس: %@/%@. شارژ مجدد: %@/%@. محافظت‌ها روزهای ازدست‌رفته را پوشش می‌دهند و با ادامهٔ روزهای پیاپی دوباره شارژ می‌شوند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Käytettävissä: %@/%@. Latautuminen: %@/%@. Suojat turvaavat väliin jääneet päivät ja latautuvat päiväputken jatkuessa."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Налични: %@/%@. Възстановяване: %@/%@. Замразяванията предпазват поредицата при пропуснати дни и се възстановяват, докато тя продължава."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "উপলভ্য: %@/%@। পুনরায় জমা হচ্ছে: %@/%@। ফ্রিজ ব্যবহার করলে বাদ পড়া দিনেও ধারাবাহিকতা অক্ষুণ্ণ থাকে। ধারাবাহিকতা বজায় রাখলে ফ্রিজ আবার জমা হয়।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disponibles: %@/%@. Recàrrega: %@/%@. Les congelacions protegeixen els dies que no estudies i es recarreguen mentre mantens la ratxa."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dostupné: %@/%@. Doplnění: %@/%@. Zmrazení chrání vynechané dny a doplňují se, když pokračujete v sérii."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilgængelige: %@/%@. Genopfyldning: %@/%@. Frysninger beskytter oversprungne dage og genopfyldes, når din læringsserie fortsætter."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Διαθέσιμα: %@/%@. Αναπλήρωση: %@/%@. Τα παγώματα προστατεύουν τις ημέρες που παραλείπετε και αναπληρώνονται όσο συνεχίζεται το σερί σας."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verfügbar: %@/%@. Aufladung: %@/%@. Freezes schützen verpasste Tage und laden sich auf, während deine Serie weiterläuft."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Available: %@/%@. Recharge: %@/%@. Freezes protect missed days and recharge as your streak continues."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disponibles: %@/%@. Recarga: %@/%@. Las congelaciones protegen días perdidos y se recargan a medida que continúa tu racha."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disponibles: %@/%@. Recarga: %@/%@. Las congelaciones protegen días perdidos y se recargan a medida que continúa tu racha."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disponibles : %@/%@. Recharge : %@/%@. Les gels protègent les jours manqués et se rechargent à mesure que votre série continue."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "उपलब्ध: %@/%@. रीचार्ज: %@/%@. फ़्रीज़ छूटे हुए दिनों की रक्षा करते हैं और आपकी श्रृंखला जारी रहने पर रीचार्ज होते हैं."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "利用可能: %@/%@。リチャージ: %@/%@。フリーズは逃した日を保護し、連続記録が続くと回復します。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disponíveis: %@/%@. Recarga: %@/%@. Os congelamentos protegem os dias perdidos e recarregam conforme sua sequência continua."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Доступно: %@/%@. Перезарядка: %@/%@. Заморозки защищают пропущенные дни и восстанавливаются по мере продолжения серии."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可用：%@/%@。恢复进度：%@/%@。冻结可保护错过的日期，并会随着连续记录继续而恢复。"
          }
        }
      }
    },
