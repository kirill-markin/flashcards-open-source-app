        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Els perfils només són visibles mentre participes a la classificació de repassos."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profily jsou viditelné pouze při zapnuté účasti v žebříčku opakování."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profiler er kun synlige, når deltagelse i ranglisten over repetitioner er slået til."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τα προφίλ είναι ορατά μόνο όταν η συμμετοχή στην κατάταξη επαναλήψεων είναι ενεργή."
          }
        },
        "de" : {
          "stringUnit" : {
