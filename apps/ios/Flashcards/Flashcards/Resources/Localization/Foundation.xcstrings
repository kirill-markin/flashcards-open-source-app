    "progress.freeze_bank.info.message" : {
      "comment" : "Body for the streak freeze bank explanation alert. Parameters are available credits, capacity, next credit progress, and next credit required units.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المتاح: %@/%@. إعادة الشحن: %@/%@. تحمي التجميدات الأيام الفائتة وتُعاد شحنها مع استمرار سلسلتك."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dostupné: %@/%@. Dopĺňanie: %@/%@. Ochrany chránia vynechané dni a dopĺňajú sa pri pokračovaní série."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na voljo: %@/%@. Obnavljanje: %@/%@. Zaščite pokrijejo izpuščene dni in se obnavljajo, ko nadaljujete niz."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tillgängliga: %@/%@. Återställning: %@/%@. Skydden täcker missade dagar och återställs när din svit fortsätter."
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਉਪਲਬਧ: %@/%@। ਮੁੜ ਭਰਾਈ: %@/%@। ਫ੍ਰੀਜ਼ ਛੁੱਟੇ ਦਿਨਾਂ ਦੀ ਰੱਖਿਆ ਕਰਦੇ ਹਨ ਅਤੇ ਲੜੀ ਜਾਰੀ ਰਹਿਣ ਨਾਲ ਮੁੜ ਭਰਦੇ ਹਨ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dostępne: %@/%@. Odnowienie: %@/%@. Zamrożenia chronią pominięte dni i odnawiają się, gdy kontynuujesz serię."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disponibile: %@/%@. Reîncărcare: %@/%@. Înghețările protejează zilele ratate și se reîncarcă pe măsură ce seria continuă."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "उपलब्ध: %@/%@. पुनर्भरण: %@/%@. संरक्षणामुळे चुकलेल्या दिवशी मालिका टिकते आणि सलग अभ्यास करत राहिल्यास साठा पुन्हा भरतो."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilgjengelig: %@/%@. Påfyll: %@/%@. Frysing beskytter dager du går glipp av, og fylles på når dagrekken fortsetter."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beschikbaar: %@/%@. Aanvulling: %@/%@. Bescherming vangt gemiste dagen op en wordt aangevuld als je dagreeks doorgaat."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yra: %@/%@. Papildymas: %@/%@. Apsaugos padengia praleistas dienas ir pasipildo tęsiant seriją."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pieejams: %@/%@. Papildināšana: %@/%@. Aizsardzība pasargā izlaistās dienas un atjaunojas, turpinot sēriju."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ലഭ്യമായത്: %@/%@. നിറയുന്നത്: %@/%@. വിട്ടുപോയ ദിവസങ്ങളിൽ സംരക്ഷണം തുടർച്ച നിലനിർത്തുന്നു; തുടർച്ച തുടരുമ്പോൾ അത് വീണ്ടും നിറയും."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disponibili: %@/%@. Ricarica: %@/%@. I salvaserie proteggono i giorni saltati e si ricaricano mentre continui la serie."
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಲಭ್ಯ: %@/%@. ಮರುಭರ್ತಿ: %@/%@. ರಕ್ಷಣೆಗಳು ತಪ್ಪಿದ ದಿನಗಳಲ್ಲೂ ನಿರಂತರತೆಯನ್ನು ಉಳಿಸುತ್ತವೆ ಮತ್ತು ನಿರಂತರತೆ ಮುಂದುವರಿದಂತೆ ಮರುಭರ್ತಿಯಾಗುತ್ತವೆ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사용 가능: %@/%@. 충전: %@/%@. 보호권은 빠뜨린 날에도 연속 학습을 유지해 주며, 연속 학습을 이어가면 충전됩니다."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elérhető: %@/%@. Feltöltés: %@/%@. A sorozatvédők megóvják a kihagyott napokat, és a sorozat folytatásával újratöltődnek."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tersedia: %@/%@. Isi ulang: %@/%@. Pelindung menjaga rangkaian saat Anda melewatkan hari dan terisi ulang saat rangkaian berlanjut."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiltækt: %@/%@. Endurhleðsla: %@/%@. Runuvörn verndar daga sem falla úr og endurhleðst þegar runan heldur áfram."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ઉપલબ્ધ: %@/%@. પુનઃભરણ: %@/%@. રક્ષણ ચૂકી ગયેલા દિવસોને આવરી લે છે અને સતત અભ્યાસથી ફરી ભરાય છે."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "זמינות: %@/%@. טעינה מחדש: %@/%@. הקפאות מגינות על ימים שהוחמצו ונטענות ככל שהרצף נמשך."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dostupno: %@/%@. Obnova: %@/%@. Zamrzavanja štite propuštene dane i obnavljaju se dok nastavljate niz."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saadaval: %@/%@. Taastumine: %@/%@. Külmutused kaitsevad vahelejäänud päevi ja taastuvad sinu päevade jada jätkudes."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "در دسترس: %@/%@. شارژ مجدد: %@/%@. محافظت‌ها روزهای ازدست‌رفته را پوشش می‌دهند و با ادامهٔ روزهای پیاپی دوباره شارژ می‌شوند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Käytettävissä: %@/%@. Latautuminen: %@/%@. Suojat turvaavat väliin jääneet päivät ja latautuvat päiväputken jatkuessa."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Налични: %@/%@. Възстановяване: %@/%@. Замразяванията предпазват поредицата при пропуснати дни и се възстановяват, докато тя продължава."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "উপলভ্য: %@/%@। পুনরায় জমা হচ্ছে: %@/%@। ফ্রিজ ব্যবহার করলে বাদ পড়া দিনেও ধারাবাহিকতা অক্ষুণ্ণ থাকে। ধারাবাহিকতা বজায় রাখলে ফ্রিজ আবার জমা হয়।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disponibles: %@/%@. Recàrrega: %@/%@. Les congelacions protegeixen els dies que no estudies i es recarreguen mentre mantens la ratxa."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dostupné: %@/%@. Doplnění: %@/%@. Zmrazení chrání vynechané dny a doplňují se, když pokračujete v sérii."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilgængelige: %@/%@. Genopfyldning: %@/%@. Frysninger beskytter oversprungne dage og genopfyldes, når din læringsserie fortsætter."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Διαθέσιμα: %@/%@. Αναπλήρωση: %@/%@. Τα παγώματα προστατεύουν τις ημέρες που παραλείπετε και αναπληρώνονται όσο συνεχίζεται το σερί σας."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verfügbar: %@/%@. Aufladung: %@/%@. Freezes schützen verpasste Tage und laden sich auf, während deine Serie weiterläuft."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Available: %@/%@. Recharge: %@/%@. Freezes protect missed days and recharge as your streak continues."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disponibles: %@/%@. Recarga: %@/%@. Las congelaciones protegen días perdidos y se recargan a medida que continúa tu racha."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disponibles: %@/%@. Recarga: %@/%@. Las congelaciones protegen días perdidos y se recargan a medida que continúa tu racha."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disponibles : %@/%@. Recharge : %@/%@. Les gels protègent les jours manqués et se rechargent à mesure que votre série continue."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "उपलब्ध: %@/%@. रीचार्ज: %@/%@. फ़्रीज़ छूटे हुए दिनों की रक्षा करते हैं और आपकी श्रृंखला जारी रहने पर रीचार्ज होते हैं."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "利用可能: %@/%@。リチャージ: %@/%@。フリーズは逃した日を保護し、連続記録が続くと回復します。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disponíveis: %@/%@. Recarga: %@/%@. Os congelamentos protegem os dias perdidos e recarregam conforme sua sequência continua."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Доступно: %@/%@. Перезарядка: %@/%@. Заморозки защищают пропущенные дни и восстанавливаются по мере продолжения серии."
