        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nyisd meg ezt a Nibomo-meghívót, jelentkezz be vagy regisztrálj, és látjuk egymást az alkalmazásban."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
