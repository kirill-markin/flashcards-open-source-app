    "strict_reminder.body.2h" : {
      "comment" : "Streak reminder body sent 2 hours before the end of the local day",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حافظ على سلسلتك اليوم. راجع قبل منتصف الليل. تبقت ساعتان."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Udržte si dnes sériu. Opakujte pred polnocou. Zostávajú 2 hodiny."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ohranite današnji niz. Ponavljajte pred polnočjo. Preostali sta 2 uri."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Håll sviten vid liv i dag. Repetera före midnatt. 2 timmar kvar."
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਅੱਜ ਆਪਣੀ ਲੜੀ ਜਾਰੀ ਰੱਖੋ। ਅੱਧੀ ਰਾਤ ਤੋਂ ਪਹਿਲਾਂ ਦੁਹਰਾਈ ਕਰੋ। 2 ਘੰਟੇ ਬਾਕੀ ਹਨ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podtrzymaj dziś serię. Zrób powtórkę przed północą. Zostały 2 godziny."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Păstrează-ți seria astăzi. Recapitulează înainte de miezul nopții. Mai sunt 2 ore."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आजची सलग दिवसांची मालिका टिकवा. मध्यरात्रीपूर्वी उजळणी करा. 2 तास बाकी."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Behold dagrekken i dag. Repeter før midnatt. 2 timer igjen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Houd je dagreeks vandaag vast. Herhaal vóór middernacht. Nog 2 uur."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Išlaikykite seriją šiandien. Pakartokite iki vidurnakčio. Liko 2 valandos."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saglabājiet sēriju šodien. Atkārtojiet pirms pusnakts. Atlikušas 2 stundas."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ഇന്നത്തെ തുടർച്ച നിലനിർത്തുക. അർദ്ധരാത്രിക്ക് മുമ്പ് ആവർത്തിക്കുക. 2 മണിക്കൂർ ബാക്കി."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantieni la serie oggi. Ripassa prima di mezzanotte. Restano 2 ore."
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಇಂದಿನ ನಿರಂತರತೆ ಉಳಿಸಿ. ಮಧ್ಯರಾತ್ರಿಯ ಮೊದಲು ಪುನರಾವರ್ತಿಸಿ. ಇನ್ನೂ 2 ಗಂಟೆಗಳಿವೆ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오늘도 연속 학습을 이어가세요. 자정 전에 복습하세요. 2시간 남았습니다."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Őrizd meg a sorozatodat ma. Ismételj éjfél előtt. Még 2 óra van hátra."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jaga rangkaian Anda hari ini. Ulangi sebelum tengah malam. Tersisa 2 jam."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haltu rununni í dag. Rifjaðu upp fyrir miðnætti. 2 klukkustundir eftir."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "આજે સતત અભ્યાસ જાળવો. મધરાત પહેલાં પુનરાવર્તન કરો. 2 કલાક બાકી છે."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כדאי לשמור על הרצף היום ולחזור על כרטיסיות לפני חצות. נותרו שעתיים."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Održite niz danas. Ponavljajte prije ponoći. Preostala su 2 sata."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoia oma päevade jada. Korda enne südaööd. Aega on 2 tundi."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "روزهای پیاپی خود را حفظ کنید. پیش از نیمه‌شب مرور کنید. ۲ ساعت باقی مانده است."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Säilytä päiväputkesi tänään. Kertaa ennen keskiyötä. Aikaa on 2 tuntia."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Продължете поредицата си днес. Преговорете преди полунощ. Остават 2 часа."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আজও ধারাবাহিকতা বজায় রাখুন। মধ্যরাতের আগে পুনরালোচনা করুন। আর ২ ঘণ্টা বাকি।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén la ratxa avui. Repassa abans de mitjanit. Queden 2 hores."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Udržte dnes svou sérii. Opakujte před půlnocí. Zbývají 2 hodiny."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold din læringsserie i gang i dag. Repetér før midnat. 2 timer tilbage."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Διατηρήστε το σερί σας σήμερα. Κάντε επανάληψη πριν από τα μεσάνυχτα. Απομένουν 2 ώρες."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte deine Serie heute. Wiederhole vor Mitternacht. Noch 2 Stunden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep your streak today. Review before midnight. 2 hours left."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén tu racha hoy. Repasa antes de medianoche. Quedan 2 horas."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén tu racha hoy. Repasa antes de medianoche. Quedan 2 horas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gardez votre série aujourd’hui. Révisez avant minuit. Il reste 2 heures."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आज अपनी स्ट्रीक बनाए रखें। आधी रात से पहले रिव्यू करें। 2 घंटे बाकी हैं।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今日の連続記録を保ちましょう。午前0時までに復習してください。あと2時間です。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenha sua sequência hoje. Revise antes da meia-noite. Faltam 2 horas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сохраните серию сегодня. Повторите до полуночи. Осталось 2 часа."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今天保持连续记录。午夜前复习。还剩 2 小时。"
          }
        }
      }
    },
