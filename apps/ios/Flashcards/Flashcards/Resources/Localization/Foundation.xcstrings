    "access_permission_guidance.allowed" : {
      "comment" : "Guidance when permission is allowed",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إذا أردت إيقاف هذا الوصول، فافتح الإعدادات."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "આ ઍક્સેસ બંધ કરવા માટે સેટિંગ્સ ખોલો."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כדי לבטל את הגישה, יש לפתוח את ההגדרות."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otvorite Postavke ako želite isključiti ovaj pristup."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kui soovid selle juurdepääsu välja lülitada, ava seaded."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اگر می‌خواهید این دسترسی را غیرفعال کنید، تنظیمات را باز کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avaa asetukset, jos haluat poistaa tämän käyttöoikeuden."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отворете Настройки, ако искате да изключите този достъп."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনি যদি এই অ্যাক্সেস বন্ধ করতে চান তবে সেটিংস খুলুন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obriu Configuració si voleu desactivar aquest accés."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokud chcete tento přístup vypnout, otevřete Nastavení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Åbn Indstillinger, hvis du vil slå denne adgang fra."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ανοίξτε τις Ρυθμίσεις για να απενεργοποιήσετε αυτήν την πρόσβαση."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffne die Einstellungen, wenn du diesen Zugriff deaktivieren möchtest."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open Settings if you want to turn this access off."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre Ajustes si quieres desactivar este acceso."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre Ajustes si quieres desactivar este acceso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvrez Réglages si vous souhaitez désactiver cet accès."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अगर आप यह एक्सेस बंद करना चाहते हैं, तो सेटिंग्स खोलें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このアクセスをオフにするには、「設定」を開いてください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abra os Ajustes se quiser desativar esse acesso."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Откройте «Настройки», если хотите отключить этот доступ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果你想关闭此访问权限，请打开“设置”。"
          }
        }
      }
    },
    "access_permission_guidance.ask_every_time" : {
      "comment" : "Guidance when permission has not been requested yet",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اطلب الوصول الآن، أو افتح الإعدادات لاحقًا إذا أردت إدارته يدويًا."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "હમણાં ઍક્સેસની વિનંતી કરો અથવા તેને જાતે સંચાલિત કરવા પછી સેટિંગ્સ ખોલો."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אפשר לבקש גישה כעת, או לפתוח את ההגדרות בהמשך לניהול ידני שלה."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zatražite pristup sada ili otvorite Postavke kasnije da biste njime upravljali ručno."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taotle juurdepääsu kohe või ava seaded hiljem, et seda käsitsi hallata."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اکنون درخواست دسترسی دهید یا برای مدیریت دستی آن بعداً تنظیمات را باز کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pyydä käyttöoikeutta nyt tai hallitse sitä myöhemmin asetuksissa."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поискайте достъп сега или отворете Настройки по-късно, ако искате да го управлявате ръчно."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এখনই অ্যাক্সেসের জন্য অনুরোধ করুন, অথবা আপনি যদি ম্যানুয়ালি এটি পরিচালনা করতে চান তাহলে পরে সেটিংস খুলুন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sol·liciteu accés ara o obriu Configuració més tard si voleu gestionar-lo manualment."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Požádejte o přístup nyní, nebo jej později spravujte ručně v Nastavení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anmod om adgang nu, eller administrer den senere manuelt i Indstillinger."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ζητήστε πρόσβαση τώρα ή διαχειριστείτε τη χειροκίνητα αργότερα στις Ρυθμίσεις."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fordere den Zugriff jetzt an oder öffne später die Einstellungen, wenn du ihn manuell verwalten möchtest."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Request access now, or open Settings later if you want to manage it manually."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solicita acceso ahora o abre Ajustes más tarde si quieres gestionarlo manualmente."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solicita acceso ahora o abre Ajustes más tarde si quieres gestionarlo manualmente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demandez l’accès maintenant, ou ouvrez Réglages plus tard si vous souhaitez le gérer manuellement."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अभी एक्सेस माँगें, या यदि आप इसे मैन्युअल रूप से प्रबंधित करना चाहते हैं तो बाद में सेटिंग्स खोलें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今すぐアクセスをリクエストするか、手動で管理したい場合は後で「設定」を開いてください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solicite o acesso agora ou abra os Ajustes depois, se quiser gerenciá-lo manualmente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запросите доступ сейчас или позже откройте «Настройки», если хотите управлять им вручную."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "现在请求访问权限，或者稍后打开“设置”手动管理。"
          }
        }
      }
    },
    "access_permission_guidance.camera.blocked" : {
      "comment" : "Guidance when camera permission is blocked",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم إيقاف الوصول إلى الكاميرا لتطبيق Nibomo. افتح الإعدادات > الخصوصية والأمان > الكاميرا لتغييره."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nibomo માટે કૅમેરાની ઍક્સેસ બંધ છે. બદલવા માટે સેટિંગ્સ > ગોપનીયતા અને સુરક્ષા > કૅમેરા ખોલો."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הגישה למצלמה כבויה עבור Nibomo. לשינוי, יש לפתוח הגדרות > פרטיות ואבטחה > מצלמה."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pristup kameri isključen je za Nibomo. Za promjenu otvorite Postavke > Privatnost i sigurnost > Kamera."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nibomo kaamerale juurdepääs on välja lülitatud. Selle muutmiseks ava Seaded > Privaatsus ja turvalisus > Kaamera."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "دسترسی Nibomo به دوربین غیرفعال است. برای تغییر آن، تنظیمات > حریم خصوصی و امنیت > دوربین را باز کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nibomon kameran käyttöoikeus on poistettu. Muuta sitä kohdassa Asetukset > Tietosuoja ja suojaus > Kamera."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Достъпът до камерата е изключен за Nibomo. Отворете Настройки > Поверителност и сигурност > Камера, за да го промените."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nibomo এর জন্য ক্যামেরা অ্যাক্সেস বন্ধ করা আছে। এটি পরিবর্তন করতে সেটিংস > গোপনীয়তা এবং নিরাপত্তা > ক্যামেরা খুলুন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'accés a la càmera està desactivat per a Nibomo. Obriu Configuració > Privadesa i seguretat > Càmera per canviar-ho."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přístup k fotoaparátu je pro Nibomo vypnutý. Změníte jej v Nastavení > Soukromí a zabezpečení > Fotoaparát."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kameraadgang er slået fra for Nibomo. Åbn Indstillinger > Anonymitet & sikkerhed > Kamera for at ændre det."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η πρόσβαση στην κάμερα είναι απενεργοποιημένη για το Nibomo. Αλλάξτε την στις Ρυθμίσεις > Απόρρητο και ασφάλεια > Κάμερα."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Kamerazugriff für Nibomo ist deaktiviert. Öffne Einstellungen > Datenschutz und Sicherheit > Kamera, um das zu ändern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Camera access is turned off for Nibomo. Open Settings > Privacy & Security > Camera to change it."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El acceso a la cámara está desactivado para Nibomo. Abre Ajustes > Privacidad y seguridad > Cámara para cambiarlo."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El acceso a la cámara está desactivado para Nibomo. Abre Ajustes > Privacidad y seguridad > Cámara para cambiarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’accès à l’appareil photo est désactivé pour Nibomo. Ouvrez Réglages > Confidentialité et sécurité > Appareil photo pour le modifier."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nibomo के लिए कैमरा एक्सेस बंद है। इसे बदलने के लिए सेटिंग्स > गोपनीयता और सुरक्षा > कैमरा खोलें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nibomo のカメラへのアクセスはオフです。変更するには「設定」>「プライバシーとセキュリティ」>「カメラ」を開いてください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O acesso à câmera está desativado para o Nibomo. Abra Ajustes > Privacidade e Segurança > Câmera para alterar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Доступ к камере для Nibomo отключен. Чтобы изменить это, откройте «Настройки» > «Конфиденциальность и безопасность» > «Камера»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nibomo 的相机访问权限已关闭。打开“设置”>“隐私与安全性”>“相机”进行更改。"
          }
        }
      }
    },
    "access_permission_guidance.limited" : {
      "comment" : "Guidance when permission is limited",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "افتح الإعدادات لمراجعة هذا الوصول أو توسيعه."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "આ ઍક્સેસ તપાસવા અથવા વધારવા માટે સેટિંગ્સ ખોલો."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "יש לפתוח את ההגדרות כדי לבדוק או להרחיב את הגישה."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otvorite Postavke da biste pregledali ili proširili ovaj pristup."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selle juurdepääsu kontrollimiseks või laiendamiseks ava seaded."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "برای بررسی یا گسترش این دسترسی، تنظیمات را باز کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tarkista käyttöoikeus tai laajenna sitä avaamalla asetukset."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отворете Настройки, за да прегледате или разширите този достъп."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
