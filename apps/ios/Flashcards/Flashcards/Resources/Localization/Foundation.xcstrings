    "progress.screen.leaderboard.sign_in.message" : {
      "comment" : "Progress rating leaderboard sign-in placeholder message",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سجّل الدخول بالبريد الإلكتروني لترى ترتيب مراجعاتك في لوحة صدارة التقييمات."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "રેટિંગ ક્રમાંક યાદીમાં તમારાં પુનરાવર્તનોનો ક્રમ જોવા ઇમેઇલથી સાઇન-ઇન કરો."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כדי לראות את מיקום החזרות שלך בטבלת הדירוג, יש להיכנס עם דוא״ל."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prijavite se e-poštom da biste vidjeli plasman svojih ponavljanja na ljestvici ocjena."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Logi sisse e-postiga, et näha oma kordamiste kohta edetabelis."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "با ایمیل وارد شوید تا رتبهٔ مرورهای خود را در جدول رتبه‌بندی مرور ببینید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kirjaudu sähköpostilla nähdäksesi kertaustesi sijoituksen tulostaulukossa."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Влезте с имейл, за да видите как вашите преговори се класират в класацията по преговори."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
