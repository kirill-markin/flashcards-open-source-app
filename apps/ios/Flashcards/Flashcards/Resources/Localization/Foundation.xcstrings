    "progress.friend_invite.display_name.footer" : {
      "comment" : "Footer explaining private friend invite display names and expiration",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أنت فقط ترى هذا الاسم في لوحة الصدارة لديك. يختار صديقك اسمك عند قبول الدعوة. تنتهي صلاحية روابط الدعوة خلال يومين."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "તમારી ક્રમાંક યાદીમાં આ નામ ફક્ત તમને દેખાશે. સ્વીકારતી વખતે તમારો મિત્ર તમારું નામ પસંદ કરશે. આમંત્રણની લિંક 2 દિવસમાં સમાપ્ત થાય છે."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "רק לך יוצג השם הזה בטבלת הדירוג שלך. בעת קבלת ההזמנה, החבר בוחר איך לקרוא לך. קישורי הזמנה פגים אחרי יומיים."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Samo vi vidite ovo ime na svojoj ljestvici. Prijatelj pri prihvaćanju bira kako će vas nazvati. Poveznice s pozivnicom istječu za 2 dana."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ainult sina näed seda nime oma edetabelis. Sõber valib kutse vastuvõtmisel, kuidas sind nimetada. Kutselingid aeguvad 2 päeva pärast."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فقط شما این نام را در جدول رتبه‌بندی خود می‌بینید. دوستتان هنگام پذیرش دعوت، نامی برای شما انتخاب می‌کند. پیوندهای دعوت پس از ۲ روز منقضی می‌شوند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vain sinä näet tämän nimen tulostaulukossasi. Ystäväsi valitsee sinulle nimen hyväksyessään kutsun. Kutsulinkit vanhenevat 2 päivässä."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Само вие виждате това име в класацията си. При приемане приятелят ви избира с какво име да ви вижда. Връзките за покана изтичат след 2 дни."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনার লিডারবোর্ডে এই নামটি শুধু আপনিই দেখবেন। আমন্ত্রণ গ্রহণের সময় আপনার বন্ধু আপনাকে কোন নামে দেখবেন তা বেছে নেবেন। আমন্ত্রণের লিঙ্কের মেয়াদ ২ দিন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Només tu veus aquest nom a la teva classificació. En acceptar, el teu amic tria amb quin nom et vol veure. Els enllaços d’invitació caduquen al cap de 2 dies."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toto jméno ve svém žebříčku vidíte jen vy. Přítel při přijetí pozvánky zvolí jméno pro vás. Platnost pozvánek vyprší za 2 dny."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun du ser dette navn på din rangliste. Din ven vælger et navn til dig ved accept. Invitationslinks udløber efter 2 dage."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μόνο εσείς βλέπετε αυτό το όνομα στην κατάταξή σας. Ο φίλος σας επιλέγει πώς θα σας ονομάζει όταν αποδεχτεί την πρόσκληση. Οι σύνδεσμοι πρόσκλησης λήγουν σε 2 ημέρες."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur du siehst diesen Namen in deiner Bestenliste. Dein Freund wählt beim Annehmen aus, wie er dich nennt. Einladungslinks laufen in 2 Tagen ab."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only you see this name in your leaderboard. Your friend chooses what to call you when accepting. Invite links expire in 2 days."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo tú ves este nombre en tu tabla de clasificación. Tu amigo elige cómo llamarte al aceptar. Los enlaces de invitación caducan en 2 días."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo tú ves este nombre en tu tabla de posiciones. Tu amigo elige cómo llamarte al aceptar. Los enlaces de invitación vencen en 2 días."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous seul voyez ce nom dans votre classement. Votre ami choisit le nom qu’il vous donne en acceptant. Les liens d’invitation expirent au bout de 2 jours."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह नाम केवल आपको अपने लीडरबोर्ड में दिखता है। स्वीकार करते समय आपका दोस्त चुनता है कि आपको क्या नाम देना है। आमंत्रण लिंक 2 दिनों में समाप्त हो जाते हैं।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この名前はあなたのリーダーボードにだけ表示されます。友だちは承認時にあなたの呼び名を選びます。招待リンクは2日で期限切れになります。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Só você vê este nome no seu ranking. Seu amigo escolhe como chamar você ao aceitar. Os links de convite expiram em 2 dias."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Только вы видите это имя в своей таблице лидеров. Друг выберет ваше имя у себя при принятии приглашения. Ссылки-приглашения истекают через 2 дня."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只有你会在自己的排行榜中看到这个名称。你的朋友接受邀请时会选择如何称呼你。邀请链接将在 2 天后过期。"
          }
        }
      }
    },
