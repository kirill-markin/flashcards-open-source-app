    "progress.screen.leaderboard.info.message" : {
      "comment" : "Progress leaderboard info explanation of which review ratings count",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُحتسب مراجعات صعب وجيد وسهل في ترتيبك، أما مرة أخرى فلا تُحتسب."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "મુશ્કેલ, સારું અને સરળ રેટિંગવાળાં પુનરાવર્તનો તમારા ક્રમમાં ગણાય છે. ફરી ગણાતું નથી."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "חזרות בדירוג קשה, טוב וקל נחשבות לדירוג שלך. שוב אינו נחשב."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ponavljanja s ocjenom Teško, Dobro i Lako računaju se za vaš plasman. Ponovno se ne računa."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hinnangud „Raske”, „Hea” ja „Lihtne” lähevad edetabelis arvesse. „Uuesti” ei lähe."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مرورهای «سخت»، «خوب» و «آسان» در رتبهٔ شما حساب می‌شوند. «دوباره» حساب نمی‌شود."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arviot Vaikea, Hyvä ja Helppo lasketaan sijoitukseesi. Uudelleen-arviota ei lasketa."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Преговорите с оценка „Трудно“, „Добре“ и „Лесно“ се зачитат за класирането. „Отново“ не се зачита."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "কঠিন, ভালো ও সহজ দিয়ে মূল্যায়ন করা পুনরালোচনা আপনার অবস্থান নির্ধারণে গণনা করা হয়। আবার গণনা করা হয় না।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Els repassos valorats amb Difícil, Bé i Fàcil compten per a la classificació. Un altre cop no compta."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opakování s hodnocením Těžké, Dobré a Snadné se započítávají do umístění. Znovu se nezapočítává."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Repetitioner bedømt som Svært, Godt og Let tæller med i din placering. Igen tæller ikke med."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι επαναλήψεις με βαθμό Δύσκολο, Καλό και Εύκολο μετράνε στη θέση σας. Ο βαθμός Ξανά δεν μετράει."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schwer, Gut und Leicht zählen für deinen Rang. Nochmal zählt nicht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hard, Good, and Easy reviews count toward your rank. Again does not."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los repasos Difícil, Bien y Fácil cuentan para tu posición. De nuevo no cuenta."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los repasos Difícil, Bien y Fácil cuentan para tu posición. De nuevo no cuenta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les révisions notées « Difficile », « Correct » et « Facile » comptent pour votre classement. « À revoir » ne compte pas."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कठिन, अच्छा और आसान समीक्षाएँ आपकी रैंक में गिनी जाती हैं। फिर से नहीं गिना जाता।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「難しい」「良い」「簡単」はランクに加算されます。「もう一度」は加算されません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revisões avaliadas como Difícil, Bom e Fácil contam para a sua posição. De novo não conta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Трудно», «Хорошо» и «Легко» учитываются в рейтинге. «Снова» не учитывается."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“困难”“良好”“简单”计入排名，“重来”不计入。"
          }
        }
      }
    },
