    "access_permission_guidance.allowed" : {
      "comment" : "Guidance when permission is allowed",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إذا أردت إيقاف هذا الوصول، فافتح الإعدادات."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ak chcete tento prístup vypnúť, otvorte Nastavenia."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Če želite ta dostop izklopiti, odprite Nastavitve."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öppna Inställningar om du vill stänga av åtkomsten."
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਇਹ ਪਹੁੰਚ ਬੰਦ ਕਰਨ ਲਈ ਸੈਟਿੰਗਾਂ ਖੋਲ੍ਹੋ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otwórz Ustawienia, jeśli chcesz wyłączyć ten dostęp."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deschide Configurări dacă vrei să dezactivezi acest acces."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हा प्रवेश बंद करायचा असल्यास सेटिंग्ज उघडा."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Åpne Innstillinger hvis du vil slå av denne tilgangen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open Instellingen als je deze toegang wilt uitschakelen."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Norėdami išjungti šią prieigą, atidarykite nustatymus."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lai izslēgtu šo piekļuvi, atveriet iestatījumus."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ഈ അനുമതി ഓഫാക്കാൻ ക്രമീകരണങ്ങൾ തുറക്കുക."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apri Impostazioni per disattivare questo accesso."
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಈ ಪ್ರವೇಶವನ್ನು ನಿಲ್ಲಿಸಲು ಸೆಟ್ಟಿಂಗ್‌ಗಳನ್ನು ತೆರೆಯಿರಿ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 접근을 끄려면 설정을 여세요."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A hozzáférés kikapcsolásához nyisd meg a Beállításokat."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buka Pengaturan untuk menonaktifkan akses ini."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opnaðu Stillingar ef þú vilt slökkva á þessum aðgangi."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "આ ઍક્સેસ બંધ કરવા માટે સેટિંગ્સ ખોલો."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כדי לבטל את הגישה, יש לפתוח את ההגדרות."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otvorite Postavke ako želite isključiti ovaj pristup."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kui soovid selle juurdepääsu välja lülitada, ava seaded."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اگر می‌خواهید این دسترسی را غیرفعال کنید، تنظیمات را باز کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avaa asetukset, jos haluat poistaa tämän käyttöoikeuden."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отворете Настройки, ако искате да изключите този достъп."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনি যদি এই অ্যাক্সেস বন্ধ করতে চান তবে সেটিংস খুলুন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obriu Configuració si voleu desactivar aquest accés."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokud chcete tento přístup vypnout, otevřete Nastavení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Åbn Indstillinger, hvis du vil slå denne adgang fra."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ανοίξτε τις Ρυθμίσεις για να απενεργοποιήσετε αυτήν την πρόσβαση."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffne die Einstellungen, wenn du diesen Zugriff deaktivieren möchtest."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open Settings if you want to turn this access off."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre Ajustes si quieres desactivar este acceso."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre Ajustes si quieres desactivar este acceso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvrez Réglages si vous souhaitez désactiver cet accès."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अगर आप यह एक्सेस बंद करना चाहते हैं, तो सेटिंग्स खोलें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このアクセスをオフにするには、「設定」を開いてください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abra os Ajustes se quiser desativar esse acesso."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Откройте «Настройки», если хотите отключить этот доступ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果你想关闭此访问权限，请打开“设置”。"
          }
        }
      }
    },
    "access_permission_guidance.ask_every_time" : {
      "comment" : "Guidance when permission has not been requested yet",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اطلب الوصول الآن، أو افتح الإعدادات لاحقًا إذا أردت إدارته يدويًا."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Požiadajte o prístup teraz alebo ho neskôr spravujte ručne v Nastaveniach."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dostop zahtevajte zdaj ali ga pozneje ročno uredite v Nastavitvah."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Begär åtkomst nu eller hantera den manuellt i Inställningar senare."
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਹੁਣੇ ਪਹੁੰਚ ਮੰਗੋ ਜਾਂ ਇਸਨੂੰ ਖੁਦ ਸੰਭਾਲਣ ਲਈ ਬਾਅਦ ਵਿੱਚ ਸੈਟਿੰਗਾਂ ਖੋਲ੍ਹੋ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poproś o dostęp teraz lub otwórz Ustawienia później, aby zarządzać nim ręcznie."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solicită acces acum sau deschide Configurări mai târziu pentru a-l gestiona manual."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आता प्रवेशाची विनंती करा किंवा स्वतः व्यवस्थापित करण्यासाठी नंतर सेटिंग्ज उघडा."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Be om tilgang nå, eller åpne Innstillinger senere hvis du vil administrere den selv."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vraag nu toegang aan of open later Instellingen om dit zelf te beheren."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prašykite prieigos dabar arba vėliau atidarykite nustatymus ir valdykite ją patys."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pieprasiet piekļuvi tagad vai vēlāk pārvaldiet to iestatījumos."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ഇപ്പോൾ അനുമതി അഭ്യർത്ഥിക്കുക, അല്ലെങ്കിൽ പിന്നീട് ക്രമീകരണങ്ങളിൽ അത് നിയന്ത്രിക്കുക."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Richiedi l’accesso ora oppure apri Impostazioni in seguito per gestirlo manualmente."
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಈಗ ಪ್ರವೇಶವನ್ನು ವಿನಂತಿಸಿ ಅಥವಾ ನಂತರ ಕೈಯಾರೆ ನಿರ್ವಹಿಸಲು ಸೆಟ್ಟಿಂಗ್‌ಗಳನ್ನು ತೆರೆಯಿರಿ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지금 접근을 요청하거나 나중에 설정에서 직접 관리하세요."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kérj hozzáférést most, vagy kezeld később a Beállításokban."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minta akses sekarang, atau buka Pengaturan nanti untuk mengelolanya secara manual."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Óskaðu eftir aðgangi núna eða opnaðu Stillingar síðar til að stjórna honum handvirkt."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "હમણાં ઍક્સેસની વિનંતી કરો અથવા તેને જાતે સંચાલિત કરવા પછી સેટિંગ્સ ખોલો."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אפשר לבקש גישה כעת, או לפתוח את ההגדרות בהמשך לניהול ידני שלה."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zatražite pristup sada ili otvorite Postavke kasnije da biste njime upravljali ručno."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taotle juurdepääsu kohe või ava seaded hiljem, et seda käsitsi hallata."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اکنون درخواست دسترسی دهید یا برای مدیریت دستی آن بعداً تنظیمات را باز کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pyydä käyttöoikeutta nyt tai hallitse sitä myöhemmin asetuksissa."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поискайте достъп сега или отворете Настройки по-късно, ако искате да го управлявате ръчно."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এখনই অ্যাক্সেসের জন্য অনুরোধ করুন, অথবা আপনি যদি ম্যানুয়ালি এটি পরিচালনা করতে চান তাহলে পরে সেটিংস খুলুন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sol·liciteu accés ara o obriu Configuració més tard si voleu gestionar-lo manualment."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Požádejte o přístup nyní, nebo jej později spravujte ručně v Nastavení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anmod om adgang nu, eller administrer den senere manuelt i Indstillinger."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ζητήστε πρόσβαση τώρα ή διαχειριστείτε τη χειροκίνητα αργότερα στις Ρυθμίσεις."
          }
        },
