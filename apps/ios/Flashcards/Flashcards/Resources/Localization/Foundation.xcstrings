    "technical_error.generic.message" : {
      "comment" : "Generic technical error sheet user-safe message",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حاول مرة أخرى. إذا استمرت المشكلة، شارك التفاصيل الفنية مع الدعم."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ફરી પ્રયાસ કરો. આવું ચાલુ રહે તો ટેક્નિકલ વિગતો સપોર્ટ સાથે શેર કરો."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "יש לנסות שוב. אם הבעיה נמשכת, כדאי לשתף את הפרטים הטכניים עם התמיכה."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokušajte ponovno. Ako se problem ponavlja, podijelite tehničke pojedinosti s podrškom."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proovi uuesti. Kui viga kordub, jaga tehnilisi üksikasju kasutajatoega."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "دوباره امتحان کنید. اگر مشکل ادامه داشت، جزئیات فنی را با پشتیبانی به اشتراک بگذارید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yritä uudelleen. Jos ongelma jatkuu, jaa tekniset tiedot tuen kanssa."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Опитайте отново. Ако продължава да се случва, споделете техническите подробности с поддръжката."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আবার চেষ্টা করুন যদি এটি ঘটতে থাকে তবে সহায়তার সাথে প্রযুক্তিগত বিবরণ ভাগ করুন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Torna-ho a provar. Si continua passant, compartiu els detalls tècnics amb el suport."
          }
        },
