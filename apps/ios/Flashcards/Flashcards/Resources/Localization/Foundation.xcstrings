    "progress.friend_invite.display_name.footer" : {
      "comment" : "Footer explaining private friend invite display names and expiration",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أنت فقط ترى هذا الاسم في لوحة الصدارة لديك. يختار صديقك اسمك عند قبول الدعوة. تنتهي صلاحية روابط الدعوة خلال يومين."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toto meno vidíte v rebríčku iba vy. Pri prijatí si priateľ vyberie, ako vás pomenuje. Pozývacie odkazy vypršia o 2 dni."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To ime na svoji lestvici vidite le vi. Prijatelj ob sprejemu izbere ime za vas. Povezave s povabilom potečejo v 2 dneh."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bara du ser det här namnet på din topplista. Din vän väljer vad du ska kallas när inbjudan accepteras. Inbjudningslänkar går ut efter 2 dagar."
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਆਪਣੀ ਦਰਜਾਬੰਦੀ ਵਿੱਚ ਇਹ ਨਾਮ ਸਿਰਫ਼ ਤੁਹਾਨੂੰ ਦਿਸਦਾ ਹੈ। ਸੱਦਾ ਮੰਨਣ ਵੇਲੇ ਤੁਹਾਡਾ ਦੋਸਤ ਤੁਹਾਡੇ ਲਈ ਨਾਮ ਚੁਣਦਾ ਹੈ। ਸੱਦੇ ਦੇ ਲਿੰਕ 2 ਦਿਨਾਂ ਵਿੱਚ ਮਿਆਦ ਪੁਗਾਉਂਦੇ ਹਨ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tylko Ty widzisz tę nazwę w swoim rankingu. Znajomy wybierze nazwę dla Ciebie, gdy przyjmie zaproszenie. Linki zaproszeń wygasają po 2 dniach."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doar tu vezi acest nume în clasamentul tău. Prietenul alege cum să te numească la acceptare. Linkurile de invitație expiră în 2 zile."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तुमच्या क्रमवारीत हे नाव फक्त तुम्हालाच दिसते. आमंत्रण स्वीकारताना मित्र तुमच्यासाठी नाव निवडतो. आमंत्रण लिंकची मुदत 2 दिवसांत संपते."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bare du ser dette navnet i rangeringen din. Vennen velger hva du skal hete når invitasjonen godtas. Invitasjonslenker utløper etter 2 dager."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alleen jij ziet deze naam in je klassement. Je vriend kiest bij het accepteren hoe jij wordt genoemd. Uitnodigingslinks verlopen na 2 dagen."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Šį vardą savo lyderių lentelėje matote tik jūs. Priimdamas kvietimą draugas pasirenka, kaip jus vadinti. Kvietimo nuorodos galioja 2 dienas."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Šo vārdu savā līderu sarakstā redzat tikai jūs. Pieņemot uzaicinājumu, draugs izvēlas, kā jūs saukt. Uzaicinājuma saites derīgas 2 dienas."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ലീഡർബോർഡിലെ ഈ പേര് നിങ്ങൾക്ക് മാത്രം കാണാം. ക്ഷണം സ്വീകരിക്കുമ്പോൾ നിങ്ങളെ എന്ത് വിളിക്കണമെന്ന് സുഹൃത്ത് തിരഞ്ഞെടുക്കും. ക്ഷണ ലിങ്കുകൾ 2 ദിവസത്തിൽ കാലഹരണപ്പെടും."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo tu vedi questo nome nella tua classifica. Il tuo amico sceglierà come chiamarti quando accetterà. I link d’invito scadono dopo 2 giorni."
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ನಿಮ್ಮ ಶ್ರೇಯಾಂಕಪಟ್ಟಿಯಲ್ಲಿ ಈ ಹೆಸರು ನಿಮಗೆ ಮಾತ್ರ ಕಾಣುತ್ತದೆ. ಆಹ್ವಾನ ಸ್ವೀಕರಿಸುವಾಗ ಸ್ನೇಹಿತರು ನಿಮಗೆ ಯಾವ ಹೆಸರು ಕೊಡಬೇಕೆಂದು ಆಯ್ಕೆಮಾಡುತ್ತಾರೆ. ಆಹ್ವಾನ ಲಿಂಕ್‌ಗಳು 2 ದಿನಗಳಲ್ಲಿ ಅವಧಿ ಮೀರುತ್ತವೆ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 이름은 내 순위표에서 나에게만 보입니다. 친구는 초대를 수락할 때 내 이름을 정합니다. 초대 링크는 2일 후 만료됩니다."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ezt a nevet csak te látod a ranglistádon. A barátod az elfogadáskor ad neked nevet. A meghívó 2 nap múlva lejár."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hanya Anda yang melihat nama ini di papan peringkat Anda. Teman memilih nama Anda saat menerima undangan. Tautan undangan kedaluwarsa dalam 2 hari."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aðeins þú sérð þetta nafn á stigatöflunni þinni. Vinurinn velur hvað þú heitir þegar boðið er samþykkt. Boðstenglar renna út eftir 2 daga."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "તમારી ક્રમાંક યાદીમાં આ નામ ફક્ત તમને દેખાશે. સ્વીકારતી વખતે તમારો મિત્ર તમારું નામ પસંદ કરશે. આમંત્રણની લિંક 2 દિવસમાં સમાપ્ત થાય છે."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "רק לך יוצג השם הזה בטבלת הדירוג שלך. בעת קבלת ההזמנה, החבר בוחר איך לקרוא לך. קישורי הזמנה פגים אחרי יומיים."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Samo vi vidite ovo ime na svojoj ljestvici. Prijatelj pri prihvaćanju bira kako će vas nazvati. Poveznice s pozivnicom istječu za 2 dana."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ainult sina näed seda nime oma edetabelis. Sõber valib kutse vastuvõtmisel, kuidas sind nimetada. Kutselingid aeguvad 2 päeva pärast."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فقط شما این نام را در جدول رتبه‌بندی خود می‌بینید. دوستتان هنگام پذیرش دعوت، نامی برای شما انتخاب می‌کند. پیوندهای دعوت پس از ۲ روز منقضی می‌شوند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vain sinä näet tämän nimen tulostaulukossasi. Ystäväsi valitsee sinulle nimen hyväksyessään kutsun. Kutsulinkit vanhenevat 2 päivässä."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Само вие виждате това име в класацията си. При приемане приятелят ви избира с какво име да ви вижда. Връзките за покана изтичат след 2 дни."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনার লিডারবোর্ডে এই নামটি শুধু আপনিই দেখবেন। আমন্ত্রণ গ্রহণের সময় আপনার বন্ধু আপনাকে কোন নামে দেখবেন তা বেছে নেবেন। আমন্ত্রণের লিঙ্কের মেয়াদ ২ দিন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Només tu veus aquest nom a la teva classificació. En acceptar, el teu amic tria amb quin nom et vol veure. Els enllaços d’invitació caduquen al cap de 2 dies."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toto jméno ve svém žebříčku vidíte jen vy. Přítel při přijetí pozvánky zvolí jméno pro vás. Platnost pozvánek vyprší za 2 dny."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun du ser dette navn på din rangliste. Din ven vælger et navn til dig ved accept. Invitationslinks udløber efter 2 dage."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μόνο εσείς βλέπετε αυτό το όνομα στην κατάταξή σας. Ο φίλος σας επιλέγει πώς θα σας ονομάζει όταν αποδεχτεί την πρόσκληση. Οι σύνδεσμοι πρόσκλησης λήγουν σε 2 ημέρες."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur du siehst diesen Namen in deiner Bestenliste. Dein Freund wählt beim Annehmen aus, wie er dich nennt. Einladungslinks laufen in 2 Tagen ab."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only you see this name in your leaderboard. Your friend chooses what to call you when accepting. Invite links expire in 2 days."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo tú ves este nombre en tu tabla de clasificación. Tu amigo elige cómo llamarte al aceptar. Los enlaces de invitación caducan en 2 días."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo tú ves este nombre en tu tabla de posiciones. Tu amigo elige cómo llamarte al aceptar. Los enlaces de invitación vencen en 2 días."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous seul voyez ce nom dans votre classement. Votre ami choisit le nom qu’il vous donne en acceptant. Les liens d’invitation expirent au bout de 2 jours."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह नाम केवल आपको अपने लीडरबोर्ड में दिखता है। स्वीकार करते समय आपका दोस्त चुनता है कि आपको क्या नाम देना है। आमंत्रण लिंक 2 दिनों में समाप्त हो जाते हैं।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この名前はあなたのリーダーボードにだけ表示されます。友だちは承認時にあなたの呼び名を選びます。招待リンクは2日で期限切れになります。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Só você vê este nome no seu ranking. Seu amigo escolhe como chamar você ao aceitar. Os links de convite expiram em 2 dias."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Только вы видите это имя в своей таблице лидеров. Друг выберет ваше имя у себя при принятии приглашения. Ссылки-приглашения истекают через 2 дня."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只有你会在自己的排行榜中看到这个名称。你的朋友接受邀请时会选择如何称呼你。邀请链接将在 2 天后过期。"
          }
        }
      }
    },
