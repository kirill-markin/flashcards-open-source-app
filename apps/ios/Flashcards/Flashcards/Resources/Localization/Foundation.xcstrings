    "technical_error.generic.message" : {
      "comment" : "Generic technical error sheet user-safe message",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حاول مرة أخرى. إذا استمرت المشكلة، شارك التفاصيل الفنية مع الدعم."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skúste to znova. Ak problém pretrváva, pošlite podpore technické podrobnosti."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poskusite znova. Če se težava ponavlja, podpori pošljite tehnične podrobnosti."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Försök igen. Om problemet kvarstår delar du de tekniska uppgifterna med supporten."
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਮੁੜ ਕੋਸ਼ਿਸ਼ ਕਰੋ। ਜੇ ਇਹ ਹੁੰਦਾ ਰਹੇ ਤਾਂ ਤਕਨੀਕੀ ਵੇਰਵੇ ਸਹਾਇਤਾ ਟੀਮ ਨਾਲ ਸਾਂਝੇ ਕਰੋ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spróbuj ponownie. Jeśli problem się powtarza, prześlij szczegóły techniczne do pomocy technicznej."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Încearcă din nou. Dacă problema persistă, trimite detaliile tehnice echipei de asistență."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पुन्हा प्रयत्न करा. समस्या कायम राहिल्यास तांत्रिक तपशील सहाय्य टीमला पाठवा."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prøv igjen. Hvis det fortsetter, del de tekniske detaljene med brukerstøtten."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Probeer het opnieuw. Blijft het gebeuren, deel dan de technische details met de ondersteuning."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bandykite dar kartą. Jei tai kartojasi, pasidalykite technine informacija su pagalbos tarnyba."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mēģiniet vēlreiz. Ja problēma atkārtojas, nosūtiet tehnisko informāciju atbalsta dienestam."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "വീണ്ടും ശ്രമിക്കുക. ഇത് തുടരുകയാണെങ്കിൽ സാങ്കേതിക വിവരങ്ങൾ പിന്തുണാ സംഘവുമായി പങ്കിടുക."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riprova. Se il problema persiste, condividi i dettagli tecnici con l’assistenza."
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಮತ್ತೆ ಪ್ರಯತ್ನಿಸಿ. ಸಮಸ್ಯೆ ಮುಂದುವರಿದರೆ ತಾಂತ್ರಿಕ ವಿವರಗಳನ್ನು ಬೆಂಬಲ ತಂಡದೊಂದಿಗೆ ಹಂಚಿಕೊಳ್ಳಿ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다시 시도하세요. 문제가 계속되면 지원팀에 기술 세부 정보를 보내 주세요."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Próbáld újra. Ha a hiba továbbra is fennáll, küldd el a technikai részleteket az ügyfélszolgálatnak."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coba lagi. Jika terus terjadi, bagikan detail teknis kepada dukungan."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reyndu aftur. Ef þetta heldur áfram skaltu deila tæknilegum upplýsingum með þjónustuveri."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ફરી પ્રયાસ કરો. આવું ચાલુ રહે તો ટેક્નિકલ વિગતો સપોર્ટ સાથે શેર કરો."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "יש לנסות שוב. אם הבעיה נמשכת, כדאי לשתף את הפרטים הטכניים עם התמיכה."
          }
