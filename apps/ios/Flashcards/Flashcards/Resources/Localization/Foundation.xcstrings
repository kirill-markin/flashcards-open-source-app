    "progress.friend_invite.share_message" : {
      "comment" : "Message for sharing a created friend invite link",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "افتح دعوة Nibomo هذه، ثم سجّل الدخول أو أنشئ حسابًا، وسنرى بعضنا في التطبيق."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "આ Nibomo આમંત્રણ ખોલો, સાઇન-ઇન કરો અથવા નોંધણી કરો અને આપણે ઍપમાં એકબીજાને જોઈ શકીશું."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אפשר לפתוח את ההזמנה הזו ל-Nibomo, להיכנס או להירשם, ואז נראה זה את זה באפליקציה."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otvorite ovu Nibomo pozivnicu, prijavite se ili registrirajte i vidjet ćemo se u aplikaciji."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ava see Nibomo kutse, logi sisse või registreeru ning näeme teineteist rakenduses."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "این دعوت Nibomo را باز کنید، وارد شوید یا ثبت‌نام کنید تا یکدیگر را در برنامه ببینیم."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avaa tämä Nibomo-kutsu ja kirjaudu tai rekisteröidy, niin näemme toisemme sovelluksessa."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отворете тази покана за Nibomo, влезте или се регистрирайте и ще се виждаме в приложението."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nibomo-এর এই আমন্ত্রণটি খুলে সাইন ইন করুন বা নিবন্ধন করুন। তারপর আমরা অ্যাপে একে অপরকে দেখতে পাব।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obre aquesta invitació de Nibomo, inicia la sessió o registra’t i ens veurem a l’app."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otevřete tuto pozvánku do Nibomo, přihlaste se nebo si vytvořte účet a uvidíme se v aplikaci."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Åbn denne Nibomo-invitation, log ind eller opret en konto, så kan vi se hinanden i appen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ανοίξτε αυτήν την πρόσκληση στο Nibomo, συνδεθείτε ή εγγραφείτε και θα βλέπουμε ο ένας τον άλλον στην εφαρμογή."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffne diese Nibomo-Einladung, melde dich an oder registriere dich, und wir sehen uns in der App."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open this Nibomo invite, sign in or sign up, and we will see each other in the app."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre esta invitación de Nibomo, inicia sesión o regístrate, y nos veremos en la app."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre esta invitación de Nibomo, inicia sesión o regístrate, y nos veremos en la app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvrez cette invitation Nibomo, connectez-vous ou inscrivez-vous, et nous nous verrons dans l’app."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस Nibomo आमंत्रण को खोलें, साइन इन या साइन अप करें, और हम ऐप में एक-दूसरे को देखेंगे।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この Nibomo 招待を開き、サインインまたは登録してください。アプリ内でお互いを確認できます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abra este convite do Nibomo, entre ou crie uma conta, e vamos nos ver no app."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Открой эту ссылку-приглашение в Nibomo, войди или зарегистрируйся, и мы увидим друг друга в приложении."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "打开这个 Nibomo 邀请，登录或注册，然后我们就能在应用中看到彼此。"
          }
        }
      }
    },
