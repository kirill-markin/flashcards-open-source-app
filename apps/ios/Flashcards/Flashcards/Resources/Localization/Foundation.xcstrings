        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profiilit näkyvät vain, kun osallistut kertauksen tulostaulukkoon."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Профилите се виждат само докато участието в класацията по преговори е включено."
