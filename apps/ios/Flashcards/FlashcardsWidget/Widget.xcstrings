    "widget.year.gallery.description" : {
      "comment" : "Widget gallery description of the Year widget",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اعرض عامًا من المراجعات اليومية، صفًا لكل شهر."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вижте година ежедневни преговори, по ред за месец."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এক বছরের দৈনিক পুনরালোচনা দেখুন, প্রতি মাসে এক সারি।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consulta un any de repassos diaris, una fila per mes."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podívejte se na rok denních opakování, jeden řádek na měsíc."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se et år med daglige repetitioner, én række pr. måned."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sieh ein Jahr täglicher Wiederholungen, eine Zeile pro Monat."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δείτε έναν χρόνο καθημερινών επαναλήψεων, μία σειρά ανά μήνα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "See a year of daily reviews, one row per month."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consulta un año de repasos diarios, una fila por mes."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consulta un año de repasos diarios, una fila por mes."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaata aasta igapäevaseid kordamisi, üks rida kuu kohta."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "یک سال مرور روزانه را ببینید، هر ماه یک ردیف."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Näet vuoden päivittäiset kertaukset, yksi rivi kuukautta kohden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voyez une année de révisions quotidiennes, une ligne par mois."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "એક વર્ષનાં દૈનિક પુનરાવર્તનો જુઓ, દર મહિને એક પંક્તિ."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "שנה של חזרות יומיות, שורה לכל חודש."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पूरे साल की रोज़ की समीक्षाएं देखें, हर महीने की एक पंक्ति।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pogledajte godinu dnevnih ponavljanja, jedan red po mjesecu."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Egy év napi ismétlései, havonta egy sorban."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lihat setahun pengulangan harian, satu baris per bulan."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sjáðu ár af daglegum upprifjunum, eina röð á mánuð."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visualizza un anno di ripassi giornalieri, una riga per mese."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1年分の毎日の復習を、1か月1行で表示します。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಒಂದು ವರ್ಷದ ದೈನಂದಿನ ಪುನರಾವರ್ತನೆಗಳನ್ನು ನೋಡಿ, ತಿಂಗಳಿಗೆ ಒಂದು ಸಾಲು."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1년간의 일일 복습을 한 달에 한 줄씩 보여 줍니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peržiūrėkite metų kasdienius kartojimus, po eilutę kiekvienam mėnesiui."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skatiet gada ikdienas atkārtojumus, viena rinda katram mēnesim."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
