    "widget.month_calendar.gallery.description" : {
      "comment" : "Widget gallery description of the Calendar widget",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اعرض الأيام التي راجعت فيها هذا الشهر."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вижте дните, в които сте преговаряли този месец."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এই মাসে যেসব দিনে পুনরালোচনা করেছেন সেগুলো দেখুন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consulta els dies que has repassat aquest mes."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podívejte se, ve které dny tohoto měsíce jste opakovali."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se de dage, du har repeteret i denne måned."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sieh, an welchen Tagen du diesen Monat wiederholt hast."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δείτε τις ημέρες που κάνατε επανάληψη αυτόν τον μήνα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "See the days you reviewed this month."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consulta los días que repasaste este mes."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consulta los días que repasaste este mes."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaata päevi, mil kordasid sel kuul."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "روزهایی از این ماه را که مرور کرده‌اید ببینید."
