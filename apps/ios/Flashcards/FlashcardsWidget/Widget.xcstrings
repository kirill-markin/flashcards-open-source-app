        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "உங்கள் வழக்கமான வேகத்துடன் ஒப்பிட்டு கடந்த 7 நாட்கள், இன்றைய மீள்பயிற்சிகள் மற்றும் உங்கள் தொடர் நாட்கள்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "మీ సాధారణ వేగంతో పోల్చి గత 7 రోజులు, ఈరోజు పునశ్చరణలు, మీ వరుస రోజులు."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "7 วันล่าสุดเทียบกับจังหวะปกติของคุณ การทบทวนวันนี้ และสถิติต่อเนื่อง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Olağan temponuza göre son 7 gün, bugünkü tekrarlar ve seriniz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Останні 7 днів порівняно зі звичним темпом, повторення за сьогодні і серія."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آپ کی معمول کی رفتار کے مقابلے میں پچھلے 7 دن، آج کی دہرائیاں اور آپ کے مسلسل دن۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "7 ngày qua so với nhịp thường ngày, lượt ôn hôm nay và chuỗi ngày."
