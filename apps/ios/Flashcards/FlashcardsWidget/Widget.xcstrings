            "value" : "Pozrite si aktuálnu sériu, najlepšiu sériu a nedávne série."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oglejte si trenutni niz, najboljši niz in nedavne nize."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se din aktuella svit, din bästa svit och dina senaste sviter."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ona mfululizo wako wa sasa, mfululizo bora na mifululizo ya karibuni."
