        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Progresso de hoje, cartões pendentes, sua sequência, a próxima pergunta e a atividade recente."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veja o progresso de hoje, os cartões por rever, a sua sequência, a próxima pergunta e a atividade recente."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Progresul de azi, fișele de recapitulat, seria ta, următoarea întrebare și activitatea recentă."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прогресс за сегодня, карточки к повторению, серия, следующий вопрос и недавняя активность."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dnešný pokrok, karty na opakovanie, vaša séria, ďalšia otázka a nedávna aktivita."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Današnji napredek, kartice za ponovitev, vaš niz, naslednje vprašanje in nedavna dejavnost."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dagens framsteg, kort att repetera, din svit, nästa fråga och senaste aktivitet."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maendeleo ya leo, kadi za kurudia, mfululizo wako, swali linalofuata na shughuli za karibuni."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "இன்றைய முன்னேற்றம், உரிய அட்டைகள், உங்கள் தொடர் நாட்கள், அடுத்த கேள்வி மற்றும் சமீபத்திய செயல்பாடு."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ఈరోజు పురోగతి, పునశ్చరణ కార్డులు, మీ వరుస రోజులు, తదుపరి ప్రశ్న, ఇటీవలి కార్యాచరణ."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ความคืบหน้าวันนี้ การ์ดที่ถึงกำหนด สถิติต่อเนื่อง คำถามถัดไป และกิจกรรมล่าสุด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bugünkü ilerleme, tekrar edilecek kartlar, seriniz, sonraki soru ve son etkinlik."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прогрес за сьогодні, картки до повторення, серія, наступне запитання й нещодавня активність."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آج کی پیش رفت، دہرائی والے کارڈز، آپ کے مسلسل دن، اگلا سوال اور حالیہ سرگرمی۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiến độ hôm nay, thẻ đến hạn, chuỗi ngày, câu hỏi tiếp theo và hoạt động gần đây."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今日进度、待复习卡片、连续记录、下一个问题和近期活动。"
          }
