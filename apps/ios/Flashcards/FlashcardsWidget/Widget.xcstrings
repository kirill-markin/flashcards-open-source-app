    "widget.reviews_chart.gallery.description" : {
      "comment" : "Widget gallery description of the Reviews chart widget",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اعرض مراجعاتك اليومية مقارنةً بالفترة السابقة."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вижте ежедневните си преговори в сравнение с предходния период."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আগের সময়ের তুলনায় আপনার দৈনিক পুনরালোচনা দেখুন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consulta els teus repassos diaris comparats amb el període anterior."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podívejte se na denní opakování ve srovnání s předchozím obdobím."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se dine daglige repetitioner sammenlignet med perioden før."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sieh deine täglichen Wiederholungen im Vergleich zum Zeitraum davor."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δείτε τις καθημερινές επαναλήψεις σε σύγκριση με την προηγούμενη περίοδο."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "See your daily reviews and how they compare with the period before."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consulta tus repasos diarios comparados con el periodo anterior."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consulta tus repasos diarios comparados con el periodo anterior."
          }
        },
