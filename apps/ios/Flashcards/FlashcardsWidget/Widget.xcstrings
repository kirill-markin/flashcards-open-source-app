    "widget.gallery.description" : {
      "comment" : "Widget gallery description of the Home Screen Review widget",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اعرف عدد البطاقات المستحقة والسؤال التالي."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вижте колко карти чакат преговор и следващия въпрос."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "কতগুলো কার্ডের পুনরালোচনার সময় হয়েছে এবং পরের প্রশ্নটি দেখুন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consulta quantes targetes tens pendents i la pregunta següent."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podívejte se, kolik kartiček čeká na opakování, a na další otázku."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se, hvor mange kort der er klar til repetition, og det næste spørgsmål."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sieh, wie viele Karten fällig sind, und die nächste Frage."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δείτε πόσες κάρτες είναι προς επανάληψη και την επόμενη ερώτηση."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "See how many cards are due and the next question."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consulta cuántas tarjetas tienes pendientes y la siguiente pregunta."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consulta cuántas tarjetas tienes pendientes y la siguiente pregunta."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaata, mitu kaarti on kordamiseks valmis, ja järgmist küsimust."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ببینید موعد مرور چند کارت رسیده و سؤال بعدی چیست."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Näet, montako korttia on erääntynyt, ja seuraavan kysymyksen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voyez combien de cartes sont à réviser et la question suivante."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "કેટલાં કાર્ડ બાકી છે અને આગળનો પ્રશ્ન જુઓ."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אפשר לראות כמה כרטיסיות ממתינות לחזרה ואת השאלה הבאה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
