    "widget.today.gallery.description" : {
      "comment" : "Widget gallery description of the Today widget",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آخر 7 أيام مقارنةً بمعدلك المعتاد، ومراجعات اليوم، وسلسلتك."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Последните 7 дни спрямо обичайното ви темпо, днешните преговори и поредицата ви."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনার স্বাভাবিকের তুলনায় গত 7 দিন, আজকের পুনরালোচনা এবং আপনার ধারাবাহিকতা।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Els darrers 7 dies respecte al teu ritme habitual, els repassos d’avui i la teva ratxa."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Posledních 7 dní ve srovnání s vaším obvyklým tempem, dnešní opakování a vaše série."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De seneste 7 dage i forhold til dit sædvanlige tempo, dagens repetitioner og din læringsserie."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die letzten 7 Tage im Vergleich zu deinem üblichen Tempo, heutige Wiederholungen und deine Serie."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι τελευταίες 7 ημέρες σε σχέση με τον συνηθισμένο ρυθμό σας, οι σημερινές επαναλήψεις και το σερί σας."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The last 7 days against your usual, today’s reviews and your streak."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The last 7 days against your usual, today’s reviews and your streak."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The last 7 days against your usual, today’s reviews and your streak."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The last 7 days against your usual, today’s reviews and your streak."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los últimos 7 días frente a tu ritmo habitual, los repasos de hoy y tu racha."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los últimos 7 días frente a tu ritmo habitual, los repasos de hoy y tu racha."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viimased 7 päeva võrreldes su tavapärase tempoga, tänased kordamised ja päevade jada."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "۷ روز اخیر در مقایسه با روال همیشگی شما، مرورهای امروز و روزهای پیاپی شما."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viimeiset 7 päivää tavalliseen tahtiisi verrattuna, päivän kertaukset ja päiväputkesi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les 7 derniers jours par rapport à votre rythme habituel, les révisions du jour et votre série."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les 7 derniers jours par rapport à votre rythme habituel, les révisions du jour et votre série."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "તમારી સામાન્ય ગતિની સરખામણીએ છેલ્લા 7 દિવસ, આજનાં પુનરાવર્તનો અને તમારો સતત અભ્યાસ."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "7 הימים האחרונים לעומת הקצב הרגיל שלך, החזרות היום והרצף שלך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपकी सामान्य रफ़्तार की तुलना में पिछले 7 दिन, आज की समीक्षाएं और आपकी स्ट्रीक।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zadnjih 7 dana u odnosu na vaš uobičajeni tempo, današnja ponavljanja i vaš niz."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az utolsó 7 nap a szokásos tempódhoz képest, a mai ismétlések és a sorozatod."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "7 hari terakhir dibandingkan kebiasaan Anda, pengulangan hari ini, dan rangkaian Anda."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Síðustu 7 dagar miðað við venjulegan hraða þinn, upprifjanir dagsins og runan þín."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli ultimi 7 giorni rispetto al tuo ritmo abituale, i ripassi di oggi e la tua serie."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "直近7日間をいつものペースと比較、今日の復習数、連続記録。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ನಿಮ್ಮ ಸಾಮಾನ್ಯ ವೇಗಕ್ಕೆ ಹೋಲಿಸಿ ಕಳೆದ 7 ದಿನಗಳು, ಇಂದಿನ ಪುನರಾವರ್ತನೆಗಳು ಮತ್ತು ನಿಮ್ಮ ನಿರಂತರತೆ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "최근 7일을 평소 페이스와 비교하고 오늘의 복습과 연속 학습을 보여 줍니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paskutinės 7 dienos, palyginti su įprastu jūsų tempu, šiandienos kartojimai ir jūsų serija."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pēdējās 7 dienas salīdzinājumā ar jūsu ierasto tempu, šodienas atkārtojumi un jūsu sērija."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "നിങ്ങളുടെ പതിവ് വേഗവുമായി താരതമ്യം ചെയ്ത് കഴിഞ്ഞ 7 ദിവസം, ഇന്നത്തെ ആവർത്തനങ്ങൾ, നിങ്ങളുടെ തുടർച്ച."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तुमच्या नेहमीच्या वेगाच्या तुलनेत मागील 7 दिवस, आजच्या उजळण्या आणि तुमचे सलग दिवस."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "7 hari terakhir berbanding kebiasaan anda, ulang kaji hari ini dan rekod berturut-turut anda."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De siste 7 dagene sammenlignet med ditt vanlige tempo, dagens repetisjoner og dagrekken din."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De afgelopen 7 dagen vergeleken met je gebruikelijke tempo, herhalingen van vandaag en je dagreeks."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଆପଣଙ୍କ ସାଧାରଣ ଗତି ତୁଳନାରେ ଗତ 7 ଦିନ, ଆଜିର ପୁନରାବୃତ୍ତି ଓ କ୍ରମାଗତ ଦିନ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਤੁਹਾਡੀ ਆਮ ਰਫ਼ਤਾਰ ਦੇ ਮੁਕਾਬਲੇ ਪਿਛਲੇ 7 ਦਿਨ, ਅੱਜ ਦੀਆਂ ਦੁਹਰਾਈਆਂ ਅਤੇ ਤੁਹਾਡੀ ਲੜੀ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ostatnie 7 dni na tle Twojego zwykłego tempa, dzisiejsze powtórki i Twoja seria."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os últimos 7 dias em relação ao seu ritmo habitual, as revisões de hoje e sua sequência."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os últimos 7 dias em relação ao seu ritmo habitual, as revisões de hoje e a sua sequência."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ultimele 7 zile față de ritmul tău obișnuit, recapitulările de azi și seria ta."
