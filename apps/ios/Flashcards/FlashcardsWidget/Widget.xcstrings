  "strings" : {
    "widget.activity.gallery.description" : {
      "comment" : "Widget gallery description of the Activity heatmap widget",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اعرض مراجعاتك اليومية وسلسلتك على خريطة حرارية."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вижте ежедневните си преговори и поредицата си на топлинна карта."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "হিটম্যাপে আপনার দৈনিক পুনরালোচনা ও ধারাবাহিকতা দেখুন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consulta els teus repassos diaris i la teva ratxa en un mapa de calor."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podívejte se na denní opakování a sérii v teplotní mapě."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se dine daglige repetitioner og din læringsserie på et varmekort."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sieh deine täglichen Wiederholungen und deine Serie als Heatmap."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
