    "widget.dashboard.gallery.description" : {
      "comment" : "Widget gallery description of the Dashboard widget",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تقدم اليوم والبطاقات المستحقة وسلسلتك والسؤال التالي والنشاط الأخير."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Днешният напредък, картите за преговор, поредицата ви, следващият въпрос и скорошната активност."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আজকের অগ্রগতি, বাকি কার্ড, আপনার ধারাবাহিকতা, পরের প্রশ্ন এবং সাম্প্রতিক কার্যকলাপ।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Progrés d’avui, targetes pendents, la teva ratxa, la pregunta següent i l’activitat recent."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dnešní pokrok, kartičky k opakování, vaše série, další otázka a nedávná aktivita."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dagens fremskridt, kort til repetition, din læringsserie, det næste spørgsmål og seneste aktivitet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heutiger Fortschritt, fällige Karten, deine Serie, die nächste Frage und letzte Aktivität."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σημερινή πρόοδος, κάρτες προς επανάληψη, το σερί σας, η επόμενη ερώτηση και η πρόσφατη δραστηριότητα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Today’s progress, cards due, your streak, the next question and recent activity."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Today’s progress, cards due, your streak, the next question and recent activity."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Today’s progress, cards due, your streak, the next question and recent activity."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Today’s progress, cards due, your streak, the next question and recent activity."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Progreso de hoy, tarjetas pendientes, tu racha, la siguiente pregunta y la actividad reciente."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Progreso de hoy, tarjetas pendientes, tu racha, la siguiente pregunta y la actividad reciente."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tänane edenemine, korratavad kaardid, päevade jada, järgmine küsimus ja hiljutine aktiivsus."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "پیشرفت امروز، کارت‌های آمادهٔ مرور، روزهای پیاپی، سؤال بعدی و فعالیت اخیر."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Päivän edistyminen, erääntyneet kortit, päiväputki, seuraava kysymys ja viimeaikainen aktiivisuus."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Progrès du jour, cartes à réviser, votre série, la question suivante et l’activité récente."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Progrès du jour, cartes à réviser, votre série, la question suivante et l’activité récente."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "આજની પ્રગતિ, બાકી કાર્ડ, તમારો સતત અભ્યાસ, આગળનો પ્રશ્ન અને તાજેતરની પ્રવૃત્તિ."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ההתקדמות היום, כרטיסיות לחזרה, הרצף שלך, השאלה הבאה והפעילות האחרונה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आज की प्रगति, देय कार्ड, आपकी स्ट्रीक, अगला प्रश्न और हाल की गतिविधि।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Današnji napredak, dospjele kartice, vaš niz, sljedeće pitanje i nedavna aktivnost."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A mai haladás, az esedékes kártyák, a sorozatod, a következő kérdés és a legutóbbi aktivitás."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kemajuan hari ini, kartu jatuh tempo, rangkaian Anda, pertanyaan berikutnya, dan aktivitas terbaru."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Framvinda dagsins, spjöld á dagskrá, runan þín, næsta spurning og nýleg virkni."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Progressi di oggi, schede da ripassare, la tua serie, la prossima domanda e l’attività recente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今日の進捗、復習待ちのカード、連続記録、次の問題、最近のアクティビティ。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಇಂದಿನ ಪ್ರಗತಿ, ಬಾಕಿ ಕಾರ್ಡ್‌ಗಳು, ನಿಮ್ಮ ನಿರಂತರತೆ, ಮುಂದಿನ ಪ್ರಶ್ನೆ ಮತ್ತು ಇತ್ತೀಚಿನ ಚಟುವಟಿಕೆ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오늘의 진행 상황, 복습할 카드, 연속 학습, 다음 질문과 최근 활동을 보여 줍니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Šiandienos pažanga, kartotinos kortelės, jūsų serija, kitas klausimas ir naujausia veikla."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Šodienas progress, atkārtojamās kartītes, jūsu sērija, nākamais jautājums un nesenā aktivitāte."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ഇന്നത്തെ പുരോഗതി, ആവർത്തിക്കാനുള്ള കാർഡുകൾ, നിങ്ങളുടെ തുടർച്ച, അടുത്ത ചോദ്യം, സമീപകാല പ്രവർത്തനം."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आजची प्रगती, उजळणी बाकी असलेली कार्डे, तुमचे सलग दिवस, पुढचा प्रश्न आणि अलीकडील क्रियाकलाप."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lihat kemajuan hari ini, kad untuk diulang kaji, rekod berturut-turut, soalan seterusnya dan aktiviti terkini."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dagens fremdrift, kort til repetisjon, dagrekken din, neste spørsmål og nylig aktivitet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voortgang van vandaag, te herhalen kaarten, je dagreeks, de volgende vraag en recente activiteit."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଆଜିର ପ୍ରଗତି, ବାକି କାର୍ଡ, କ୍ରମାଗତ ଦିନ, ପରବର୍ତ୍ତୀ ପ୍ରଶ୍ନ ଓ ନିକଟର କାର୍ଯ୍ୟକଳାପ ଦେଖନ୍ତୁ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਅੱਜ ਦੀ ਤਰੱਕੀ, ਦੁਹਰਾਈ ਵਾਲੇ ਕਾਰਡ, ਤੁਹਾਡੀ ਲੜੀ, ਅਗਲਾ ਸਵਾਲ ਅਤੇ ਹਾਲੀਆ ਸਰਗਰਮੀ।"
