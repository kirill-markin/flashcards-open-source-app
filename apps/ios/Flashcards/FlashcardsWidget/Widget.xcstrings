        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Последние 7 дней в сравнении с привычным темпом, повторения за сегодня и серия."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Posledných 7 dní v porovnaní s vaším obvyklým tempom, dnešné opakovania a vaša séria."
