    "widget.dashboard.gallery.description" : {
      "comment" : "Widget gallery description of the Dashboard widget",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تقدم اليوم والبطاقات المستحقة وسلسلتك والسؤال التالي والنشاط الأخير."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Днешният напредък, картите за преговор, поредицата ви, следващият въпрос и скорошната активност."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আজকের অগ্রগতি, বাকি কার্ড, আপনার ধারাবাহিকতা, পরের প্রশ্ন এবং সাম্প্রতিক কার্যকলাপ।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Progrés d’avui, targetes pendents, la teva ratxa, la pregunta següent i l’activitat recent."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dnešní pokrok, kartičky k opakování, vaše série, další otázka a nedávná aktivita."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dagens fremskridt, kort til repetition, din læringsserie, det næste spørgsmål og seneste aktivitet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heutiger Fortschritt, fällige Karten, deine Serie, die nächste Frage und letzte Aktivität."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σημερινή πρόοδος, κάρτες προς επανάληψη, το σερί σας, η επόμενη ερώτηση και η πρόσφατη δραστηριότητα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Today’s progress, cards due, your streak, the next question and recent activity."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Progreso de hoy, tarjetas pendientes, tu racha, la siguiente pregunta y la actividad reciente."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Progreso de hoy, tarjetas pendientes, tu racha, la siguiente pregunta y la actividad reciente."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tänane edenemine, korratavad kaardid, päevade jada, järgmine küsimus ja hiljutine aktiivsus."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "پیشرفت امروز، کارت‌های آمادهٔ مرور، روزهای پیاپی، سؤال بعدی و فعالیت اخیر."
