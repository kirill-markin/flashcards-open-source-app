        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಎಷ್ಟು ಕಾರ್ಡ್‌ಗಳು ಪುನರಾವರ್ತನೆಗೆ ಬಾಕಿ ಇವೆ ಮತ್ತು ಮುಂದಿನ ಪ್ರಶ್ನೆಯನ್ನು ನೋಡಿ."
