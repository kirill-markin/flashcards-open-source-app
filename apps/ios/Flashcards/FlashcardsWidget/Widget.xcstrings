        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "உங்கள் தற்போதைய, சிறந்த மற்றும் சமீபத்திய தொடர் நாட்களைப் பாருங்கள்."
          }
        },
        "te" : {
          "stringUnit" : {
