    "widget.reviews_chart.gallery.description" : {
      "comment" : "Widget gallery description of the Reviews chart widget",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اعرض مراجعاتك اليومية لآخر 7 أيام مقارنةً بمعدلك المعتاد."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вижте ежедневните си преговори за последните 7 дни спрямо обичайното ви темпо."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনার স্বাভাবিকের তুলনায় গত 7 দিনের দৈনিক পুনরালোচনা দেখুন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consulta els teus repassos diaris dels darrers 7 dies respecte al teu ritme habitual."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podívejte se na denní opakování za posledních 7 dní ve srovnání s vaším obvyklým tempem."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se dine daglige repetitioner de seneste 7 dage i forhold til dit sædvanlige tempo."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sieh deine täglichen Wiederholungen der letzten 7 Tage im Vergleich zu deinem üblichen Tempo."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δείτε τις καθημερινές επαναλήψεις των τελευταίων 7 ημερών σε σχέση με τον συνηθισμένο ρυθμό σας."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "See your daily reviews of the last 7 days against your usual."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "See your daily reviews of the last 7 days against your usual."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "See your daily reviews of the last 7 days against your usual."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "See your daily reviews of the last 7 days against your usual."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consulta tus repasos diarios de los últimos 7 días frente a tu ritmo habitual."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consulta tus repasos diarios de los últimos 7 días frente a tu ritmo habitual."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaata viimase 7 päeva igapäevaseid kordamisi võrreldes su tavapärase tempoga."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
