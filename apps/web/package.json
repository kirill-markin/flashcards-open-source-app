{
  "name": "flashcards-open-source-app-web",
  "version": "1.42.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "FLASHCARDS_E2E_TARGET=prod playwright test",
    "test:e2e:local": "node ./scripts/check-local-e2e-stack.mjs && FLASHCARDS_E2E_TARGET=local playwright test",
    "test:e2e:prod": "FLASHCARDS_E2E_TARGET=prod playwright test"
  },
  "dependencies": {
    "@floating-ui/react-dom": "^2.1.9",
    "@kirill-markin/ratex-wasm": "https://github.com/kirill-markin/RaTeX/releases/download/fork-packages-0.1.15-1/kirill-markin-ratex-wasm-0.1.15-fork.1.tgz",
    "@sentry/react": "^11.12.0",
    "heic-to": "^1.6.7",
    "lottie-web": "^5.13.0",
    "micromark": "^4.0.3",
    "micromark-util-decode-string": "^2.0.1",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-router": "^8.5.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "6.0.0",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.2.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@sentry/vite-plugin": "^11.12.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "fake-indexeddb": "^6.2.8",
    "jsdom": "30.1.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "5.1.0"
  },
  "overrides": {
    "micromark-extension-math": {
      "katex": "0.19.1"
    },
    "@sentry/bundler-plugins": {
      "glob": "14.0.3"
    }
  },
  "engines": {
    "node": ">=24.22.2 <25"
  }
