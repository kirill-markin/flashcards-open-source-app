{
  "name": "flashcards-open-source-app-backend",
  "version": "1.33.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/entrypoints/index.ts",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc",
    "start": "node dist/entrypoints/index.js",
    "lint": "tsc --noEmit",
    "test": "node scripts/run-tests.mjs",
    "test:postgres-integration": "node scripts/run-postgres-integrations.mjs",
    "test:mcp": "node --test --import tsx src/entrypoints/lambda-mcp.test.ts src/mcp/server.test.ts"
  },
  "dependencies": {
    "@apple/app-store-server-library": "3.1.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.1147.0",
    "@aws-sdk/client-dynamodb": "^3.1147.0",
    "@aws-sdk/client-lambda": "^3.1147.0",
    "@aws-sdk/client-s3": "^3.1147.0",
    "@aws-sdk/client-secrets-manager": "^3.1147.0",
    "@aws-sdk/s3-request-presigner": "^3.1147.0",
    "@hono/node-server": "^2.1.3",
    "@langfuse/openai": "^5.13.0",
    "@langfuse/otel": "^5.13.0",
    "@langfuse/tracing": "^5.13.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@opentelemetry/instrumentation": "^0.223.0",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@sentry/aws-serverless": "^10.76.1",
    "aws-jwt-verify": "^5.2.1",
    "fflate": "^0.8.3",
    "google-auth-library": "11.2.0",
    "hono": "^4.13.13",
    "just-bash": "^3.6.0",
    "mammoth": "^1.13.0",
    "maxmind": "^5.0.7",
    "openai": "^7.30.0",
    "papaparse": "^5.7.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "pg": "^8.23.1",
    "read-excel-file": "^9.3.12",
    "sharp": "^0.35.5",
    "stripe": "23.0.0",
    "yauzl": "^3.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@sentry/cli": "^3.8.0",
    "@types/aws-lambda": "^8.10.164",
    "@types/node": "^24.19.1",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.23.1",
    "@types/yauzl": "^3.4.0",
    "js-tiktoken": "^1.0.21",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "protobufjs": "^8.8.0",
    "undici": "6.29.0",
    "guarded-fetch": {
      "undici": "7.29.0"
    }
  },
  "engines": {
    "node": "24.x"
  },
  "allowScripts": {
    "@sentry/cli@3.8.0": true,
    "esbuild@0.28.2": true
  }
}
