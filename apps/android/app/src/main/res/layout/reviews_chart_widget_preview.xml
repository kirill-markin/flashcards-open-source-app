<?xml version="1.0" encoding="utf-8"?>
<!-- The widget picker preview; `@android:id/background` gets the launcher's system corner radius.
     Overdraw: the launcher inflates this without the app theme, so the root background is the only one. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/review_widget_background"
    android:orientation="vertical"
    android:padding="12dp"
    tools:ignore="Overdraw">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/reviews_chart_widget_preview_daily_average"
        android:textColor="@color/review_widget_primary"
        android:textSize="13sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:gravity="bottom|center_horizontal"
        android:orientation="horizontal">

        <View
            android:layout_width="12dp"
            android:layout_height="30dp"
            android:layout_marginHorizontal="4dp"
            android:background="@color/review_widget_primary" />
        <View
            android:layout_width="12dp"
            android:layout_height="18dp"
            android:layout_marginHorizontal="4dp"
            android:background="@color/review_widget_primary" />
        <View
            android:layout_width="12dp"
            android:layout_height="40dp"
            android:layout_marginHorizontal="4dp"
            android:background="@color/review_widget_primary" />
        <View
            android:layout_width="12dp"
            android:layout_height="26dp"
            android:layout_marginHorizontal="4dp"
            android:background="@color/review_widget_primary" />
        <View
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginHorizontal="4dp"
            android:background="@color/review_widget_primary" />
        <View
            android:layout_width="12dp"
            android:layout_height="34dp"
            android:layout_marginHorizontal="4dp"
            android:background="@color/review_widget_primary" />
        <View
            android:layout_width="12dp"
            android:layout_height="44dp"
            android:layout_marginHorizontal="4dp"
            android:background="@color/review_widget_primary" />
        <View
            android:layout_width="12dp"
            android:layout_height="22dp"
            android:layout_marginHorizontal="4dp"
            android:background="@color/review_widget_primary" />
        <View
            android:layout_width="12dp"
            android:layout_height="38dp"
            android:layout_marginHorizontal="4dp"
            android:background="@color/review_widget_primary" />
        <View
            android:layout_width="12dp"
            android:layout_height="28dp"
            android:layout_marginHorizontal="4dp"
            android:background="@color/review_widget_primary" />
    </LinearLayout>
</LinearLayout>
