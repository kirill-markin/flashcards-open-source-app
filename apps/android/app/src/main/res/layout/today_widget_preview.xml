<?xml version="1.0" encoding="utf-8"?>
<!-- The widget picker preview; `@android:id/background` gets the launcher's system corner radius.
     Overdraw: the launcher inflates this without the app theme, so the root background is the only one. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/review_widget_background"
    android:orientation="vertical"
    android:padding="12dp"
    tools:ignore="Overdraw">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/today_widget_label"
        android:textColor="@color/review_widget_on_surface"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/today_widget_preview_reviewed"
        android:textColor="@color/review_widget_on_surface_variant"
        android:textSize="13sp" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <ProgressBar
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:max="100"
        android:progress="67"
        android:progressBackgroundTint="@color/review_widget_on_surface_variant"
        android:progressTint="@color/review_widget_primary" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/today_widget_preview_cards_left"
        android:textColor="@color/review_widget_on_surface"
        android:textSize="13sp" />
</LinearLayout>
