<?xml version="1.0" encoding="utf-8"?>
<!-- The widget picker preview; `@android:id/background` gets the launcher's system corner radius.
     Overdraw: the launcher inflates this without the app theme, so the root background is the only one. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/review_widget_background"
    android:orientation="vertical"
    android:padding="12dp"
    tools:ignore="Overdraw">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter"
        android:src="@drawable/year_widget_preview_grid" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/year_widget_preview_reviews"
            android:textColor="@color/review_widget_on_surface_variant"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/year_widget_preview_active_days"
            android:textColor="@color/review_widget_on_surface_variant"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
