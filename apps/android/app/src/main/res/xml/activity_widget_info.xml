<?xml version="1.0" encoding="utf-8"?>
<!-- updatePeriodMillis re-renders while the app is closed; it is the platform minimum. -->
<!-- Today is the day of the last Progress the app published, so it may lag the clock past midnight. -->
<!-- API 30 ignores previewLayout and the target cells and falls back to minWidth/minHeight. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:description="@string/activity_widget_description"
    android:initialLayout="@layout/glance_default_loading_layout"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:minResizeWidth="100dp"
    android:minResizeHeight="100dp"
    android:previewLayout="@layout/activity_widget_preview"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen"
    tools:targetApi="31" />
