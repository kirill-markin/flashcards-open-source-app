<?xml version="1.0" encoding="utf-8"?>
<!-- updatePeriodMillis is the platform minimum, so today and the month roll over while the app is closed. -->
<!-- API 30 ignores previewLayout and the target cells and falls back to minWidth/minHeight. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:description="@string/month_calendar_widget_description"
    android:initialLayout="@layout/glance_default_loading_layout"
    android:minWidth="250dp"
    android:minHeight="250dp"
    android:minResizeWidth="100dp"
    android:minResizeHeight="100dp"
    android:previewLayout="@layout/month_calendar_widget_preview"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="4"
    android:targetCellHeight="4"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen"
    tools:targetApi="31" />
